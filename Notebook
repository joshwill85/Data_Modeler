def ns_tables_uc(catalog: str, schema: str) -> List[str]:
    try:
        df = spark.sql(f"SHOW TABLES IN {fq_identifier(catalog)}.{fq_identifier(schema)}")
        rows = df.select("tableName").limit(MAX_TABLES + 1).collect()
        if len(rows) > MAX_TABLES:
            warnings.append(f"Table count exceeds MAX_TABLES ({MAX_TABLES}); truncated.")
            rows = rows[:MAX_TABLES]
        return [f"{catalog}.{schema}.{r.tableName}" for r in rows]
    except AnalysisException as e:
        errors.append(f"SHOW TABLES failed for {catalog}.{schema}: {e.desc if hasattr(e,'desc') else str(e)}")
        return []
    except Exception as e:
        errors.append(f"Unexpected error discovering tables in {catalog}.{schema}: {e}")
        return []

def ns_tables_legacy(database: str) -> List[str]:
    try:
        df = spark.sql(f"SHOW TABLES IN {fq_identifier(database)}")
        rows = df.select("tableName").limit(MAX_TABLES + 1).collect()
        if len(rows) > MAX_TABLES:
            warnings.append(f"Table count exceeds MAX_TABLES ({MAX_TABLES}); truncated.")
            rows = rows[:MAX_TABLES]
        return [f"{database}.{r.tableName}" for r in rows]
    except AnalysisException as e:
        errors.append(f"SHOW TABLES failed for database {database}: {e.desc if hasattr(e,'desc') else str(e)}")
        return []
    except Exception as e:
        errors.append(f"Unexpected error discovering tables in {database}: {e}")
        return []

