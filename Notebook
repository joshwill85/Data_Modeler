    # ---------- Build & Persist ----------
    def build_model(self) -> Dict[str, Any]:
        model = {
            "version": VERSION,
            "author": AUTHOR,
            "run_id": self.run_id,
            "generated_at_utc": now_utc(),
            "namespace": {"catalog": self.catalog, "schema": self.schema},
            "spark_env": self.spark_env,
            "entities": [],
            "relationships": self.relationships,
            "warnings": self.warnings,
            "errors": self.errors,
        }
        for t in sorted(self.entities.keys()):
            m = self.entities[t]
            entity = {
                "name": t,
                "row_count": m.get("row_count"),
                "table_type": m.get("table_type"),
                "data_source_format": m.get("data_source_format"),
                "is_view": m.get("is_view"),
                "columns": m.get("columns", []),
            }
            model["entities"].append(entity)
        return model

    def write_text(self, rel_path: str, content: str) -> None:
        path_local = os.path.join(self.out_dir_local, rel_path.lstrip("/"))
        os.makedirs(os.path.dirname(path_local), exist_ok=True)
        with open(path_local, "w", encoding="utf-8") as fh:
            fh.write(content)

    def write_csv_rows(self, rel_path: str, header: List[str], rows: List[Iterable[Any]]) -> None:
        # simple CSV writer to avoid csv module overhead in driver (keeps it compact)
        def csv_escape(v: Any) -> str:
            s = "" if v is None else str(v)
            if any(ch in s for ch in [",", '"', "\n"]):
                s = '"' + s.replace('"','""') + '"'
            return s
        lines = [",".join([csv_escape(h) for h in header])]
        for row in rows:
            lines.append(",".join([csv_escape(x) for x in row]))
        self.write_text(rel_path, "\n".join(lines))

    def persist(self, model: Dict[str, Any]) -> None:
        # JSON
        self.write_text("data_model.json", json.dumps(model, indent=2))
        # Markdown
        self.write_text("data_model.md", self.render_markdown(model))
        # HTML
        self.write_text("data_model.html", self.render_html(model))
        # GraphML
        self.write_text("data_model.graphml", self.build_graphml(model))
        # CSVs
        ent_rows = [
            (e["name"], e.get("table_type") or ("VIEW" if e.get("is_view") else "TABLE"), e.get("data_source_format") or "", e.get("row_count"))
            for e in model["entities"]
        ]
        self.write_csv_rows("entities.csv", ["table","table_type","data_source_format","row_count"], ent_rows)

        col_rows: List[List[Any]] = []
        for e in model["entities"]:
            for c in e["columns"]:
                col_rows.append([
                    e["name"], c["name"], c["type"], c["family"], c["nullable"],
                    c.get("approx_distinct"), c.get("null_ratio"),
                    1 if match_any(c["name"], ID_NAME_HINTS) else 0,
                    1 if match_any(c["name"], FK_NAME_HINTS) else 0
                ])
        self.write_csv_rows("columns.csv",
            ["table","column","type","family","nullable","approx_distinct","null_ratio","id_name_hint","fk_name_hint"],
            col_rows)

        rel_rows = [
            (r["fk_table"], r["fk_column"], r["pk_table"], r["pk_column"], r["score"], r.get("declared", False), r.get("cardinality","many-to-one"), r.get("confidence"))
            for r in model["relationships"]
        ]
        self.write_csv_rows("relationships.csv",
            ["fk_table","fk_column","pk_table","pk_column","score","declared","cardinality","confidence"],
            rel_rows)

        # Manifest
        elapsed = time.time() - self.start_ts
        manifest = {
            "version": VERSION, "author": AUTHOR, "run_id": self.run_id,
            "namespace": {"catalog": self.catalog, "schema": self.schema},
            "output_dir_dbfs": self.out_dir_dbfs, "output_dir_local": self.out_dir_local,
            "counts": {
                "tables": len(model["entities"]),
                "relationships": len(model["relationships"]),
                "warnings": len(self.warnings), "errors": len(self.errors)
            },
            "spark_env": self.spark_env,
            "elapsed_seconds": round(elapsed, 2),
            "timestamp_utc": now_utc(),
            "notes": [
                "No console printing/logging performed; all artifacts written to output directory.",
                "Relationships include declared constraints, inferred edges, and view usage."
            ],
            "warnings": self.warnings[:200],
            "errors": self.errors
        }
        self.write_text("run_manifest.json", json.dumps(manifest, indent=2))

    def build_graphml(self, model: Dict[str, Any]) -> str:
        def x(s: Any) -> str:
            return html.escape("" if s is None else str(s), quote=True)
        lines = [
            '<?xml version="1.0" encoding="UTF-8"?>',
            '<graphml xmlns="http://graphml.graphdrawing.org/xmlns">',
            '  <key id="label" for="edge" attr.name="label" attr.type="string"/>',
            '  <graph edgedefault="directed">'
        ]
        for e in sorted(model["entities"], key=lambda z: z["name"]):
            lines.append(f'    <node id="{x(e["name"])}"/>')
        for r in model["relationships"]:
            label = f'{r["fk_column"]}→{r["pk_column"]} [{r.get("confidence","")}] ({r["score"]})'
            lines.append(f'    <edge source="{x(r["fk_table"])}" target="{x(r["pk_table"])}">')
            lines.append(f'      <data key="label">{x(label)}</data>')
            lines.append('    </edge>')
        lines.append('  </graph>')
        lines.append('</graphml>')
        return "\n".join(lines)

# =========================
# ========= RUN ===========
# =========================

def main() -> Dict[str, Any]:
    spark = SparkSession.builder.getOrCreate()
    try:
        spark.conf.set("spark.sql.session.timeZone", SESSION_TIMEZONE)
    except Exception:
        pass

    erd = ReverseERD(spark, CATALOG, SCHEMA, UC_VOLUME_ROOT)
    erd.discover_tables()
    erd.fetch_information_schema()
    erd.compute_table_stats()
    erd.infer_relationships()
    model = erd.build_model()
    erd.persist(model)
    return model

# Execute immediately (no prints/logging).
MODEL = main()
