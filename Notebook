        out_delta_base = out_dir.replace("/dbfs", "") if out_dir.startswith("/dbfs") else out_dir
        df_cols.write.mode("overwrite").format("delta").save(out_delta_base + "/delta_columns")
        df_rels.write.mode("overwrite").format("delta").save(out_delta_base + "/delta_relationships")
        
        if VERBOSE_LOGS:
            print(f"Delta tables written to: {out_delta_base}")
    except Exception as e:
        warnings.append(f"Delta summary write failed: {e}")
        errors.append(f"Could not write Delta tables: {e}")

