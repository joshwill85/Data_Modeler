def probe_table(table_name: str, required_for: str, requirement_level: str, why_it_matters: str, recent_time_col: str = None):
    probe = {
        "table_name": table_name,
        "requirement_level": requirement_level,
        "required_for": required_for,
        "why_it_matters": why_it_matters,
        "access_status": None,
        "error_type": None,
        "error": None,
        "has_data_in_window": None
    }
    try:
        spark.sql(f"SELECT * FROM {table_name} LIMIT 0").collect()
        probe["access_status"] = "ACCESSIBLE"
        if recent_time_col:
            try:
                recent_sql = f"""
                SELECT 1
                FROM {table_name}
                WHERE {recent_time_col} >= current_timestamp() - INTERVAL {DAYS_BACK} DAYS
                LIMIT 1
                """
                recent_rows = spark.sql(recent_sql).count()
                probe["has_data_in_window"] = recent_rows > 0
            except Exception:
                try:
                    recent_sql = f"""
                    SELECT 1
                    FROM {table_name}
                    WHERE {recent_time_col} >= date_sub(current_date(), {DAYS_BACK})
                    LIMIT 1
                    """
                    recent_rows = spark.sql(recent_sql).count()
                    probe["has_data_in_window"] = recent_rows > 0
                except Exception:
                    probe["has_data_in_window"] = None
    except Exception as exc:
        probe["access_status"] = "UNAVAILABLE"
        probe["error_type"] = classify_exception(exc)
        probe["error"] = str(exc)
    table_probe_results.append(probe)
    return probe

def is_accessible(table_name: str) -> bool:
    for row in table_probe_results:
        if row["table_name"] == table_name:
            return row["access_status"] == "ACCESSIBLE"
    return False

