# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------
def qualify_name(name: str) -> str:
    parts = [p.strip() for p in name.split(".") if p.strip()]
    if len(parts) == 2:
        return f"{DEFAULT_CATALOG}.{parts[0]}.{parts[1]}"
    if len(parts) == 3:
        if parts[0] != DEFAULT_CATALOG:
            raise ValueError(f"Catalog must be {DEFAULT_CATALOG}. Got: {parts[0]}")
        return ".".join(parts)
    raise ValueError(f"Expected schema.table or catalog.schema.table. Got: {name}")

def split_fqn(name: str):
    q = qualify_name(name)
    return q.split(".")

def quote_name(name: str) -> str:
    return ".".join([f"`{p}`" for p in split_fqn(name)])

def quote_schema_from_table(name: str) -> str:
    catalog, schema, _ = split_fqn(name)
    return f"`{catalog}`.`{schema}`"

def ensure_schema_for_table(name: str):
    spark.sql(f"CREATE SCHEMA IF NOT EXISTS {quote_schema_from_table(name)}")

def table_exists(name: str) -> bool:
    q = qualify_name(name)
    return spark.catalog.tableExists(q)

def df_has_rows(df) -> bool:
    return len(df.take(1)) > 0

def with_hash_key(df, key_cols, key_name="lineage_row_id"):
    return (
        df.withColumn(
            key_name,
            F.sha2(
                F.concat_ws(
                    "||",
                    *[F.coalesce(F.col(c).cast("string"), F.lit("")) for c in key_cols]
                ),
                256
            )
        )
        .withColumn("ingested_at", F.current_timestamp())
    )

def apply_table_features(target_table: str, cluster_cols=None):
    spark.sql(
        f"ALTER TABLE {quote_name(target_table)} "
        "SET TBLPROPERTIES ('delta.enableChangeDataFeed'='true')"
    )
    if cluster_cols:
        cols = ", ".join([f"`{c}`" for c in cluster_cols])
        spark.sql(f"ALTER TABLE {quote_name(target_table)} CLUSTER BY ({cols})")

def create_empty_delta_if_missing(df, target_table: str, cluster_cols=None):
    ensure_schema_for_table(target_table)
    q = qualify_name(target_table)
    if not table_exists(q):
        (
            df.limit(0)
              .write
              .format("delta")
              .mode("overwrite")
              .option("overwriteSchema", "true")
              .saveAsTable(q)
        )
        apply_table_features(q, cluster_cols)

def merge_history(source_df, target_table: str, key_col: str, cluster_cols=None):
    q = qualify_name(target_table)
    create_empty_delta_if_missing(source_df, q, cluster_cols=cluster_cols)
    delta_target = DeltaTable.forName(spark, q)
    (
        delta_target.alias("t")
        .merge(source_df.alias("s"), f"t.{key_col} = s.{key_col}")
        .whenNotMatchedInsertAll()
        .execute()
    )
    apply_table_features(q, cluster_cols)

def overwrite_delta(source_df, target_table: str, cluster_cols=None):
    q = qualify_name(target_table)
    ensure_schema_for_table(q)
    (
        source_df.write
                 .format("delta")
                 .mode("overwrite")
                 .option("overwriteSchema", "true")
                 .saveAsTable(q)
    )
    apply_table_features(q, cluster_cols)

def root_table_to_full_name(root_table_input: str) -> str:
    parts = [p.strip() for p in root_table_input.split(".") if p.strip()]
    if len(parts) != 2:
        raise ValueError(
            f"root_table must be schema.table only. Got: {root_table_input}"
        )
    return f"{DEFAULT_CATALOG}.{parts[0]}.{parts[1]}"

