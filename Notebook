# 5C. Approximate DBU allocation for jobs on all-purpose compute
approx_all_purpose_job_cost_sql = f"""
WITH all_purpose_cluster_day AS (
  SELECT
    workspace_id,
    usage_metadata.cluster_id AS cluster_id,
    usage_date,
    SUM(usage_quantity) AS cluster_dbu,
    SUM(list_cost_usd) AS cluster_list_cost_usd
  FROM priced_usage
  WHERE billing_origin_product = 'ALL_PURPOSE'
    AND usage_metadata.cluster_id IS NOT NULL
  GROUP BY
    workspace_id,
    usage_metadata.cluster_id,
    usage_date
),
job_task_runtime AS (
  SELECT
    t.workspace_id,
    e.cluster_id,
    CAST(t.period_start_time AS DATE) AS usage_date,
    t.job_id,
    COALESCE(j.name, CONCAT('job_', t.job_id)) AS job_name,
    SUM(GREATEST(0, UNIX_TIMESTAMP(t.period_end_time) - UNIX_TIMESTAMP(t.period_start_time))) AS task_runtime_seconds
  FROM system.lakeflow.job_task_run_timeline t
  LATERAL VIEW explode(t.compute_ids) e AS cluster_id
  INNER JOIN latest_clusters c
    ON t.workspace_id = c.workspace_id
   AND e.cluster_id = c.cluster_id
  LEFT JOIN latest_jobs j
    ON t.workspace_id = j.workspace_id
   AND t.job_id = j.job_id
  WHERE t.period_start_time >= current_timestamp() - INTERVAL {DAYS_BACK} DAYS
    AND c.cluster_source IN ('UI', 'API')
  GROUP BY
    t.workspace_id,
    e.cluster_id,
    CAST(t.period_start_time AS DATE),
    t.job_id,
    COALESCE(j.name, CONCAT('job_', t.job_id))
),
job_task_runtime_total AS (
  SELECT
    workspace_id,
    cluster_id,
    usage_date,
    SUM(task_runtime_seconds) AS total_job_task_runtime_seconds
  FROM job_task_runtime
  GROUP BY
    workspace_id,
    cluster_id,
    usage_date
)
SELECT
  j.workspace_id,
  j.cluster_id,
  c.cluster_name,
  c.owned_by,
  j.usage_date,
  j.job_id,
  j.job_name,
  j.task_runtime_seconds,
  t.total_job_task_runtime_seconds,
  b.cluster_dbu,
  b.cluster_list_cost_usd,
  CASE
    WHEN t.total_job_task_runtime_seconds > 0 AND b.cluster_dbu IS NOT NULL
    THEN b.cluster_dbu * (j.task_runtime_seconds / t.total_job_task_runtime_seconds)
    ELSE NULL
  END AS approx_job_dbu_from_job_task_runtime_share,
  CASE
    WHEN t.total_job_task_runtime_seconds > 0 AND b.cluster_list_cost_usd IS NOT NULL
    THEN b.cluster_list_cost_usd * (j.task_runtime_seconds / t.total_job_task_runtime_seconds)
    ELSE NULL
  END AS approx_job_list_cost_usd_from_job_task_runtime_share,
  'APPROX_ONLY_SHARED_CLUSTER' AS estimate_type,
  'Directional estimate only. Shared notebooks, SQL, and other workloads on the same cluster are not isolated here.' AS caveat
FROM job_task_runtime j
INNER JOIN job_task_runtime_total t
  ON j.workspace_id = t.workspace_id
 AND j.cluster_id = t.cluster_id
 AND j.usage_date = t.usage_date
LEFT JOIN all_purpose_cluster_day b
  ON j.workspace_id = b.workspace_id
 AND j.cluster_id = b.cluster_id
 AND j.usage_date = b.usage_date
LEFT JOIN latest_clusters c
  ON j.workspace_id = c.workspace_id
 AND j.cluster_id = c.cluster_id
ORDER BY approx_job_list_cost_usd_from_job_task_runtime_share DESC NULLS LAST, j.task_runtime_seconds DESC
"""

