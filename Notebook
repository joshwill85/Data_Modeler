# Databricks notebook source
# COMMAND ----------

from pyspark.sql import functions as F
from pyspark.sql.types import (
    ArrayType,
    StringType,
    TimestampType,
    LongType,
    BooleanType,
)
from datetime import timedelta

# ============================================================
# HARD-CODED ROOT + FIXED 7-DAY WINDOW
# ============================================================
root_table_full_name = "eciscor_prod.npdataset.npd_current_pending"

# Persisted tables
output_paths_current_table = "cdo.npd_current_pending_upstream_paths_current_7d"
output_run_log_table = "cdo.npd_current_pending_upstream_run_log_7d"

# SAFETY GUARDS
# These are evaluated AFTER the current state is written,
# so the table always contains the last fully-built state.
max_upstream_hops = 15
max_upstream_rows_per_state = 250000
max_upstream_total_rows_seen = 3000000

# Stable 7-day window for the whole run
window_end = spark.sql("SELECT current_timestamp() AS ts").first()["ts"]
window_start = window_end - timedelta(days=7)

window_start_str = window_start.strftime("%Y-%m-%d %H:%M:%S")
window_end_str = window_end.strftime("%Y-%m-%d %H:%M:%S")

# Run id
run_id = spark.sql("SELECT uuid() AS run_id").first()["run_id"]

print(f"Root table: {root_table_full_name}")
print(f"Output paths table: {output_paths_current_table}")
print(f"Output run log table: {output_run_log_table}")
print(f"Run id: {run_id}")
print(f"Window start: {window_start_str}")
print(f"Window end:   {window_end_str}")
print(f"Max upstream hops: {max_upstream_hops}")
print(f"Max upstream rows per state: {max_upstream_rows_per_state:,}")
print(f"Max upstream total rows seen: {max_upstream_total_rows_seen:,}")

# COMMAND ----------

# ============================================================
# 1. BUILD A 7-DAY TABLE-TO-TABLE EDGE GRAPH
#
# edges_7d_raw:
#   one row per source->target edge seen in the last 7 days
#   keeps latest_seen_time + events_seen_7d
#
# edges_7d_traversal:
#   same thing, but excludes self-links for recursion
# ============================================================
edges_7d_raw = spark.sql(f"""
SELECT
  source_table_full_name,
  source_type,
  target_table_full_name,
  target_type,
  MAX(event_time) AS latest_seen_time,
  COUNT(DISTINCT event_id) AS events_seen_7d,
  COLLECT_SET(COALESCE(created_by, 'UNKNOWN')) AS creators,
  COLLECT_SET(COALESCE(entity_type, 'UNKNOWN')) AS entity_types
FROM information_schema.table_lineage
WHERE source_table_full_name IS NOT NULL
  AND target_table_full_name IS NOT NULL
  AND event_time >= TIMESTAMP('{window_start_str}')
  AND event_time <= TIMESTAMP('{window_end_str}')
GROUP BY
  source_table_full_name,
  source_type,
  target_table_full_name,
  target_type
""").cache()

edges_7d_raw.createOrReplaceTempView("edges_7d_raw")

edges_7d_traversal = (
    edges_7d_raw
    .filter(F.col("source_table_full_name") != F.col("target_table_full_name"))
    .cache()
)
edges_7d_traversal.createOrReplaceTempView("edges_7d_traversal")

print(f"7-day raw table-to-table edges: {edges_7d_raw.count():,}")
print(f"7-day traversal-safe table-to-table edges: {edges_7d_traversal.count():,}")

# Sanity-check direct upstream views for the root
root_upstream_7d_raw = (
    edges_7d_raw
    .filter(F.col("target_table_full_name") == root_table_full_name)
    .select(
        "source_table_full_name",
        "source_type",
        "latest_seen_time",
        "events_seen_7d",
        "creators",
        "entity_types"
    )
    .orderBy(F.col("latest_seen_time").desc(), F.col("source_table_full_name"))
    .cache()
)
root_upstream_7d_raw.createOrReplaceTempView("root_upstream_7d_raw")

root_upstream_7d_traversal = (
    edges_7d_traversal
    .filter(F.col("target_table_full_name") == root_table_full_name)
    .select(
        "source_table_full_name",
        "source_type",
        "latest_seen_time",
        "events_seen_7d",
        "creators",
        "entity_types"
    )
    .orderBy(F.col("latest_seen_time").desc(), F.col("source_table_full_name"))
    .cache()
)
root_upstream_7d_traversal.createOrReplaceTempView("root_upstream_7d_traversal")

print(f"Direct upstream tables for root in 7 days (raw): {root_upstream_7d_raw.count():,}")
print(f"Direct upstream tables for root in 7 days (traversal-safe): {root_upstream_7d_traversal.count():,}")

# COMMAND ----------

# ============================================================
# 2. HELPERS
# ============================================================
def decorate_state(df):
    """
    Add derived columns used for recursion + writing.
    """
    return (
        df
        .withColumn("hop_count", (F.size("path_tables") - F.lit(1)).cast("int"))
        .withColumn("path_id", F.sha2(F.array_join(F.col("path_tables"), "||"), 256))
        .withColumn("leaf_table", F.expr("element_at(path_tables, -1)"))
        .withColumn("leaf_type", F.expr("element_at(path_types, -1)"))
        .select(
            "path_tables",
            "path_types",
            "edge_latest_seen_times",
            "edge_events_seen_7d_arr",
            "edge_creators_per_hop",
            "edge_entity_types_per_hop",
            "is_terminal",
            "hop_count",
            "path_id",
            "leaf_table",
            "leaf_type",
        )
    )

def seed_current_state():
    """
    One row: the root path only.
    Edge arrays are empty because hop 0 has no incoming edge.
    """
    seed = spark.range(1).select(
        F.array(F.lit(root_table_full_name)).alias("path_tables"),
        F.array(F.lit("ROOT")).alias("path_types"),
        F.expr("array()").cast(ArrayType(TimestampType())).alias("edge_latest_seen_times"),
        F.expr("array()").cast(ArrayType(LongType())).alias("edge_events_seen_7d_arr"),
        F.expr("array()").cast(ArrayType(ArrayType(StringType()))).alias("edge_creators_per_hop"),
        F.expr("array()").cast(ArrayType(ArrayType(StringType()))).alias("edge_entity_types_per_hop"),
        F.lit(False).cast(BooleanType()).alias("is_terminal"),
    )
    return decorate_state(seed).cache()

def write_paths_current_table(state_df):
    """
    Overwrite the current-state paths table.
    One row per maximal path in the current state.
    """
    out = (
        state_df
        .withColumn("run_id", F.lit(run_id))
        .withColumn("root_table_full_name", F.lit(root_table_full_name))
        .withColumn("window_start", F.lit(window_start).cast("timestamp"))
        .withColumn("window_end", F.lit(window_end).cast("timestamp"))
        .withColumn("written_at", F.current_timestamp())
        .select(
            "run_id",
            "root_table_full_name",
            "window_start",
            "window_end",
            "hop_count",
            "path_id",
            "path_tables",
            "path_types",
            "edge_latest_seen_times",
            "edge_events_seen_7d_arr",
            "edge_creators_per_hop",
            "edge_entity_types_per_hop",
            "leaf_table",
            "leaf_type",
            "is_terminal",
            "written_at",
        )
    )

    (
        out.write
        .format("delta")
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(output_paths_current_table)
    )

def append_run_log_row(
    state_rows,
    distinct_leaf_objects,
    terminal_paths,
    active_paths,
    max_hop_in_state,
    stop_reason,
):
    """
    Append one row to the run log for the just-written state.
    """
    log_df = spark.createDataFrame(
        [(
            run_id,
            root_table_full_name,
            window_start,
            window_end,
            int(max_hop_in_state) if max_hop_in_state is not None else None,
            int(state_rows),
            int(distinct_leaf_objects),
            int(terminal_paths),
            int(active_paths),
            stop_reason,
        )],
        [
            "run_id",
            "root_table_full_name",
            "window_start",
            "window_end",
            "max_hop_in_state",
            "state_rows",
            "distinct_leaf_objects",
            "terminal_paths",
            "active_paths",
            "stop_reason",
        ],
    ).withColumn("written_at", F.current_timestamp())

    (
        log_df.write
        .format("delta")
        .mode("append")
        .saveAsTable(output_run_log_table)
    )

# COMMAND ----------

# ============================================================
# 3. UPSTREAM CURRENT-STATE PATH GROWTH
#
# DESIGN:
# - current_state always contains ONE row per maximal path
# - shorter prefixes are replaced by their longer children
# - terminal paths are kept
# - the paths table is overwritten AFTER EVERY COMPLETED HOP
# - the run log is appended AFTER EVERY COMPLETED HOP
# - if a safety guard is hit, it is checked AFTER the state is written
# ============================================================
current_state = seed_current_state()
total_rows_seen = 0
stop_reason = None

while True:
    metrics = (
        current_state
        .agg(
            F.count("*").alias("state_rows"),
            F.countDistinct("leaf_table").alias("distinct_leaf_objects"),
            F.sum(F.when(F.col("is_terminal"), F.lit(1)).otherwise(F.lit(0))).alias("terminal_paths"),
            F.max("hop_count").alias("max_hop_in_state"),
        )
        .first()
    )

    state_rows = int(metrics["state_rows"])
    distinct_leaf_objects = int(metrics["distinct_leaf_objects"])
    terminal_paths = int(metrics["terminal_paths"]) if metrics["terminal_paths"] is not None else 0
    active_paths = state_rows - terminal_paths
    max_hop_in_state = int(metrics["max_hop_in_state"]) if metrics["max_hop_in_state"] is not None else 0

    total_rows_seen += state_rows

    # Determine stop reason for the CURRENT state.
    # This state will still be written before stopping.
    stop_reason = None
    if active_paths == 0:
        stop_reason = "NO_MORE_UPSTREAM"
    elif max_hop_in_state >= max_upstream_hops:
        stop_reason = f"MAX_HOPS_REACHED_AT_HOP_{max_hop_in_state}"
    elif state_rows > max_upstream_rows_per_state:
        stop_reason = f"MAX_ROWS_PER_STATE_EXCEEDED_AT_HOP_{max_hop_in_state}"
    elif total_rows_seen > max_upstream_total_rows_seen:
        stop_reason = f"MAX_TOTAL_ROWS_SEEN_EXCEEDED_AT_HOP_{max_hop_in_state}"

    # WRITE THE CURRENT STATE FIRST
    write_paths_current_table(current_state)
    append_run_log_row(
        state_rows=state_rows,
        distinct_leaf_objects=distinct_leaf_objects,
        terminal_paths=terminal_paths,
        active_paths=active_paths,
        max_hop_in_state=max_hop_in_state,
        stop_reason=stop_reason,
    )

    print(
        f"WROTE CURRENT STATE | max_hop={max_hop_in_state} | "
        f"rows={state_rows:,} | distinct_leaf_objects={distinct_leaf_objects:,} | "
        f"terminal_paths={terminal_paths:,} | active_paths={active_paths:,} | "
        f"stop_reason={stop_reason}"
    )

    if stop_reason is not None:
        current_state.unpersist()
        break

    # Split active vs terminal
    active = current_state.filter(~F.col("is_terminal")).cache()
    terminal = current_state.filter(F.col("is_terminal")).cache()

    # Expand ONLY active paths
    expanded = (
        active.alias("cur")
        .join(
            edges_7d_traversal.alias("e"),
            F.col("cur.leaf_table") == F.col("e.target_table_full_name"),
            "inner"
        )
        .filter(~F.array_contains(F.col("cur.path_tables"), F.col("e.source_table_full_name")))
        .select(
            F.col("cur.path_id").alias("parent_path_id"),
            F.array_append(F.col("cur.path_tables"), F.col("e.source_table_full_name")).alias("path_tables"),
            F.array_append(F.col("cur.path_types"), F.col("e.source_type")).alias("path_types"),
            F.concat(
                F.col("cur.edge_latest_seen_times"),
                F.array(F.col("e.latest_seen_time"))
            ).alias("edge_latest_seen_times"),
            F.concat(
                F.col("cur.edge_events_seen_7d_arr"),
                F.array(F.col("e.events_seen_7d").cast("long"))
            ).alias("edge_events_seen_7d_arr"),
            F.concat(
                F.col("cur.edge_creators_per_hop"),
                F.array(F.col("e.creators"))
            ).alias("edge_creators_per_hop"),
            F.concat(
                F.col("cur.edge_entity_types_per_hop"),
                F.array(F.col("e.entity_types"))
            ).alias("edge_entity_types_per_hop"),
            F.lit(False).cast(BooleanType()).alias("is_terminal"),
        )
        .cache()
    )

    parents_with_children = expanded.select("parent_path_id").distinct().cache()

    # Active paths that found NO children become terminal
    newly_terminal = (
        active.alias("a")
        .join(
            parents_with_children.alias("p"),
            F.col("a.path_id") == F.col("p.parent_path_id"),
            "left_anti"
        )
        .select(
            "a.path_tables",
            "a.path_types",
            "a.edge_latest_seen_times",
            "a.edge_events_seen_7d_arr",
            "a.edge_creators_per_hop",
            "a.edge_entity_types_per_hop",
        )
        .withColumn("is_terminal", F.lit(True).cast(BooleanType()))
    )

    # Children replace their shorter parents
    children = (
        decorate_state(
            expanded.select(
                "path_tables",
                "path_types",
                "edge_latest_seen_times",
                "edge_events_seen_7d_arr",
                "edge_creators_per_hop",
                "edge_entity_types_per_hop",
                "is_terminal",
            )
        )
        .dropDuplicates(["path_id"])
        .cache()
    )

    # Keep already-terminal paths, plus newly-terminal paths, plus new children
    next_state = (
        terminal
        .unionByName(decorate_state(newly_terminal), allowMissingColumns=True)
        .unionByName(children, allowMissingColumns=True)
        .dropDuplicates(["path_id"])
        .cache()
    )

    # Clean up old state + intermediates
    current_state.unpersist()
    active.unpersist()
    terminal.unpersist()
    expanded.unpersist()
    parents_with_children.unpersist()
    children.unpersist()

    current_state = next_state

# COMMAND ----------

# ============================================================
# 4. READ THE WRITTEN CURRENT-STATE TABLE BACK
# ============================================================
upstream_paths_current = spark.read.table(output_paths_current_table).cache()
upstream_paths_current.createOrReplaceTempView("upstream_paths_current")

upstream_run_log = spark.read.table(output_run_log_table).filter(F.col("run_id") == run_id).cache()
upstream_run_log.createOrReplaceTempView("upstream_run_log")

print(f"✅ Current-state path rows in {output_paths_current_table}: {upstream_paths_current.count():,}")
print(f"✅ Run-log rows for this run: {upstream_run_log.count():,}")

# COMMAND ----------

# ============================================================
# 5. DERIVED VIEWS FROM THE CONSOLIDATED CURRENT-STATE TABLE
#
# Because the table stores only maximal paths, hop summaries are derived
# by exploding path_tables / path_types / edge metadata arrays.
# ============================================================

# Objects by hop
spark.sql(f"""
CREATE OR REPLACE TEMP VIEW upstream_objects_by_hop AS
WITH exploded AS (
  SELECT
    run_id,
    path_id,
    hop_pos AS hop_count,
    table_name AS reached_table_full_name,
    element_at(path_types, hop_pos + 1) AS reached_type,
    CASE
      WHEN hop_pos = 0 THEN CAST(NULL AS TIMESTAMP)
      ELSE element_at(edge_latest_seen_times, hop_pos)
    END AS latest_seen_time_to_child,
    CASE
      WHEN hop_pos = 0 THEN CAST(NULL AS BIGINT)
      ELSE element_at(edge_events_seen_7d_arr, hop_pos)
    END AS events_seen_7d_on_edge_to_child,
    CASE
      WHEN hop_pos = 0 THEN CAST(NULL AS ARRAY<STRING>)
      ELSE element_at(edge_creators_per_hop, hop_pos)
    END AS creators_on_edge_to_child,
    CASE
      WHEN hop_pos = 0 THEN CAST(NULL AS ARRAY<STRING>)
      ELSE element_at(edge_entity_types_per_hop, hop_pos)
    END AS entity_types_on_edge_to_child
  FROM {output_paths_current_table}
  LATERAL VIEW posexplode(path_tables) p AS hop_pos, table_name
)
SELECT
  hop_count,
  reached_table_full_name,
  MAX(reached_type) AS reached_type,
  MAX(latest_seen_time_to_child) AS latest_seen_time_to_child,
  MAX(events_seen_7d_on_edge_to_child) AS max_events_seen_7d_on_edge_to_child,
  ARRAY_SORT(ARRAY_DISTINCT(FLATTEN(COLLECT_LIST(creators_on_edge_to_child)))) AS creators_on_edge_to_child,
  ARRAY_SORT(ARRAY_DISTINCT(FLATTEN(COLLECT_LIST(entity_types_on_edge_to_child)))) AS entity_types_on_edge_to_child,
  COUNT(DISTINCT path_id) AS paths_through_object
FROM exploded
GROUP BY
  hop_count,
  reached_table_full_name
""")

# Hop summary
spark.sql("""
CREATE OR REPLACE TEMP VIEW upstream_hop_summary AS
SELECT
  hop_count,
  COUNT(DISTINCT reached_table_full_name) AS distinct_objects_at_hop,
  SUM(paths_through_object) AS path_rows_at_hop,
  MAX(latest_seen_time_to_child) AS latest_seen_time_any_object_at_hop,
  ARRAY_SORT(COLLECT_SET(reached_table_full_name)) AS objects_at_hop
FROM upstream_objects_by_hop
GROUP BY hop_count
""")

# Edges by hop
spark.sql(f"""
CREATE OR REPLACE TEMP VIEW upstream_edges_by_hop AS
WITH exploded_edges AS (
  SELECT
    run_id,
    path_id,
    edge_pos + 1 AS hop_count,
    element_at(path_tables, edge_pos + 2) AS from_table,
    element_at(path_types, edge_pos + 2) AS from_type,
    element_at(path_tables, edge_pos + 1) AS to_table,
    element_at(path_types, edge_pos + 1) AS to_type,
    latest_seen_time,
    element_at(edge_events_seen_7d_arr, edge_pos + 1) AS events_seen_7d,
    element_at(edge_creators_per_hop, edge_pos + 1) AS creators,
    element_at(edge_entity_types_per_hop, edge_pos + 1) AS entity_types
  FROM {output_paths_current_table}
  LATERAL VIEW posexplode(edge_latest_seen_times) p AS edge_pos, latest_seen_time
)
SELECT
  hop_count,
  from_table,
  from_type,
  to_table,
  to_type,
  MAX(latest_seen_time) AS latest_seen_time,
  MAX(events_seen_7d) AS events_seen_7d,
  ARRAY_SORT(ARRAY_DISTINCT(FLATTEN(COLLECT_LIST(creators)))) AS creators,
  ARRAY_SORT(ARRAY_DISTINCT(FLATTEN(COLLECT_LIST(entity_types)))) AS entity_types,
  COUNT(DISTINCT path_id) AS distinct_paths_through_edge
FROM exploded_edges
GROUP BY
  hop_count,
  from_table,
  from_type,
  to_table,
  to_type
""")

# Path summary
spark.sql(f"""
CREATE OR REPLACE TEMP VIEW upstream_path_summary AS
SELECT
  path_id,
  hop_count AS max_hop_count,
  CASE
    WHEN size(edge_latest_seen_times) = 0 THEN CAST(NULL AS TIMESTAMP)
    ELSE array_max(edge_latest_seen_times)
  END AS latest_seen_time_on_path,
  path_tables,
  path_types,
  is_terminal
FROM {output_paths_current_table}
""")

# COMMAND ----------

print("✅ Created persistent tables + temp views:")
print(f"  - {output_paths_current_table}")
print(f"  - {output_run_log_table}")
print("  - edges_7d_raw")
print("  - edges_7d_traversal")
print("  - root_upstream_7d_raw")
print("  - root_upstream_7d_traversal")
print("  - upstream_paths_current")
print("  - upstream_run_log")
print("  - upstream_objects_by_hop")
print("  - upstream_hop_summary")
print("  - upstream_edges_by_hop")
print("  - upstream_path_summary")
