# ============================================================
# 5. HELPERS
# ============================================================
def decorate_state(df):
    """
    Keep the working state narrow.
    """
    return (
        df
        .withColumn("hop_count", (F.size("path_tables") - F.lit(1)).cast("long"))
        .withColumn("path_id", F.sha2(F.array_join(F.col("path_tables"), "||"), 256))
        .withColumn("leaf_table", F.expr("element_at(path_tables, -1)"))
        .select(
            "path_tables",
            "edge_latest_seen_times",
            "edge_events_seen_7d_arr",
            "is_terminal",
            "hop_count",
            "path_id",
            "leaf_table",
        )
    )

def seed_working_state():
    seed = spark.range(1).select(
        F.array(F.lit(root_table_full_name)).alias("path_tables"),
        F.expr("array()").cast(ArrayType(TimestampType())).alias("edge_latest_seen_times"),
        F.expr("array()").cast(ArrayType(LongType())).alias("edge_events_seen_7d_arr"),
        F.lit(False).cast(BooleanType()).alias("is_terminal"),
    )
    state = decorate_state(seed)
    (
        state.write
        .format("delta")
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(working_state_table)
    )

def append_paths_snapshot(state_df, snapshot_hop):
    out = (
        state_df
        .withColumn("run_id", F.lit(run_id).cast("string"))
        .withColumn("root_table_full_name", F.lit(root_table_full_name).cast("string"))
        .withColumn("window_start", F.lit(window_start).cast("timestamp"))
        .withColumn("window_end", F.lit(window_end).cast("timestamp"))
        .withColumn("snapshot_hop", F.lit(snapshot_hop).cast("long"))
        .withColumn("written_at", F.current_timestamp())
        .select(
            "run_id",
            "root_table_full_name",
            "window_start",
            "window_end",
            "snapshot_hop",
            "hop_count",
            "path_id",
            "path_tables",
            "edge_latest_seen_times",
            "edge_events_seen_7d_arr",
            "leaf_table",
            "is_terminal",
            "written_at",
        )
    )

    (
        out.write
        .format("delta")
        .mode("append")
        .saveAsTable(paths_snapshots_table)
    )

def refresh_current_view(snapshot_hop):
    spark.sql(f"""
    CREATE OR REPLACE VIEW {current_paths_view} AS
    SELECT *
    FROM {paths_snapshots_table}
    WHERE run_id = '{run_id}'
      AND snapshot_hop = {int(snapshot_hop)}
    """)

def append_run_log_row(
    state_rows,
    distinct_leaf_objects,
    terminal_paths,
    active_paths,
    max_hop_in_state,
    stop_reason,
):
    log_df = (
        spark.range(1)
        .select(
            F.lit(run_id).cast("string").alias("run_id"),
            F.lit(root_table_full_name).cast("string").alias("root_table_full_name"),
            F.lit(window_start).cast("timestamp").alias("window_start"),
            F.lit(window_end).cast("timestamp").alias("window_end"),
            F.lit(max_hop_in_state).cast("long").alias("max_hop_in_state"),
            F.lit(state_rows).cast("long").alias("state_rows"),
            F.lit(distinct_leaf_objects).cast("long").alias("distinct_leaf_objects"),
            F.lit(terminal_paths).cast("long").alias("terminal_paths"),
            F.lit(active_paths).cast("long").alias("active_paths"),
            F.lit(stop_reason).cast("string").alias("stop_reason"),
            F.current_timestamp().alias("written_at"),
        )
    )

    (
        log_df.write
        .format("delta")
        .mode("append")
        .saveAsTable(run_log_table)
    )

# COMMAND ----------

# ============================================================
# 6. STAGE 2: ITERATIVE UPSTREAM EXPANSION
#
# IMPORTANT:
# - Every hop reads working_state_table fresh, which truncates the plan.
# - Every completed hop appends a snapshot + run log.
# - current_paths_view always points at the latest snapshot for this run.
# ============================================================
seed_working_state()
total_rows_seen = 0

while True:
    current_state = spark.read.table(working_state_table).cache()

    metrics = (
        current_state
        .agg(
            F.count("*").alias("state_rows"),
            F.countDistinct("leaf_table").alias("distinct_leaf_objects"),
            F.sum(F.when(F.col("is_terminal"), F.lit(1)).otherwise(F.lit(0))).alias("terminal_paths"),
            F.max("hop_count").alias("max_hop_in_state"),
        )
        .first()
    )

    state_rows = int(metrics["state_rows"])
    distinct_leaf_objects = int(metrics["distinct_leaf_objects"])
    terminal_paths = int(metrics["terminal_paths"]) if metrics["terminal_paths"] is not None else 0
    active_paths = state_rows - terminal_paths
    max_hop_in_state = int(metrics["max_hop_in_state"]) if metrics["max_hop_in_state"] is not None else 0

    total_rows_seen += state_rows

    stop_reason = None
    if active_paths == 0:
        stop_reason = "NO_MORE_UPSTREAM"
    elif max_hop_in_state >= max_upstream_hops:
        stop_reason = f"MAX_HOPS_REACHED_AT_HOP_{max_hop_in_state}"
    elif state_rows > max_upstream_rows_per_state:
        stop_reason = f"MAX_ROWS_PER_STATE_EXCEEDED_AT_HOP_{max_hop_in_state}"
    elif total_rows_seen > max_upstream_total_rows_seen:
        stop_reason = f"MAX_TOTAL_ROWS_SEEN_EXCEEDED_AT_HOP_{max_hop_in_state}"

    # Persist current state before any stop
    append_paths_snapshot(current_state, max_hop_in_state)
    refresh_current_view(max_hop_in_state)
    append_run_log_row(
        state_rows=state_rows,
        distinct_leaf_objects=distinct_leaf_objects,
        terminal_paths=terminal_paths,
        active_paths=active_paths,
        max_hop_in_state=max_hop_in_state,
        stop_reason=stop_reason,
    )

    print(
        f"WROTE SNAPSHOT | hop={max_hop_in_state} | "
        f"rows={state_rows:,} | distinct_leaf_objects={distinct_leaf_objects:,} | "
        f"terminal_paths={terminal_paths:,} | active_paths={active_paths:,} | "
        f"stop_reason={stop_reason}"
    )

    if stop_reason is not None:
        current_state.unpersist()
        break

    active = current_state.filter(~F.col("is_terminal")).cache()
    terminal = current_state.filter(F.col("is_terminal")).cache()

    # Expand only active paths against the materialized edge table
    expanded = (
        active.alias("cur")
        .join(
            edges_7d.alias("e"),
            (F.col("cur.leaf_table") == F.col("e.target_table_full_name")) &
            (F.col("e.source_table_full_name") != F.col("e.target_table_full_name")),
            "inner"
        )
        .filter(~F.array_contains(F.col("cur.path_tables"), F.col("e.source_table_full_name")))
        .select(
            F.col("cur.path_id").alias("parent_path_id"),
            F.array_append(F.col("cur.path_tables"), F.col("e.source_table_full_name")).alias("path_tables"),
            F.concat(
                F.col("cur.edge_latest_seen_times"),
                F.array(F.col("e.latest_seen_time"))
            ).alias("edge_latest_seen_times"),
            F.concat(
                F.col("cur.edge_events_seen_7d_arr"),
                F.array(F.col("e.events_seen_7d").cast("long"))
            ).alias("edge_events_seen_7d_arr"),
            F.lit(False).cast(BooleanType()).alias("is_terminal"),
        )
        .cache()
    )

    parents_with_children = expanded.select("parent_path_id").distinct().cache()

    newly_terminal = (
        active.alias("a")
        .join(
            parents_with_children.alias("p"),
            F.col("a.path_id") == F.col("p.parent_path_id"),
            "left_anti"
        )
        .select(
            "a.path_tables",
            "a.edge_latest_seen_times",
            "a.edge_events_seen_7d_arr",
        )
        .withColumn("is_terminal", F.lit(True).cast(BooleanType()))
    )

    children = (
        decorate_state(
            expanded.select(
                "path_tables",
                "edge_latest_seen_times",
                "edge_events_seen_7d_arr",
                "is_terminal",
            )
        )
        .dropDuplicates(["path_id"])
        .cache()
    )

    next_state = (
        terminal
        .unionByName(decorate_state(newly_terminal), allowMissingColumns=True)
        .unionByName(children, allowMissingColumns=True)
        .dropDuplicates(["path_id"])
        .cache()
    )

    (
        next_state.write
        .format("delta")
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(working_state_table)
    )

    current_state.unpersist()
    active.unpersist()
    terminal.unpersist()
    expanded.unpersist()
    parents_with_children.unpersist()
    children.unpersist()
    next_state.unpersist()

# COMMAND ----------

# ============================================================
# 7. PERSISTENT DERIVED VIEWS
# ============================================================
spark.sql(f"""
CREATE OR REPLACE VIEW {objects_by_hop_view} AS
WITH exploded AS (
  SELECT
    path_id,
    hop_pos AS hop_count,
    table_name AS reached_table_full_name,
    CASE
      WHEN hop_pos = 0 THEN CAST(NULL AS TIMESTAMP)
      ELSE element_at(edge_latest_seen_times, hop_pos)
    END AS latest_seen_time_to_child,
    CASE
      WHEN hop_pos = 0 THEN CAST(NULL AS BIGINT)
      ELSE element_at(edge_events_seen_7d_arr, hop_pos)
    END AS events_seen_7d_on_edge_to_child
  FROM {current_paths_view}
  LATERAL VIEW posexplode(path_tables) p AS hop_pos, table_name
)
SELECT
  e.hop_count,
  e.reached_table_full_name,
  o.table_type AS reached_type,
  MAX(e.latest_seen_time_to_child) AS latest_seen_time_to_child,
  MAX(e.events_seen_7d_on_edge_to_child) AS max_events_seen_7d_on_edge_to_child,
  COUNT(DISTINCT e.path_id) AS paths_through_object
FROM exploded e
LEFT JOIN {object_stage_table} o
  ON e.reached_table_full_name = o.table_full_name
GROUP BY
  e.hop_count,
  e.reached_table_full_name,
  o.table_type
""")

spark.sql(f"""
CREATE OR REPLACE VIEW {hop_summary_view} AS
SELECT
  hop_count,
  COUNT(DISTINCT reached_table_full_name) AS distinct_objects_at_hop,
  SUM(paths_through_object) AS path_rows_at_hop,
  MAX(latest_seen_time_to_child) AS latest_seen_time_any_object_at_hop,
  ARRAY_SORT(COLLECT_SET(reached_table_full_name)) AS objects_at_hop
FROM {objects_by_hop_view}
GROUP BY hop_count
""")

spark.sql(f"""
CREATE OR REPLACE VIEW {edges_by_hop_view} AS
WITH exploded_edges AS (
  SELECT
    path_id,
    edge_pos + 1 AS hop_count,
    element_at(path_tables, edge_pos + 2) AS from_table,
    element_at(path_tables, edge_pos + 1) AS to_table,
    latest_seen_time,
    element_at(edge_events_seen_7d_arr, edge_pos + 1) AS events_seen_7d
  FROM {current_paths_view}
  LATERAL VIEW posexplode(edge_latest_seen_times) p AS edge_pos, latest_seen_time
)
SELECT
  ee.hop_count,
  ee.from_table,
  ofrom.table_type AS from_type,
  ee.to_table,
  oto.table_type AS to_type,
  MAX(ee.latest_seen_time) AS latest_seen_time,
  MAX(ee.events_seen_7d) AS events_seen_7d,
  ARRAY_SORT(ARRAY_DISTINCT(FLATTEN(COLLECT_LIST(e.creators)))) AS creators,
  ARRAY_SORT(ARRAY_DISTINCT(FLATTEN(COLLECT_LIST(e.entity_types)))) AS entity_types,
  COUNT(DISTINCT ee.path_id) AS distinct_paths_through_edge
FROM exploded_edges ee
LEFT JOIN {edge_stage_table} e
  ON ee.from_table = e.source_table_full_name
 AND ee.to_table = e.target_table_full_name
LEFT JOIN {object_stage_table} ofrom
  ON ee.from_table = ofrom.table_full_name
LEFT JOIN {object_stage_table} oto
  ON ee.to_table = oto.table_full_name
GROUP BY
  ee.hop_count,
  ee.from_table,
  ofrom.table_type,
  ee.to_table,
  oto.table_type
""")

spark.sql(f"""
CREATE OR REPLACE VIEW {path_summary_view} AS
SELECT
  path_id,
  hop_count AS max_hop_count,
  CASE
    WHEN size(edge_latest_seen_times) = 0 THEN CAST(NULL AS TIMESTAMP)
    ELSE array_max(edge_latest_seen_times)
  END AS latest_seen_time_on_path,
  path_tables,
  leaf_table,
  is_terminal
FROM {current_paths_view}
""")

