-- Create permanent tables from the temp view built in Cell 2
CREATE OR REPLACE TABLE IDENTIFIER((SELECT target_schema FROM lineage_params) || '.' || (SELECT target_table_prefix FROM lineage_params) || '_full') 
AS SELECT * FROM lineage_final LIMIT ALL;

CREATE OR REPLACE TABLE IDENTIFIER((SELECT target_schema FROM lineage_params) || '.' || (SELECT target_table_prefix FROM lineage_params) || '_hop_edges_summary') 
AS
SELECT 
  direction,
  hop_count - 1 AS from_hop,
  ELEMENT_AT(path_tables, hop_count) AS from_table,
  hop_count AS to_hop,
  reached_table_full_name AS to_table,
  COUNT(DISTINCT path_id) AS num_paths_through_edge,
  COLLECT_SET(created_by) AS creators,
  COLLECT_SET(CONCAT(COALESCE(entity_type, 'UNKNOWN'), ' ', COALESCE(entity_id, 'N/A'))) AS hop_entity_steps_at_to_hop,
  MAX(event_time) AS latest_event_at_edge,
  COLLECT_SET(DATE(event_time)) AS event_dates_at_edge
FROM lineage_final
WHERE hop_count > 0
GROUP BY direction, from_hop, from_table, to_hop, to_table;

SELECT 
  '✅ All tables created successfully on Unity Catalog!' AS status,
  (SELECT target_schema FROM lineage_params) || '.' || (SELECT target_table_prefix FROM lineage_params) || '_hop_edges_summary' AS best_view_for_analysis;
