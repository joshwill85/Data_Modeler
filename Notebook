def traverse_table_direction(current_edges_df, direction: str):
    root_frontier = spark.createDataFrame(
        [(ROOT_FULL_NAME, ROOT_SCHEMA, ROOT_NAME, "TABLE", 0, ROOT_FULL_NAME)],
        ["current_table_full_name", "current_table_schema", "current_table_name", "current_type", "hop_count", "path_from_root"]
    )

