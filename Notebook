value_sets_cache = {}

def _df_cache_key(df, col: str):
    if df is None: return None
    try:
        return (df._jdf.toString(), col)
    except Exception:
        return (id(df), col)

def sampled_distinct_values(df, col: str, max_rows: int) -> set:
    cache_key = _df_cache_key(df, col)
    if cache_key and cache_key in value_sets_cache:
        return value_sets_cache[cache_key]
    out = set()
    if df is None:
        if cache_key: value_sets_cache[cache_key] = out
        return out
    try:
        sdf = sample_df(df.select(F.col(col)).where(F.col(col).isNotNull()), max_rows, min(1.0, ROW_SAMPLE_FRACTION))
        if sdf is not None:
            vals = [r[0] for r in sdf.distinct().limit(200000).collect()]
            out = set(str(v) for v in vals if v is not None)
    except Exception as e:
        warnings.append(f"Value sampling failed for column {col}: {e}")
        out = set()
    if cache_key:
        value_sets_cache[cache_key] = out
    return out

def collect_examples(df, cols, n=3):
    if not INCLUDE_EXAMPLES or df is None or not cols: return []
    try:
        rows = df.select(*[F.col(c) for c in cols]).limit(n).collect()
        return [{c: r[i] for i, c in enumerate(cols)} for r in rows]
    except Exception:
        return []

for t, meta in entities.items():
    df = safe_table(t)
    if df is None or len(meta["columns"]) == 0:
        meta["stats"] = {"null_ratio": {}, "approx_distinct": {}, "examples": []}
        meta["datetime_inference"] = {}
        continue
    eff_frac = ROW_SAMPLE_FRACTION
    if meta["row_count"] and meta["row_count"] > 50_000_000:
        eff_frac = min(eff_frac, 0.03)
    s_df = sample_df(df, NULLABILITY_SAMPLE_ROWS, eff_frac)
    null_ratio, approx_distinct, ex_rows, dt_info = {}, {}, [], {}

    try:
        if s_df is not None:
            exprs = [F.avg(F.when(F.col(c["name"]).isNull(), 1).otherwise(0)).alias(c["name"]) for c in meta["columns"]]
            result = s_df.select(*exprs).first()
            if result: null_ratio = result.asDict()
    except Exception as e:
        warnings.append(f"Null ratio calculation failed for {t}: {e}")

    try:
        if not FAST_MODE and df is not None:
            exprs = [approx_distinct_expr(c["name"]) for c in meta["columns"] if c["family"] in {"integral","decimal","floating","stringy","dates","boolean"}]
            if exprs:
                row = df.select(*exprs).first()
                if row: approx_distinct = row.asDict()
    except Exception as e:
        warnings.append(f"Approx distinct calculation failed for {t}: {e}")

    ex_rows = collect_examples(df, [c["name"] for c in meta["columns"]], 3)

    for f in meta["columns"]:
        cname, fam = f["name"], f["family"]
        fmt, support, counts = None, 0.0, None
        try:
            if fam == "dates":
                fmt = "spark_date_or_timestamp"; support = 1.0
            elif fam == "stringy" and s_df is not None:
                try:
                    rows = s_df.select(F.col(cname)).where(F.col(cname).isNotNull()).limit(2000).collect()
                    sample_vals = [str(v[0]) for v in rows if v[0] is not None]
                    fmt, support, counts = detect_string_datetime_format(sample_vals)
                except Exception:
                    pass
        except Exception:
            pass
        if fmt and support >= DATETIME_SUPPORT_MIN:
            dt_info[cname] = {
                "inferred_format": fmt,
                "support_fraction": round(float(support), 3),
                "pattern_counts": counts,
                "parse_howto": ("STRING→to_date/to_timestamp with detected pattern; "
                                "epoch_seconds→to_timestamp(col); epoch_millis→to_timestamp(col/1000.0). "
                                "DATE/TIMESTAMP are typed; use date_format for display.")
            }

    meta["stats"] = {"null_ratio": null_ratio, "approx_distinct": approx_distinct, "examples": ex_rows}
    meta["datetime_inference"] = dt_info

for t, meta in entities.items():
    nr = meta["stats"].get("null_ratio", {})
    ad = meta["stats"].get("approx_distinct", {})
    for c in meta["columns"]:
        cname = c["name"]
        c["null_ratio"] = float(nr.get(cname)) if cname in nr and nr[cname] is not None else None
        c["approx_distinct"] = int(ad.get(cname)) if cname in ad and ad[cname] is not None else None
        if cname in meta["datetime_inference"]:
            di = meta["datetime_inference"][cname]
            c["inferred_datetime_format"] = di["inferred_format"]
            c["inferred_datetime_support"] = di["support_fraction"]
            c["datetime_parse_howto"] = di["parse_howto"]
            c["datetime_pattern_counts"] = di.get("pattern_counts")

