        md.append("")
        md.append("## Table Inventory")
        for e in model["entities"]:
            md.append(f"### {e['name']}")
            md.append(f"- Rows: `{e.get('row_count')}`")
            md.append(f"- Type: `{e.get('table_type') or ('VIEW' if e.get('is_view') else 'TABLE')}`")
            md.append(f"- Source: `{e.get('data_source_format') or 'unknown'}`")
            md.append("")
            md.append("| Column | Type | Nullable | Approx Distinct | Null Ratio |")
            md.append("| --- | --- | --- | --- | --- |")
            for c in e["columns"]:
                md.append(f"| `{c['name']}` | `{c['type']}` | `{c['nullable']}` | `{c.get('approx_distinct')}` | `{c.get('null_ratio')}` |")
            md.append("")
        md.append("## Relationships")
        if model["relationships"]:
            for r in model["relationships"]:
                md.append(f"- **{r['fk_table']}**.`{r['fk_column']}` → **{r['pk_table']}**.`{r['pk_column']}` "
                          f"(score={r['score']}, conf={r['confidence']}, type={r['cardinality']})")
        else:
            md.append("_None found._")
        md.append("")
        md.append("## Notes")
        md.append("- Inferred edges are heuristics; verify before enforcing constraints.")
        return "\n".join(md)

    def render_html(self, model: Dict[str, Any]) -> str:
