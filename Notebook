def classify_exception(exc: Exception) -> str:
    msg = str(exc)
    up = msg.upper()
    if "TABLE_OR_VIEW_NOT_FOUND" in up or "NOT FOUND" in up or "CANNOT RESOLVE" in up:
        return "MISSING_OR_NOT_ENABLED"
    if "PERMISSION" in up or "INSUFFICIENT_PRIVILEGES" in up or "ACCESS DENIED" in up or "NOT AUTHORIZED" in up:
        return "NO_ACCESS"
    if "PARSE" in up or "SYNTAX" in up:
        return "SQL_ERROR"
    return "OTHER_ERROR"

def show_df(df, n=20):
    try:
        display(df.limit(n))
    except Exception:
        df.show(n, truncate=False)

def create_empty_view(view_name: str, schema_ddl: str):
    empty_df = spark.createDataFrame([], schema=schema_ddl)
    empty_df.createOrReplaceTempView(view_name)

def run_sql(name: str, sql_text: str, top_n: int = None, persist_view: str = None, collect_count: bool = True):
    if top_n is None:
        top_n = TOP_N
    try:
        df = spark.sql(sql_text)
        if persist_view:
            df.createOrReplaceTempView(persist_view)
        row_count = df.count() if collect_count else None
        status = "PASS" if (row_count is None or row_count > 0) else "NO_ROWS"
        print(f"\n===== {name} =====")
        print(f"status={status}" + (f" rows={row_count}" if row_count is not None else ""))
        if row_count is None or row_count > 0:
            show_df(df, top_n)
        return {
            "ok": True,
            "status": status,
            "rows": row_count,
            "df": df,
            "error_type": None,
            "error": None,
            "sql": sql_text
        }
    except Exception as exc:
        err_type = classify_exception(exc)
        print(f"\n===== {name} =====")
        print(f"status=ERROR error_type={err_type}")
        print(str(exc))
        return {
            "ok": False,
            "status": "ERROR",
            "rows": None,
            "df": None,
            "error_type": err_type,
            "error": str(exc),
            "sql": sql_text
        }

def add_test_result(test_name, category, precision, prerequisites, result, notes):
