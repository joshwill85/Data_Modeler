def get_row_count_fast(t: str, df) -> Optional[int]:
    try:
        d = spark.sql(f"DESCRIBE DETAIL {fq_table(t)}").select("numRows").first()
        if d and d[0] is not None: return int(d[0])
    except Exception:
        pass
    if not FAST_MODE and df is not None:
        try: return df.count()
        except Exception: pass
    return None

entities: Dict[str, Dict[str, Any]] = {}
for t in tables:
    df = safe_table(t)
    if df is None:
        entities[t] = {"table": t, "columns": [], "row_count": None, "props": {}, "is_view": False, "partial": True}
        continue
    props = {}
    try:
        desc = spark.sql(f"DESCRIBE EXTENDED {fq_table(t)}").collect()
        props = {r.col_name: r.data_type for r in desc if r.col_name and r.col_name != ""}
    except Exception as e:
        warnings.append(f"DESCRIBE EXTENDED failed for {t}: {e}")
    cols = []
    for f in df.schema.fields:
        fam = dtype_family(f.dataType)
        struct_fields = []
        try:
            nested = walk_schema("", f.dataType)
            struct_fields = [{"name": sf["path"], "type": sf["type"], "nullable": sf["nullable"]}
                             for sf in nested if sf["path"] and ("." in sf["path"] or "[]" in sf["path"] or "{}" in sf["path"])]
            struct_fields = struct_fields[:200]
        except Exception as e:
            warnings.append(f"Schema walking failed for {t}.{f.name}: {e}")
        cols.append({
            "name": f.name,
            "data_type": f.dataType.simpleString(),
            "family": fam,
            "nullable": f.nullable,
            "is_id_name": col_name_hints(f.name, ID_NAME_HINTS),
            "is_fk_name": col_name_hints(f.name, FK_NAME_HINTS),
            "struct_fields": struct_fields,
            "array_guidance": array_guidance(f.dataType),
            "map_guidance": map_guidance(f.dataType),
        })
    rc = get_row_count_fast(t, df)
    is_view = "Type" in props and "VIEW" in str(props.get("Type","")).upper()
    ov = table_overview.get(t, {})
    entities[t] = {
        "table": t,
        "columns": cols,
        "row_count": rc,
        "props": props,
        "is_view": is_view or (ov.get("table_type") == "VIEW"),
        "table_type": ov.get("table_type"),
        "data_source_format": ov.get("data_source_format"),
        "partial": False
    }

