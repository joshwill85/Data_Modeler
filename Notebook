# Databricks notebook source
# MAGIC %md
# MAGIC # AI billing identity diagnostic
# MAGIC
# MAGIC This notebook uses billing, query history, and jobs only.
# MAGIC
# MAGIC Sources used:
# MAGIC - `system.billing.usage` — required
# MAGIC - `system.query.history` — optional
# MAGIC - `system.lakeflow.jobs` — optional
# MAGIC
# MAGIC It creates only temporary views and is intended for testing.

# COMMAND ----------
# MAGIC %md
# MAGIC ## 1. Settings and test helper

# COMMAND ----------
DAYS = 30
AI_ORIGINS = ["AI_GATEWAY", "MODEL_SERVING", "AI_FUNCTIONS"]

from pyspark.sql import functions as F
from pyspark.sql.types import StructType, StructField, StringType, LongType
from pyspark.sql.window import Window

TESTS = []

def add_test(stage, test_name, status, detail="", value=None):
    TESTS.append((stage, test_name, status, str(detail), value))
    print(f"[{status}] {stage} | {test_name}: {detail}")

def can_read(table_name):
    try:
        spark.table(table_name).limit(1).collect()
        return True, "available"
    except Exception as e:
        return False, str(e).split("\n")[0][:500]

def has_path(schema, path):
    current = schema
    for part in path.split("."):
        if not isinstance(current, StructType):
            return False
        field = next((x for x in current.fields if x.name == part), None)
        if field is None:
            return False
        current = field.dataType
    return True

def optional_col(df, path, alias, data_type="string"):
    if has_path(df.schema, path):
        return F.col(path).cast(data_type).alias(alias)
    return F.lit(None).cast(data_type).alias(alias)

# COMMAND ----------
# MAGIC %md
# MAGIC ## 2. Confirm source access

# COMMAND ----------
SOURCE_ACCESS = {}
for table_name, required in [
    ("system.billing.usage", True),
    ("system.query.history", False),
    ("system.lakeflow.jobs", False),
]:
    ok, detail = can_read(table_name)
    SOURCE_ACCESS[table_name] = ok
    add_test("ACCESS", table_name, "PASS" if ok else ("FAIL" if required else "WARN"), detail)

if not SOURCE_ACCESS["system.billing.usage"]:
    raise Exception("Required source system.billing.usage is unavailable.")

# COMMAND ----------
# MAGIC %md
# MAGIC ## 3. Inspect only the billing fields used by this notebook

# COMMAND ----------
usage_raw = spark.table("system.billing.usage")

PATHS = [
    "record_id",
    "workspace_id",
    "usage_date",
    "usage_start_time",
    "usage_end_time",
    "billing_origin_product",
    "sku_name",
    "usage_unit",
    "usage_quantity",
    "identity_metadata.run_as",
    "identity_metadata.run_by",
    "identity_metadata.owned_by",
    "usage_metadata.job_id",
    "usage_metadata.job_run_id",
    "usage_metadata.job_name",
    "usage_metadata.notebook_id",
    "usage_metadata.notebook_path",
    "usage_metadata.warehouse_id",
    "usage_metadata.cluster_id",
    "usage_metadata.endpoint_id",
    "usage_metadata.endpoint_name",
    "product_features.ai_functions.ai_function",
    "custom_tags",
]

schema_rows = [(path, has_path(usage_raw.schema, path)) for path in PATHS]
display(spark.createDataFrame(schema_rows, ["field_path", "exists"]))

for path, exists in schema_rows:
    add_test("SCHEMA", path, "PASS" if exists else "WARN", "present" if exists else "missing")

# COMMAND ----------
# MAGIC %md
# MAGIC ## 4. Build AI billing rows
# MAGIC
# MAGIC `MODEL_SERVING` below is only a value in `billing_origin_product`; it does not query a serving system table.

# COMMAND ----------
usage_filtered = usage_raw.filter(
    (F.col("usage_date") >= F.date_sub(F.current_date(), DAYS)) &
    (F.col("billing_origin_product").isin(AI_ORIGINS))
)

billing = usage_filtered.select(
    optional_col(usage_filtered, "record_id", "record_id"),
    optional_col(usage_filtered, "workspace_id", "workspace_id"),
    optional_col(usage_filtered, "usage_date", "usage_date", "date"),
    optional_col(usage_filtered, "usage_start_time", "usage_start_time", "timestamp"),
    optional_col(usage_filtered, "usage_end_time", "usage_end_time", "timestamp"),
    optional_col(usage_filtered, "billing_origin_product", "billing_origin_product"),
    optional_col(usage_filtered, "sku_name", "sku_name"),
    optional_col(usage_filtered, "usage_unit", "usage_unit"),
    optional_col(usage_filtered, "usage_quantity", "usage_quantity", "decimal(38,12)"),
    optional_col(usage_filtered, "identity_metadata.run_as", "billing_run_as"),
    optional_col(usage_filtered, "identity_metadata.run_by", "billing_run_by"),
    optional_col(usage_filtered, "identity_metadata.owned_by", "billing_owned_by"),
    optional_col(usage_filtered, "usage_metadata.job_id", "job_id"),
    optional_col(usage_filtered, "usage_metadata.job_run_id", "job_run_id"),
    optional_col(usage_filtered, "usage_metadata.job_name", "billing_job_name"),
    optional_col(usage_filtered, "usage_metadata.notebook_id", "notebook_id"),
    optional_col(usage_filtered, "usage_metadata.notebook_path", "notebook_path"),
    optional_col(usage_filtered, "usage_metadata.warehouse_id", "warehouse_id"),
    optional_col(usage_filtered, "usage_metadata.cluster_id", "cluster_id"),
    optional_col(usage_filtered, "usage_metadata.endpoint_id", "endpoint_id"),
    optional_col(usage_filtered, "usage_metadata.endpoint_name", "endpoint_name"),
    optional_col(usage_filtered, "product_features.ai_functions.ai_function", "ai_function"),
    optional_col(usage_filtered, "custom_tags", "custom_tags", "map<string,string>"),
)

billing.createOrReplaceTempView("ai_billing")

billing_count = billing.count()
add_test("BILLING", "AI billing rows", "PASS" if billing_count > 0 else "WARN", f"{billing_count:,} rows", billing_count)
display(billing.groupBy("billing_origin_product").count().orderBy("billing_origin_product"))

# COMMAND ----------
# MAGIC %md
# MAGIC ## 5. Billing null and redaction tests

# COMMAND ----------
for column_name in [
    "record_id", "workspace_id", "usage_date", "usage_start_time", "usage_end_time",
    "billing_origin_product", "sku_name", "usage_unit", "usage_quantity"
]:
    null_count = billing.filter(F.col(column_name).isNull()).count()
    add_test("BILLING_NULL", column_name, "PASS" if null_count == 0 else "FAIL", f"{null_count:,} null rows", null_count)

for column_name in ["billing_run_as", "billing_run_by", "billing_owned_by"]:
    null_count = billing.filter(F.col(column_name).isNull()).count()
    redacted_count = billing.filter(F.col(column_name) == "__REDACTED__").count()
    add_test(
        "BILLING_IDENTITY",
        column_name,
        "PASS" if null_count == 0 and redacted_count == 0 else "WARN",
        f"null={null_count:,}; redacted={redacted_count:,}",
        null_count + redacted_count,
    )

identifier_coverage = billing.groupBy("billing_origin_product").agg(
    F.count("*").alias("rows"),
    F.sum(F.col("job_id").isNotNull().cast("int")).alias("rows_with_job_id"),
    F.sum(F.col("job_run_id").isNotNull().cast("int")).alias("rows_with_job_run_id"),
    F.sum(F.col("notebook_id").isNotNull().cast("int")).alias("rows_with_notebook_id"),
    F.sum(F.col("warehouse_id").isNotNull().cast("int")).alias("rows_with_warehouse_id"),
    F.sum(F.col("cluster_id").isNotNull().cast("int")).alias("rows_with_cluster_id"),
    F.sum((F.col("endpoint_id").isNotNull() | F.col("endpoint_name").isNotNull()).cast("int")).alias("rows_with_endpoint"),
)
display(identifier_coverage.orderBy("billing_origin_product"))

# COMMAND ----------
# MAGIC %md
# MAGIC ## 6. Build optional job identity

# COMMAND ----------
if SOURCE_ACCESS["system.lakeflow.jobs"]:
    try:
        jobs_raw = spark.table("system.lakeflow.jobs")
        jobs_selected = jobs_raw.select(
            optional_col(jobs_raw, "workspace_id", "workspace_id"),
            optional_col(jobs_raw, "job_id", "job_id"),
            optional_col(jobs_raw, "name", "job_name"),
            optional_col(jobs_raw, "run_as_user_name", "job_run_as"),
            optional_col(jobs_raw, "creator_user_name", "job_creator"),
            optional_col(jobs_raw, "change_time", "change_time", "timestamp"),
        )
        window = Window.partitionBy("workspace_id", "job_id").orderBy(F.col("change_time").desc_nulls_last())
        jobs = jobs_selected.withColumn("rn", F.row_number().over(window)).filter("rn = 1").drop("rn")
        jobs.createOrReplaceTempView("ai_jobs")
        add_test("JOBS", "build", "PASS", f"{jobs.count():,} current job rows", jobs.count())
    except Exception as e:
        add_test("JOBS", "build", "WARN", str(e).split("\n")[0][:500])
        spark.sql("""
            SELECT CAST(NULL AS STRING) workspace_id,
                   CAST(NULL AS STRING) job_id,
                   CAST(NULL AS STRING) job_name,
                   CAST(NULL AS STRING) job_run_as,
                   CAST(NULL AS STRING) job_creator
            WHERE FALSE
        """).createOrReplaceTempView("ai_jobs")
else:
    spark.sql("""
        SELECT CAST(NULL AS STRING) workspace_id,
               CAST(NULL AS STRING) job_id,
               CAST(NULL AS STRING) job_name,
               CAST(NULL AS STRING) job_run_as,
               CAST(NULL AS STRING) job_creator
        WHERE FALSE
    """).createOrReplaceTempView("ai_jobs")

# COMMAND ----------
# MAGIC %md
# MAGIC ## 7. Build optional query identity

# COMMAND ----------
if SOURCE_ACCESS["system.query.history"]:
    try:
        query_raw = spark.table("system.query.history").filter(
            F.col("start_time") >= F.current_timestamp() - F.expr(f"INTERVAL {DAYS} DAYS")
        )

        queries = query_raw.select(
            optional_col(query_raw, "workspace_id", "workspace_id"),
            optional_col(query_raw, "statement_id", "statement_id"),
            optional_col(query_raw, "start_time", "start_time", "timestamp"),
            optional_col(query_raw, "end_time", "end_time", "timestamp"),
            optional_col(query_raw, "executed_by", "executed_by"),
            optional_col(query_raw, "executed_as", "executed_as"),
            optional_col(query_raw, "compute.warehouse_id", "warehouse_id"),
            optional_col(query_raw, "query_source.notebook_id", "notebook_id"),
            optional_col(query_raw, "query_source.job_info.job_id", "job_id"),
            optional_col(query_raw, "query_source.job_info.job_run_id", "job_run_id"),
            optional_col(query_raw, "statement_text", "statement_text"),
        ).withColumn("end_time", F.coalesce("end_time", "start_time"))

        queries.createOrReplaceTempView("ai_queries")
        query_count = queries.count()
        add_test("QUERY_HISTORY", "build", "PASS", f"{query_count:,} rows", query_count)

        for column_name in ["statement_id", "workspace_id", "start_time", "executed_by"]:
            null_count = queries.filter(F.col(column_name).isNull()).count()
            add_test("QUERY_NULL", column_name, "PASS" if null_count == 0 else "WARN", f"{null_count:,} null rows", null_count)

    except Exception as e:
        add_test("QUERY_HISTORY", "build", "WARN", str(e).split("\n")[0][:500])
        spark.sql("""
            SELECT CAST(NULL AS STRING) workspace_id,
                   CAST(NULL AS STRING) statement_id,
                   CAST(NULL AS TIMESTAMP) start_time,
                   CAST(NULL AS TIMESTAMP) end_time,
                   CAST(NULL AS STRING) executed_by,
                   CAST(NULL AS STRING) executed_as,
                   CAST(NULL AS STRING) warehouse_id,
                   CAST(NULL AS STRING) notebook_id,
                   CAST(NULL AS STRING) job_id,
                   CAST(NULL AS STRING) job_run_id,
                   CAST(NULL AS STRING) statement_text
            WHERE FALSE
        """).createOrReplaceTempView("ai_queries")
else:
    spark.sql("""
        SELECT CAST(NULL AS STRING) workspace_id,
               CAST(NULL AS STRING) statement_id,
               CAST(NULL AS TIMESTAMP) start_time,
               CAST(NULL AS TIMESTAMP) end_time,
               CAST(NULL AS STRING) executed_by,
               CAST(NULL AS STRING) executed_as,
               CAST(NULL AS STRING) warehouse_id,
               CAST(NULL AS STRING) notebook_id,
               CAST(NULL AS STRING) job_id,
               CAST(NULL AS STRING) job_run_id,
               CAST(NULL AS STRING) statement_text
        WHERE FALSE
    """).createOrReplaceTempView("ai_queries")

# COMMAND ----------
# MAGIC %md
# MAGIC ## 8. Match billing rows to query-history identities

# COMMAND ----------
query_matches = spark.sql("""
SELECT
    b.record_id,
    COLLECT_SET(CASE
        WHEN b.job_run_id IS NOT NULL AND q.job_run_id = b.job_run_id THEN q.executed_by
        WHEN b.job_id IS NOT NULL AND q.job_id = b.job_id THEN q.executed_by
        WHEN b.notebook_id IS NOT NULL AND q.notebook_id = b.notebook_id THEN q.executed_by
    END) AS exact_query_users,
    COLLECT_SET(CASE
        WHEN b.job_run_id IS NOT NULL AND q.job_run_id = b.job_run_id THEN q.executed_as
        WHEN b.job_id IS NOT NULL AND q.job_id = b.job_id THEN q.executed_as
        WHEN b.notebook_id IS NOT NULL AND q.notebook_id = b.notebook_id THEN q.executed_as
    END) AS exact_effective_principals,
    COLLECT_SET(CASE
        WHEN b.warehouse_id IS NOT NULL AND q.warehouse_id = b.warehouse_id THEN q.executed_by
    END) AS warehouse_window_users,
    COLLECT_SET(q.statement_id) AS statement_ids
FROM ai_billing b
JOIN ai_queries q
  ON b.workspace_id = q.workspace_id
 AND q.start_time < b.usage_end_time
 AND q.end_time >= b.usage_start_time
 AND (
       (b.job_run_id IS NOT NULL AND q.job_run_id = b.job_run_id)
    OR (b.job_id IS NOT NULL AND q.job_id = b.job_id)
    OR (b.notebook_id IS NOT NULL AND q.notebook_id = b.notebook_id)
    OR (b.warehouse_id IS NOT NULL AND q.warehouse_id = b.warehouse_id)
 )
GROUP BY b.record_id
""")

query_matches.createOrReplaceTempView("ai_query_matches")
matched_count = query_matches.count()
add_test("QUERY_JOIN", "matched billing records", "PASS" if matched_count > 0 else "WARN", f"{matched_count:,} rows", matched_count)

# COMMAND ----------
# MAGIC %md
# MAGIC ## 9. Final attribution output

# COMMAND ----------
result = spark.sql("""
WITH enriched AS (
    SELECT
        b.*,
        COALESCE(j.job_name, b.billing_job_name) AS job_name,
        j.job_run_as,
        j.job_creator,
        q.exact_query_users,
        q.exact_effective_principals,
        q.warehouse_window_users,
        q.statement_ids
    FROM ai_billing b
    LEFT JOIN ai_jobs j
      ON b.workspace_id = j.workspace_id
     AND b.job_id = j.job_id
    LEFT JOIN ai_query_matches q
      ON b.record_id = q.record_id
)
SELECT
    *,
    ARRAY_DISTINCT(
        FILTER(
            CONCAT(
                COALESCE(exact_query_users, CAST(array() AS ARRAY<STRING>)),
                COALESCE(exact_effective_principals, CAST(array() AS ARRAY<STRING>)),
                COALESCE(warehouse_window_users, CAST(array() AS ARRAY<STRING>)),
                FILTER(
                    ARRAY(billing_run_as, billing_run_by, billing_owned_by, job_run_as, job_creator),
                    x -> x IS NOT NULL
                )
            ),
            x -> x IS NOT NULL AND x <> '__REDACTED__'
        )
    ) AS who_candidates,
    CASE
        WHEN billing_run_by IS NOT NULL AND billing_run_by <> '__REDACTED__' THEN billing_run_by
        WHEN SIZE(COALESCE(exact_query_users, CAST(array() AS ARRAY<STRING>))) = 1 THEN ELEMENT_AT(exact_query_users, 1)
        WHEN job_run_as IS NOT NULL AND job_run_as <> '__REDACTED__' THEN job_run_as
        WHEN billing_run_as IS NOT NULL AND billing_run_as <> '__REDACTED__' THEN billing_run_as
        WHEN SIZE(COALESCE(warehouse_window_users, CAST(array() AS ARRAY<STRING>))) = 1 THEN ELEMENT_AT(warehouse_window_users, 1)
        WHEN job_creator IS NOT NULL AND job_creator <> '__REDACTED__' THEN job_creator
        WHEN billing_owned_by IS NOT NULL AND billing_owned_by <> '__REDACTED__' THEN billing_owned_by
    END AS best_who,
    CASE
        WHEN billing_run_by IS NOT NULL AND billing_run_by <> '__REDACTED__' THEN 'BILLING_RUN_BY'
        WHEN SIZE(COALESCE(exact_query_users, CAST(array() AS ARRAY<STRING>))) = 1 THEN 'EXACT_QUERY_EXECUTOR'
        WHEN job_run_as IS NOT NULL AND job_run_as <> '__REDACTED__' THEN 'JOB_RUN_AS'
        WHEN billing_run_as IS NOT NULL AND billing_run_as <> '__REDACTED__' THEN 'BILLING_RUN_AS'
        WHEN SIZE(COALESCE(warehouse_window_users, CAST(array() AS ARRAY<STRING>))) = 1 THEN 'SOLE_WAREHOUSE_USER_IN_WINDOW'
        WHEN job_creator IS NOT NULL AND job_creator <> '__REDACTED__' THEN 'JOB_CREATOR'
        WHEN billing_owned_by IS NOT NULL AND billing_owned_by <> '__REDACTED__' THEN 'BILLING_OWNER'
        ELSE 'UNRESOLVED'
    END AS best_who_source
FROM enriched
""")

result.createOrReplaceTempView("ai_cost_attribution")
display(result.orderBy(F.col("usage_start_time").desc()))

# COMMAND ----------
# MAGIC %md
# MAGIC ## 10. Attribution coverage and unresolved rows

# COMMAND ----------
display(
    result.groupBy("billing_origin_product", "best_who_source")
          .agg(
              F.count("*").alias("rows"),
              F.sum("usage_quantity").alias("usage_quantity")
          )
          .orderBy("billing_origin_product", F.desc("rows"))
)

unresolved_count = result.filter(F.col("best_who").isNull()).count()
add_test("FINAL", "unresolved best_who", "PASS" if unresolved_count == 0 else "WARN", f"{unresolved_count:,} rows", unresolved_count)

display(
    result.filter(F.col("best_who").isNull())
          .select(
              "usage_start_time",
              "billing_origin_product",
              "sku_name",
              "usage_quantity",
              "job_id",
              "job_run_id",
              "notebook_id",
              "warehouse_id",
              "cluster_id",
              "endpoint_id",
              "endpoint_name",
              "ai_function",
              "custom_tags",
              "who_candidates",
          )
          .orderBy(F.col("usage_start_time").desc())
)

# COMMAND ----------
# MAGIC %md
# MAGIC ## 11. Test summary

# COMMAND ----------
test_schema = StructType([
    StructField("stage", StringType(), False),
    StructField("test", StringType(), False),
    StructField("status", StringType(), False),
    StructField("detail", StringType(), True),
    StructField("value", LongType(), True),
])

test_df = spark.createDataFrame(TESTS, test_schema)
display(
    test_df.orderBy(
        F.when(F.col("status") == "FAIL", 1)
         .when(F.col("status") == "WARN", 2)
         .otherwise(3),
        "stage",
        "test",
    )
)
