    props = {}
    try:
        desc = spark.sql(f"DESCRIBE EXTENDED {fq_table(t)}").collect()
        props = {r.col_name: r.data_type for r in desc if r.col_name and r.col_name != ""}
    except Exception as e:
        warnings.append(f"DESCRIBE EXTENDED failed for {t}: {e}")

    # Collect columns with complex-type guidance
    cols = []
    for f in df.schema.fields:
        fam = dtype_family(f.dataType)
        cols.append({
            "name": f.name,
            "data_type": f.dataType.simpleString(),
            "family": fam,
            "nullable": f.nullable,
            "is_id_name": col_name_hints(f.name, ID_NAME_HINTS),
            "is_fk_name": col_name_hints(f.name, FK_NAME_HINTS),
            "struct_fields": [{"name": sf["path"], "type": sf["type"], "nullable": sf["nullable"]} for sf in walk_schema("", f.dataType) if sf["path"] and ("." in sf["path"] or "[]" in sf["path"] or "{}" in sf["path"])][:200],  # cap for display
            "array_guidance": array_guidance(f.dataType),
            "map_guidance": map_guidance(f.dataType),
        })

    rc = get_row_count_fast(t, df)
    is_view = "Type" in props and "VIEW" in str(props.get("Type","")).upper()
    # Merge info_schema overview if present
    ov = table_overview.get(t, {})
    entities[t] = {
        "table": t,
        "columns": cols,
        "row_count": rc,
        "props": props,
        "is_view": is_view or (ov.get("table_type") == "VIEW"),
        "table_type": ov.get("table_type"),
        "data_source_format": ov.get("data_source_format"),
        "partial": False
    }

# =========================
# STATS + DATE/TIME INFERENCE (bounded)
# =========================
value_sets_cache = {}

def sampled_distinct_values(df, col: str, max_rows: int) -> set:
    key = (df._jdf.toString(), col) if df is not None else None
    if key in value_sets_cache: return value_sets_cache[key]
    out = set()
    if df is None: 
        value_sets_cache[key] = out; return out
    try:
        sdf = sample_df(df.select(F.col(col)).where(F.col(col).isNotNull()), max_rows, min(1.0, ROW_SAMPLE_FRACTION))
        vals = [r[0] for r in sdf.distinct().limit(200000).collect()]
        out = set([str(v) for v in vals if v is not None])
    except Exception as e:
        warnings.append(f"Value sampling failed for {col}: {e}")
        out = set()
    if key is not None:
        value_sets_cache[key] = out
    return out

def collect_examples(df, cols, n=3):
    if not INCLUDE_EXAMPLES or df is None or not cols: return []
    try:
        rows = df.select(*[F.col(c) for c in cols]).limit(n).collect()
        return [{c: r[i] for i,c in enumerate(cols)} for r in rows]
    except Exception:
        return []

for t, meta in entities.items():
    df = safe_table(t)
    if df is None or len(meta["columns"]) == 0:
        meta["stats"] = {"null_ratio": {}, "approx_distinct": {}, "examples": []}
        meta["datetime_inference"] = {}
        continue

    eff_frac = ROW_SAMPLE_FRACTION
    if meta["row_count"] and meta["row_count"] > 50_000_000:
        eff_frac = min(eff_frac, 0.03)

    s_df = sample_df(df, NULLABILITY_SAMPLE_ROWS, eff_frac)
    null_ratio, approx_distinct, ex_rows, dt_info = {}, {}, [], {}

    # Null ratios (sample)
    try:
        if s_df is not None:
            exprs = [F.avg(F.when(F.col(c["name"]).isNull(), 1).otherwise(0)).alias(c["name"]) for c in meta["columns"]]
            null_ratio = s_df.select(*exprs).first().asDict()
    except Exception as e:
        warnings.append(f"Null ratio failed for {t}: {e}")

    # Approx distinct (skip in FAST_MODE)
    try:
        if not FAST_MODE:
            exprs = [approx_distinct_expr(c["name"]) for c in meta["columns"] if c["family"] in {"integral","decimal","floating","stringy","dates","boolean"}]
            if exprs:
                row = df.select(*exprs).first()
                if row:
                    approx_distinct = row.asDict()
    except Exception as e:
        warnings.append(f"Approx distinct failed for {t}: {e}")

    # Examples (off by default)
    ex_rows = collect_examples(df, [c["name"] for c in meta["columns"]], 3)

    # Date/time inference
    for f in meta["columns"]:
        cname, fam = f["name"], f["family"]
        fmt, support, counts = None, 0.0, None
        try:
            if fam == "dates":
                fmt = "spark_date_or_timestamp"; support = 1.0
            elif fam == "stringy":
                svals = []
                if s_df is not None:
                    svals = [str(v) for v in s_df.select(F.col(cname)).where(F.col(cname).isNotNull()).limit(2000).collect() if (v:=v[0]) is not None]
                fmt, support, counts = detect_string_datetime_format(svals)
        except Exception:
            pass
        if fmt:
            dt_info[cname] = {
                "inferred_format": fmt,
                "support_fraction": round(float(support), 3),
                "pattern_counts": counts,
                "parse_howto": (
                    "STRING→to_date/ to_timestamp with detected pattern; "
                    "epoch_seconds→to_timestamp(col); epoch_millis→to_timestamp(col/1000.0). "
                    "DATE/TIMESTAMP are typed; use date_format for display."
                )
            }

    meta["stats"] = {"null_ratio": null_ratio, "approx_distinct": approx_distinct, "examples": ex_rows}
    meta["datetime_inference"] = dt_info

# attach stats at column level
for t, meta in entities.items():
    nr = meta["stats"].get("null_ratio", {})
    ad = meta["stats"].get("approx_distinct", {})
    for c in meta["columns"]:
        cname = c["name"]
        c["null_ratio"] = float(nr.get(cname)) if cname in nr and nr[cname] is not None else None
        c["approx_distinct"] = int(ad.get(cname)) if cname in ad and ad[cname] is not None else None
        if cname in meta["datetime_inference"]:
            di = meta["datetime_inference"][cname]
            c["inferred_datetime_format"] = di["inferred_format"]
            c["inferred_datetime_support"] = di["support_fraction"]
            c["datetime_parse_howto"] = di["parse_howto"]
            c["datetime_pattern_counts"] = di.get("pattern_counts")

# =========================
# KEY CANDIDATES + COMPOSITES (PK), FK candidates
# =========================
def is_candidate_pk(col_meta, row_count):
    if row_count in (None, 0): return (False, 0.0)
    s = 0.0
    ad = col_meta.get("approx_distinct")
    if ad is not None: s += 0.6 * min(1.0, ad / max(1.0, row_count))
    nr = col_meta.get("null_ratio")
    if nr is not None: s += 0.2 * (1.0 - nr)
    if col_meta.get("is_id_name"): s += 0.2
    return (s >= 0.65), s

def is_candidate_fk(col_meta):
    s = 0.0
    nr = col_meta.get("null_ratio")
    if nr is not None: s += 0.3 * (1.0 - nr)
    if col_meta.get("is_fk_name") or col_meta.get("is_id_name"): s += 0.4
    if col_meta.get("family","") in {"integral","decimal","floating","stringy","dates"}: s += 0.3
    return (s >= 0.55), s

for t, meta in entities.items():
    rc = meta.get("row_count")
    for c in meta["columns"]:
        pkf, pks = is_candidate_pk(c, rc)
        fkf, fks = is_candidate_fk(c)
        c["candidate_pk"] = pkf; c["candidate_pk_score"] = round(pks,3)
        c["candidate_fk"] = fkf; c["candidate_fk_score"] = round(fks,3)

# Respect declared PKs
for tbl, cols in declared_constraints["pk"].items():
    if tbl in entities:
        for c in entities[tbl]["columns"]:
            c["candidate_pk"] = c["name"] in cols
            if c["candidate_pk"]:
                c["candidate_pk_score"] = 1.0

# Composite PKs (sampled hash distinct)
def best_composite_pk(df, cols_meta, row_count, top_n=6, max_k=3):
    cols_meta = sorted(cols_meta, key=lambda c: c.get("candidate_pk_score",0), reverse=True)[:top_n]
    names = [c["name"] for c in cols_meta]
    if len(names) < 2: return None, 0.0
    sdf = sample_df(df.select(*[F.col(n) for n in names]), 200_000, 0.2 if not FAST_MODE else 0.05)
    if sdf is None: return None, 0.0
    best, best_score = None, 0.0
    for k in range(2, max_k+1):
        for combo in itertools.combinations(names, k):
            try:
                ad = sdf.select(
                    F.approx_count_distinct(
                        F.sha2(F.concat_ws("||", *[F.col(x).cast("string") for x in combo]), 256)
                    )
                ).first()[0]
                distinct_ratio = (ad or 0) / max(1, (row_count or ad or 1))
                score = 0.75*distinct_ratio + 0.25*(sum(next(cm for cm in cols_meta if cm["name"]==x)["candidate_pk_score"] for x in combo)/k)
                if score > best_score:
                    best, best_score = combo, score
            except Exception:
                pass
    return best, round(float(best_score),3)

pk_registry = {}
for t, meta in entities.items():
    if t in declared_constraints["pk"] and declared_constraints["pk"][t]:
        pk_registry[t] = declared_constraints["pk"][t]
        continue
    cands = [c for c in meta["columns"] if c.get("candidate_pk")]
    if cands:
        df = safe_table(t)
        combo, score = (None, 0.0)
        if not FAST_MODE:
            combo, score = best_composite_pk(df, cands, meta.get("row_count"), TOP_PK_CANDIDATES, MAX_COMPOSITE_K)
        if combo and score >= 0.80:
            pk_registry[t] = list(combo)
        else:
            pk_registry[t] = [sorted([(c["name"], c["candidate_pk_score"]) for c in cands], key=lambda x: x[1], reverse=True)[0][0]]
    else:
        pk_registry[t] = []

# =========================
# RELATIONSHIPS (declared first, then inferred; optional composite FK inference)
# =========================
relationships = []

# Declared FKs
for fk in declared_constraints["fk"]:
    relationships.append({
        "fk_table": fk["fk_table"],
        "fk_column": fk["fk_cols"][0] if fk["fk_cols"] else None,
        "pk_table": fk["pk_table"],
        "pk_column": fk["pk_cols"][0] if fk["pk_cols"] else None,
        "score": 1.0,
        "evidence": {"declared_constraint": fk["name"]},
        "cardinality": "many-to-one",
        "declared": True,
        "join_example_sql": f"SELECT * FROM {fq_table(fk['fk_table'])} f JOIN {fq_table(fk['pk_table'])} p ON f.`{fk['fk_cols'][0]}` = p.`{fk['pk_cols'][0]}`",
        "join_example_pyspark": f"fk.join(pk, F.col('f.`{fk['fk_cols'][0]}`')==F.col('p.`{fk['pk_cols'][0]}`'), 'left')"
    })

# Inferred FKs (single-column)
for fk_table, fk_meta in entities.items():
    df_fk = safe_table(fk_table)
    for fk_col in [c for c in fk_meta["columns"] if c.get("candidate_fk")]:
        fk_name = fk_col["name"]; fk_fam = fk_col["family"]; fk_null = fk_col.get("null_ratio"); fk_ad = fk_col.get("approx_distinct")
        for pk_table, pk_cols in pk_registry.items():
            if not pk_cols: continue
            if any(r.get("declared") and r["fk_table"]==fk_table and r["pk_table"]==pk_table for r in relationships):
                continue
            best_name, best_score, best_ev = None, 0.0, None
            for pk_name in pk_cols:
                pk_col = next((c for c in entities[pk_table]["columns"] if c["name"]==pk_name), None)
                if pk_col is None: continue
                sc_name = name_match_score(fk_name, pk_name)
                sc_type = type_compat_score(fk_fam, pk_col["family"])
                if sc_type <= 0.0: continue
                sc_null = null_ratio_score(fk_null)
                sc_dr   = distinct_ratio_score(pk_col.get("approx_distinct"), entities[pk_table].get("row_count"))
                sc_card = cardinality_score(fk_ad, pk_col.get("approx_distinct"))

                sc_overlap = 0.0
                if ENABLE_VALUE_OVERLAP:
                    try:
                        fk_vals = sampled_distinct_values(df_fk, fk_name, VALUE_OVERLAP_SAMPLE_ROWS)
                        pk_vals = sampled_distinct_values(safe_table(pk_table), pk_name, VALUE_OVERLAP_SAMPLE_ROWS)
                        if fk_vals:
                            sc_overlap = min(1.0, len(fk_vals & pk_vals) / max(1, len(fk_vals)))
                    except Exception as e:
                        warnings.append(f"Overlap failed {fk_table}.{fk_name} -> {pk_table}.{pk_name}: {e}")
                        sc_overlap = 0.0

                total = (0.20*sc_name + 0.10*sc_type + 0.20*sc_dr + 0.10*sc_null + 0.35*sc_overlap + 0.05*sc_card)
                if total > best_score:
                    best_score = total
                    best_name  = pk_name
                    best_ev    = {
                        "name_match": round(sc_name,3),
                        "type_compat": sc_type,
                        "pk_distinct_ratio": round(sc_dr,3),
                        "fk_null_complement": round(sc_null,3),
                        "value_overlap": round(sc_overlap,3),
                        "cardinality_shape": round(sc_card,3),
                        "fk_ad": fk_ad,
                        "pk_ad": pk_col.get("approx_distinct")
                    }
            if best_name and best_score >= MIN_REL_SCORE:
                # cardinality type (1:1 vs M:1) hint
                card = "many-to-one"
                try:
                    pk_ad = next((c for c in entities[pk_table]["columns"] if c["name"]==best_name), {}).get("approx_distinct")
                    if fk_ad is not None and pk_ad is not None and abs(fk_ad - pk_ad) / max(1, pk_ad) < 0.05:
                        card = "one-to-one"
                except Exception:
                    pass
                relationships.append({
                    "fk_table": fk_table, "fk_column": fk_name,
                    "pk_table": pk_table, "pk_column": best_name,
                    "score": round(best_score,3),
                    "evidence": best_ev,
                    "cardinality": card,
                    "declared": False,
                    "join_example_sql": f"SELECT * FROM {fq_table(fk_table)} f JOIN {fq_table(pk_table)} p ON f.`{fk_name}` = p.`{best_name}`",
                    "join_example_pyspark": f"fk.join(pk, F.col('f.`{fk_name}`')==F.col('p.`{best_name}`'), 'left')"
                })

# Optional composite FK inference: try matching parent composite PK by name and (optional) overlap of hashed combos
if ENABLE_COMPOSITE_FK_INFERENCE:
    for pk_table, pk_cols in pk_registry.items():
        if len(pk_cols) < 2: continue
        for fk_table, fk_meta in entities.items():
            if fk_table == pk_table: continue
            fk_names = [c["name"] for c in fk_meta["columns"]]
            # naive name-based subset check
            if all(any(fn.lower()==pc.lower() or fn.lower().endswith("_"+pc.lower()) for fn in fk_names) for pc in pk_cols):
                # optional overlap check (sampled)
                passes_overlap = True
                if ENABLE_VALUE_OVERLAP:
                    try:
                        df_fk = safe_table(fk_table); df_pk = safe_table(pk_table)
                        if df_fk is not None and df_pk is not None:
                            fk_sdf = sample_df(df_fk.select(*[F.col(c).cast("string") for c in pk_cols]), VALUE_OVERLAP_SAMPLE_ROWS, min(1.0, ROW_SAMPLE_FRACTION))
                            pk_sdf = sample_df(df_pk.select(*[F.col(c).cast("string") for c in pk_cols]), VALUE_OVERLAP_SAMPLE_ROWS, min(1.0, ROW_SAMPLE_FRACTION))
                            if fk_sdf is not None and pk_sdf is not None:
                                fk_hash = {r[0] for r in fk_sdf.select(F.sha2(F.concat_ws("||", *[F.col(c) for c in pk_cols]), 256)).distinct().limit(200000).collect()}
                                pk_hash = {r[0] for r in pk_sdf.select(F.sha2(F.concat_ws("||", *[F.col(c) for c in pk_cols]), 256)).distinct().limit(200000).collect()}
                                if fk_hash:
                                    overlap = len(fk_hash & pk_hash) / max(1, len(fk_hash))
                                    passes_overlap = overlap >= 0.5  # heuristic
                    except Exception as e:
                        warnings.append(f"Composite FK overlap failed {fk_table}->{pk_table}: {e}")
                if passes_overlap:
                    # register one representative row with combined columns
                    relationships.append({
                        "fk_table": fk_table, "fk_column": " + ".join(pk_cols),
                        "pk_table": pk_table, "pk_column": " + ".join(pk_cols),
                        "score": 0.85 if ENABLE_VALUE_OVERLAP else 0.70,
                        "evidence": {"composite_match_on_names": True, "overlap_checked": ENABLE_VALUE_OVERLAP},
                        "cardinality": "many-to-one",
                        "declared": False,
                        "join_example_sql": f"SELECT * FROM {fq_table(fk_table)} f JOIN {fq_table(pk_table)} p ON " + " AND ".join([f"f.`{c}`=p.`{c}`" for c in pk_cols]),
                        "join_example_pyspark": "fk.join(pk, " + " & ".join([f"(F.col('f.`{c}`')==F.col('p.`{c}`'))" for c in pk_cols]) + ", 'left')"
                    })

