def md_escape(s): 
    """Escape markdown special characters"""
    if s is None: return ""
    return str(s).replace("|", "\\|").replace("\n", " ").replace("\r", "")

def xml_escape(s):
    """Escape XML special characters"""
    if s is None: return ""
    return html.escape(str(s))

def mermaid_safe(s):
    """Make string safe for Mermaid diagrams"""
    if s is None: return ""
    # Replace problematic characters
    return str(s).replace("`", "").replace('"', "'").replace("\n", " ").replace(".", "_")

def render_mermaid(model) -> str:
    """Generate Mermaid ERD"""
    if len(model["entities"]) > MAX_MERMAID_TABLES:
        return "_Mermaid diagram omitted (too many tables for readable rendering)._"
    
    lines = ["```mermaid", "erDiagram"]
    
    # Add entities
    for e in model["entities"]:
        entity_name = mermaid_safe(e["name"])
        lines.append(f"  {entity_name} {{")
        # best-of-both: configurable columns cap
        max_cols = MERMAID_MAX_COLUMNS
        cols = e["columns"] if max_cols is None or max_cols < 0 else e["columns"][:max_cols]
        for c in cols:
            col_type = mermaid_safe(c['type'])
            col_name = mermaid_safe(c['name'])
            lines.append(f"    {col_type} {col_name}")
        if max_cols is not None and max_cols >= 0 and len(e["columns"]) > max_cols:
            lines.append("    ... more_columns")
        lines.append("  }")
    
    # Add relationships (use clear many-side symbol o{)
    for r in model["relationships"]:
        pk_entity = mermaid_safe(r["pk_table"])
        fk_entity = mermaid_safe(r["fk_table"])
        pk_col = mermaid_safe(r["pk_column"])
        fk_col = mermaid_safe(r["fk_column"])
        label = f"{pk_col}_{fk_col}"
        lines.append(f"  {pk_entity} ||--o{{ {fk_entity} : \"{label}\"")
    
    lines.append("```")
    return "\n".join(lines)

