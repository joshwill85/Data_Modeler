def md_escape(s): 
    if s is None: return ""
    return str(s).replace("|","\\|")

def render_mermaid(model) -> str:
    if len(model["entities"]) > MAX_MERMAID_TABLES:
        return "_Mermaid omitted (too many tables for readable diagram)._"
    lines = ["```mermaid","erDiagram"]
    for e in model["entities"]:
        en = e["name"].replace("`","").replace(".","_")
        lines.append(f"{en} {{")
        for c in e["columns"]:
            lines.append(f"  {c['type']} {c['name']}")
        lines.append("}")
    for r in model["relationships"]:
        a = r["pk_table"].replace("`","").replace(".","_")
        b = r["fk_table"].replace("`","").replace(".","_")
        label = f"{r['pk_column']}={r['fk_column']}".replace("`","")
        lines.append(f"{a} ||--o{b} : \"{label}\"")
    lines.append("```")
    return "\n".join(lines)

def render_markdown(model) -> str:
    ns = model["namespace"]
    nsname = ns["database"] or f"{ns['catalog']}.{ns['schema']}"
    lines = []
    lines.append(f"# ERD / Data Model — {nsname}")
    lines.append(f"_Author: {AUTHOR}_  ")
    lines.append(f"_Version: {VERSION}_  ")
    lines.append(f"_Run: {RUN_ID}_  ")
    lines.append(f"_Spark: {model['spark_env']['spark_version']}; TZ: {model['spark_env']['session_timezone']}_\n")

    lines.append("## Entities\n")
    for e in model["entities"]:
        lines.append(f"### {e['name']}")
        tt = e.get("table_type") or ("VIEW" if e.get("is_view") else "TABLE")
        dsf = e.get("data_source_format") or ""
        lines.append(f"- Type: **{tt}**  Data source: **{dsf}**  ")
        lines.append(f"- Rows (approx): **{e.get('row_count','unknown')}**  ")
        if e.get("partial"): lines.append(f"- Note: **Partial metadata** (access limits or load failures)  ")
        lines.append("\n#### Columns")
        lines.append("| Name | Type | Nullable | ~Distinct | Null Ratio | PK? | FK? | Date/Time Format | Complex |")
        lines.append("|---|---|---:|---:|---:|---:|---:|---|---|")
        for c in e["columns"]:
            dt_fmt = c.get("inferred_datetime_format")
            dt_str = f"{dt_fmt} ({c.get('inferred_datetime_support')})" if dt_fmt else ""
            complex_str = "STRUCT" if c.get("struct_fields") else ""
            if c.get("array_guidance"): complex_str = f"ARRAY→{c['array_guidance']['element_type']}"
            if c.get("map_guidance"):   complex_str = f"MAP<{c['map_guidance']['key_type']},{c['map_guidance']['value_type']}>"
            lines.append("| {n} | {t} | {nu} | {ad} | {nr} | {pk} | {fk} | {df} | {cx} |".format(
                n=md_escape(c["name"]),
                t=md_escape(c["type"]),
                nu="Y" if c["nullable"] else "N",
                ad=md_escape(c.get("approx_distinct","")),
                nr=(f"{c.get('null_ratio'):.3f}" if c.get("null_ratio") is not None else ""),
                pk=("Y ("+str(c.get("candidate_pk_score"))+")" if c.get("candidate_pk") else ""),
                fk=("Y ("+str(c.get("candidate_fk_score"))+")" if c.get("candidate_fk") else ""),
                df=md_escape(dt_str),
                cx=md_escape(complex_str)
            ))
        if e.get("examples"):
            lines.append("\n_Example rows (up to 3):_")
            for r in e["examples"]: lines.append(f"- `{r}`")
        lines.append("\n")

    lines.append("## Relationships")
    if model["relationships"]:
        lines.append("| FK Table | FK Column(s) | PK Table | PK Column(s) | Score | Declared? | Evidence (name/type/overlap/card) |")
        lines.append("|---|---|---|---|---:|---:|---|")
        for r in sorted(model["relationships"], key=lambda x: (-x["score"], x["fk_table"], x["pk_table"])):
            ev = r.get("evidence",{})
            evs = f"name:{ev.get('name_match')}, type:{ev.get('type_compat')}, overlap:{ev.get('value_overlap')}, card:{ev.get('cardinality_shape')}"
            lines.append(f"| {md_escape(r['fk_table'])} | {md_escape(r['fk_column'])} | {md_escape(r['pk_table'])} | {md_escape(r['pk_column'])} | {r['score']:.3f} | {str(r.get('declared',False))} | {evs} |")
        lines.append("\n### Join Recipes (examples)")
        for r in model["relationships"][:min(25, len(model['relationships']))]:
            lines.append(f"- **{r['fk_table']}** → **{r['pk_table']}** on `{r['fk_column']}={r['pk_column']}`")
            lines.append(f"  - SQL: `{r['join_example_sql']}`")
            lines.append(f"  - PySpark: `{r['join_example_pyspark']}`")
    else:
        lines.append("_None above threshold._")

    lines.append("\n## How to Parse Complex Types")
    lines.append("- **ARRAY**: `explode()` / `posexplode()`, then select `elem` or `elem.*` (for `STRUCT` elements).")
    lines.append("- **MAP**: `explode(map)` → `(key,value)` rows; `map_keys` / `map_values` to project.")
    lines.append("- **STRUCT**: `col.*` to flatten one level; recurse if nested.")
    lines.append("\n## Date/Time Parsing Guidance")
    lines.append("- STRING with pattern → `to_date`/`to_timestamp` using the inferred pattern.")
    lines.append("- `epoch_seconds` → `to_timestamp(col)`; `epoch_millis` → `to_timestamp(col/1000.0)`.")
    lines.append("- Native DATE/TIMESTAMP → already typed; use `date_format` for display.")

    if EMIT_MERMAID:
        lines.append("\n## ERD (Mermaid)")
        lines.append(render_mermaid(model))

    if warnings:
        lines.append("\n## Warnings")
        for w in warnings: lines.append(f"- {w}")
    if errors:
        lines.append("\n## Errors")
        for e in errors: lines.append(f"- {e}")

    return "\n".join(lines)

