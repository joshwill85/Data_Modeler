def is_candidate_pk(col_meta, row_count):
    """Determine if column is a good PK candidate"""
    if row_count in (None, 0): 
        return (False, 0.0)
    
    s = 0.0
    ad = col_meta.get("approx_distinct")
    if ad is not None and row_count > 0: 
        s += 0.6 * min(1.0, ad / row_count)
    
    nr = col_meta.get("null_ratio")
    if nr is not None: 
        s += 0.2 * (1.0 - nr)
    
    if col_meta.get("is_id_name"): 
        s += 0.2
    
    return (s >= 0.65), round(s, 3)

def is_candidate_fk(col_meta):
    """Determine if column is a good FK candidate"""
    s = 0.0
    
    nr = col_meta.get("null_ratio")
    if nr is not None: 
        s += 0.3 * (1.0 - nr)
    
    if col_meta.get("is_fk_name") or col_meta.get("is_id_name"): 
        s += 0.4
    
    if col_meta.get("family","") in {"integral","decimal","floating","stringy","dates"}: 
        s += 0.3
    
    return (s >= 0.55), round(s, 3)

