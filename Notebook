def fq_identifier(token: str) -> str:
    token = token.strip().strip("`")
    return f"`{token}`"

def fq_table(t: str) -> str:
    parts = [p for p in t.split(".") if p]
    return ".".join(fq_identifier(p) for p in parts)

def is_included(t: str) -> bool:
    name = t.split(".")[-1]
    if EXCLUDE_TABLES_RE:
        try:
            if re.match(EXCLUDE_TABLES_RE, name, flags=re.I):
                return False
        except re.error as e:
            warnings.append(f"Invalid EXCLUDE_TABLES_RE pattern: {e}")
    try:
        return re.match(INCLUDE_TABLES_RE, name, flags=re.I) is not None
    except re.error as e:
        warnings.append(f"Invalid INCLUDE_TABLES_RE pattern: {e}")
        return True

def dtype_family(dt: T.DataType) -> str:
    s = dt.simpleString().lower()
    if s.startswith("array"):  return "array"
    if s.startswith("map"):    return "map"
    if s.startswith("struct"): return "struct"
    if "decimal" in s or "numeric" in s: return "decimal"
    if s in {"byte","short","int","integer","long","bigint"}: return "integral"
    if s in {"double","float"}: return "floating"
    if "string" in s or "char" in s or "varchar" in s: return "stringy"
    if "boolean" in s or "bool" in s: return "boolean"
    if "timestamp" in s or s == "date": return "dates"
    return s

def families_compatible(f1, f2) -> bool:
    if f1 == f2: return True
    if {f1,f2} <= {"integral","decimal","floating"}: return True
    if {f1,f2} <= {"stringy"}: return True
    if {f1,f2} <= {"dates"}: return True
    return False

def safe_table(t: str):
    try:
        return spark.table(t)
    except Exception as e:
        warnings.append(f"Cannot load table {t}: {e}")
        return None

def sample_df(df, max_rows, frac):
    if df is None: return None
    try:
        frac = max(0.0, min(1.0, frac))
        sdf = df.sample(False, frac, seed=42) if frac < 1.0 else df
        return sdf.limit(max_rows)
    except Exception as e:
        warnings.append(f"Sampling failed: {e}")
        return None

def approx_distinct_expr(cname: str):
    return F.approx_count_distinct(F.col(cname)).alias(cname)

