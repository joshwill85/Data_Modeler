def md_escape(value: Any) -> str:
    text = "" if value is None else str(value)
    return text.replace("_", "\\_")


def xml_escape(value: Any) -> str:
    text = "" if value is None else str(value)
    return html.escape(text, quote=True)


def mermaid_safe(value: str) -> str:
    return value.replace(".", "_").replace("`", "")


def render_mermaid(model: Dict[str, Any], config: ModelerConfig) -> str:
    if len(model["entities"]) > config.max_mermaid_tables:
        return (
            "```mermaid\n"
            "erDiagram\n"
            "  %% Mermaid diagram omitted: table count exceeds MAX_MERMAID_TABLES\n"
            "```\n"
        )
    lines = ["```mermaid", "erDiagram"]
    for entity in model["entities"]:
        name = mermaid_safe(entity["name"])
        lines.append(f"  {name} {{")
        for column in entity["columns"][: max(0, config.mermaid_max_columns) or len(entity["columns"])]:
            col_type = column["type"]
            if config.md_truncate_type_chars and config.md_truncate_type_chars > 0:
                col_type = (
                    col_type[: config.md_truncate_type_chars] + "..."
                    if len(col_type) > config.md_truncate_type_chars
                    else col_type
                )
            lines.append(f"    {col_type} {column['name']}")
        lines.append("  }")
    for relation in model["relationships"]:
        fk = mermaid_safe(relation["fk_table"])
        pk = mermaid_safe(relation["pk_table"])
        rel = "||--||" if relation.get("cardinality") == "one-to-one" else "}o--||"
        confidence = relation.get("confidence", "unknown")
        lines.append(
            f"  {fk} {rel} {pk} : \"{relation['fk_column']} → {relation['pk_column']} [{confidence}] ({relation['score']:.2f})\""
        )
    lines.append("```")
    return "\n".join(lines)


def render_markdown(model: Dict[str, Any], config: ModelerConfig) -> str:
    lines: List[str] = []
    lines.append(f"# Universal ERD & Data Model Generator (v{VERSION})")
    lines.append("")
    lines.append(f"- **Run ID:** `{model['run_id']}`")
    namespace = model["namespace"]
    if namespace["type"] == "unity_catalog":
        ns_label = f"{namespace['catalog']}.{namespace['schema']}"
    else:
        ns_label = namespace.get("database") or "unknown"
    lines.append(f"- **Namespace:** `{ns_label}`")
    lines.append(f"- **Tables:** {len(model['entities'])}")
    lines.append(f"- **Relationships:** {len(model['relationships'])}")
    lines.append("")
    lines.append("## Table Inventory")
    for entity in model["entities"]:
        lines.append(f"### {entity['name']}")
        lines.append(f"- Rows: `{entity.get('row_count')}`")
        lines.append(f"- Type: `{entity.get('table_type') or ('VIEW' if entity.get('is_view') else 'TABLE')}`")
        lines.append(f"- Source: `{entity.get('data_source_format') or 'unknown'}`")
        lines.append("")
        lines.append("| Column | Type | Nullable | Approx Distinct | Null Ratio | PK (score/conf) | FK (score/conf) |")
        lines.append("| --- | --- | --- | --- | --- | --- | --- |")
        for column in entity["columns"]:
            col_type = column["type"]
            if (
                config.md_truncate_type_chars
                and config.md_truncate_type_chars > 0
                and len(col_type) > config.md_truncate_type_chars
            ):
                col_type = col_type[: config.md_truncate_type_chars] + "..."
            pk_score = column.get("candidate_pk_score")
            pk_conf = column.get("pk_confidence")
            pk_flag = column.get("candidate_pk")
            pk_display = "Yes" if pk_flag else "No"
            if pk_score is not None:
                pk_display += f" ({pk_score:.2f})"
            if pk_conf:
                pk_display += f" [{pk_conf}]"
            fk_score = column.get("candidate_fk_score")
            fk_conf = column.get("fk_confidence")
            fk_flag = column.get("candidate_fk")
            fk_display = "Yes" if fk_flag else "No"
            if fk_score is not None:
                fk_display += f" ({fk_score:.2f})"
            if fk_conf:
                fk_display += f" [{fk_conf}]"
            lines.append(
                f"| `{column['name']}` | `{col_type}` | `{column['nullable']}` | `{column.get('approx_distinct')}` | "
                f"`{column.get('null_ratio')}` | `{pk_display}` | `{fk_display}` |"
            )
        lines.append("")
    lines.append("## Relationships")
    if model["relationships"]:
        for relation in model["relationships"]:
            lines.append(
                f"- **{relation['fk_table']}**.`{relation['fk_column']}` → **{relation['pk_table']}**.`{relation['pk_column']}` "
                f"(score={relation['score']}, declared={relation.get('declared', False)}, confidence={relation.get('confidence', 'unknown')})"
            )
    else:
        lines.append("_No relationships found above the threshold._")
    lines.append("")
    lines.append("## Complex Type Guidance")
    lines.append("- ARRAY → `explode()` / `posexplode()` then project `elem` or `elem.*`")
    lines.append("- MAP   → `explode(map_col)` for `(key, value)` pairs; `map_keys` / `map_values` helpers")
    lines.append("- STRUCT → `col.*` to expand one level; recurse for nested struct fields")
    lines.append("")
    if config.emit_mermaid:
        lines.append("## Entity Relationship Diagram")
        lines.append(render_mermaid(model, config))
        lines.append("")
    if model["warnings"]:
        lines.append("## ⚠️ Warnings")
        for warning in model["warnings"][:50]:
            lines.append(f"- {md_escape(warning)}")
        if len(model["warnings"]) > 50:
            lines.append(f"- ... and {len(model['warnings']) - 50} more warnings")
        lines.append("")
    if model["errors"]:
        lines.append("## ❌ Errors")
        for error in model["errors"]:
            lines.append(f"- {md_escape(error)}")
        lines.append("")
    return "\n".join(lines)


def render_html(model: Dict[str, Any], config: ModelerConfig) -> str:
    confidence_colors = {
        "high": "#2E7D32",
        "medium": "#F9A825",
        "low": "#C62828",
    }

    nodes_payload: List[Dict[str, Any]] = []
    max_cols = config.html_max_columns
    for entity in model["entities"]:
        columns_rendered: List[str] = []
        for idx, column in enumerate(entity.get("columns", [])):
            if max_cols != -1 and idx >= max_cols:
                columns_rendered.append(f"… {len(entity['columns']) - max_cols} more")
                break
            col_name = html.escape(column["name"])
            col_type = html.escape(column["type"])
            pk_flag = "high" if column.get("pk_confidence") == "high" else column.get("pk_confidence")
            fk_flag = column.get("fk_confidence")
            badges: List[str] = []
            if pk_flag and pk_flag != "low":
                badges.append(f"<span class=\"badge pk {pk_flag}\">PK {pk_flag}</span>")
            if fk_flag and fk_flag != "low":
                badges.append(f"<span class=\"badge fk {fk_flag}\">FK {fk_flag}</span>")
            badge_html = "" if not badges else " " + "".join(badges)
            columns_rendered.append(f"{col_name} <span class=\"col-type\">({col_type})</span>{badge_html}")

        label_html = "<b>{}</b>".format(html.escape(entity["name"]))
        if columns_rendered:
            label_html += "<br/>" + "<br/>".join(columns_rendered)

        tooltip = [f"Rows: {entity.get('row_count')}"]
        tooltip.append(
            f"Type: {entity.get('table_type') or ('VIEW' if entity.get('is_view') else 'TABLE')}"
        )
        nodes_payload.append(
            {
                "id": entity["name"],
                "label": label_html,
                "title": html.escape("\n".join(filter(None, tooltip))),
            }
        )

    edges_payload: List[Dict[str, Any]] = []
    for rel in model["relationships"]:
        confidence = rel.get("confidence", "medium")
        color = confidence_colors.get(confidence, "#546E7A")
        label = f"{rel['fk_column']} → {rel['pk_column']}"
