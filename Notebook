def _status_for(name_substring):
    matched = [r for r in test_summary_rows if name_substring.lower() in (r.get("test_name") or "").lower()]
    if not matched:
        return "NOT_RUN"
    # Prefer PASS over NO_ROWS over ERROR over SKIPPED
