# ------------------------------------------------------------
# 2) Build table lineage version history + current direct edges
# ------------------------------------------------------------
# Latest target write event wins for CURRENT STATE.
# Important:
# - We choose the latest event per TARGET TABLE, not per edge.
# - That avoids mixing older notebook/job sources with the newest writer.
# - Table-level versions include target-only writes too, so a latest write with
#   no source rows correctly clears current upstream lineage.

table_target_events = (
    table_history_df
    .filter(F.col("target_table_full_name").isNotNull())
    .select(
        "target_table_full_name",
        "target_table_catalog",
        "target_table_schema",
        "target_table_name",
        "event_id",
        "event_time",
        "event_date",
        "entity_type",
        "entity_id",
        "entity_run_id",
        "created_by",
    )
    .dropDuplicates(["target_table_full_name", "event_id"])
)

table_event_source_counts = (
    table_history_df
    .filter(
        F.col("target_table_full_name").isNotNull() &
        F.col("source_table_full_name").isNotNull()
    )
    .groupBy("target_table_full_name", "event_id")
    .agg(F.count("*").alias("source_edge_count"))
)

table_versions_asc_w  = W.partitionBy("target_table_full_name").orderBy(F.col("event_time").asc(), F.col("event_id").asc())
table_versions_desc_w = W.partitionBy("target_table_full_name").orderBy(F.col("event_time").desc(), F.col("event_id").desc())

table_versions_df = (
    table_target_events
    .join(table_event_source_counts, ["target_table_full_name", "event_id"], "left")
    .fillna({"source_edge_count": 0})
    .withColumn("valid_from_ts", F.col("event_time"))
    .withColumn("valid_to_ts", F.lead("event_time").over(table_versions_asc_w))
    .withColumn("version_rank_desc", F.row_number().over(table_versions_desc_w))
    .withColumn("is_current", F.col("version_rank_desc") == 1)
    .drop("version_rank_desc")
)

overwrite_delta(
    table_versions_df,
    TABLE_VERSIONS_TARGET,
    cluster_cols=["target_table_schema", "target_table_name", "is_current"],
)

table_current_versions_df = (
    table_versions_df
    .filter(F.col("is_current"))
    .select(
        F.col("target_table_full_name").alias("version_target_table_full_name"),
        F.col("event_id").alias("version_event_id"),
        F.col("event_time").alias("version_event_time"),
        F.col("valid_from_ts").alias("version_valid_from_ts"),
        F.col("valid_to_ts").alias("version_valid_to_ts"),
        F.col("is_current").alias("version_is_current"),
        F.col("source_edge_count").alias("version_source_edge_count"),
        F.col("created_by").alias("version_created_by"),
        F.col("entity_type").alias("version_entity_type"),
        F.col("entity_id").alias("version_entity_id"),
        F.col("entity_run_id").alias("version_entity_run_id"),
    )
)

table_current_edges_df = (
    table_history_df.alias("h")
    .join(
        table_current_versions_df.alias("v"),
        (F.col("h.target_table_full_name") == F.col("v.version_target_table_full_name")) &
        (F.col("h.event_id") == F.col("v.version_event_id")),
        "inner"
    )
    .filter(F.col("h.source_table_full_name").isNotNull())
    .select(
        F.col("h.source_table_full_name"),
        F.col("h.source_table_catalog"),
        F.col("h.source_table_schema"),
        F.col("h.source_table_name"),
        F.col("h.source_type"),

        F.col("h.target_table_full_name"),
        F.col("h.target_table_catalog"),
        F.col("h.target_table_schema"),
        F.col("h.target_table_name"),
        F.col("h.target_type"),

        F.col("v.version_event_id"),
        F.col("v.version_event_time"),
        F.col("v.version_valid_from_ts"),
        F.col("v.version_valid_to_ts"),
        F.col("v.version_is_current"),
        F.col("v.version_source_edge_count"),
        F.col("v.version_created_by"),
        F.col("v.version_entity_type"),
        F.col("v.version_entity_id"),
        F.col("v.version_entity_run_id"),
    )
    .dropDuplicates(["source_table_full_name", "target_table_full_name", "version_event_id"])
    .cache()
)

_ = table_current_edges_df.count()

overwrite_delta(
    table_current_edges_df,
    TABLE_CURRENT_EDGES_TARGET,
    cluster_cols=["target_table_schema", "target_table_name", "source_table_schema", "source_table_name"],
