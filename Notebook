def get_row_count_fast(t: str, df) -> Optional[int]:
    try:
        d = spark.sql(f"DESCRIBE DETAIL {fq_table(t)}").select("numRows").first()
        if d and d[0] is not None:
            return int(d[0])
    except Exception:
        pass
    if not FAST_MODE:
        try: return df.count()
        except Exception: pass
    return None

