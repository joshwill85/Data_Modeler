def _bootstrap_widgets(dbutils: Any) -> bool:
    """Create Databricks widgets when running in the notebook UI."""
    if dbutils is None:
        return False
    created = False
    for spec in WIDGET_SPECS:
        try:
            dbutils.widgets.text(spec.name, spec.default, spec.description)
            created = True
        except Exception:
            # Widget likely already exists; ignore.
            continue
    return created


def _clean_string(value: Any) -> Optional[str]:
    if value is None:
        return None
    s = str(value).strip()
    if not s or (s.startswith("{{") and s.endswith("}}")):
        return None
    return s


def _as_bool(value: Any, default: bool = False) -> bool:
    s = _clean_string(value)
    if s is None:
        return default
    return s.lower() in {"1", "true", "t", "yes", "y", "on"}


def _as_int(value: Any, default: int) -> int:
    s = _clean_string(value)
    if s is None:
        return default
    try:
        return int(float(s))
    except Exception:
        return default


def _as_float(value: Any, default: float) -> float:
    s = _clean_string(value)
    if s is None:
        return default
    try:
        return float(s)
    except Exception:
        return default


