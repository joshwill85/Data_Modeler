def ns_tables_uc(catalog: str, schema: str) -> List[str]:
    """Discover tables in Unity Catalog"""
    try:
        query = f"SHOW TABLES IN {fq_identifier(catalog)}.{fq_identifier(schema)}"
        df = spark.sql(query)
        rows = df.select("tableName").limit(MAX_TABLES + 1).collect()  # +1 to detect overflow
        
        if len(rows) > MAX_TABLES:
            warnings.append(f"Table count exceeds MAX_TABLES ({MAX_TABLES}); results truncated.")
            rows = rows[:MAX_TABLES]
        
        return [f"{catalog}.{schema}.{r.tableName}" for r in rows]
    except AnalysisException as e:
        errors.append(f"SHOW TABLES failed for {catalog}.{schema}: {e.desc if hasattr(e, 'desc') else str(e)}")
        return []
    except Exception as e:
