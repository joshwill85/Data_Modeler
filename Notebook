# Composite PK discovery (NULL-safe hashing; best-of-both)
def best_composite_pk(df, cols_meta, row_count, top_n=6, max_k=3):
    """Find best composite PK using sampling"""
    if df is None or not cols_meta or row_count in (None, 0):
        return None, 0.0
    
    # Sort by PK score and take top N
    cols_meta = sorted(cols_meta, key=lambda c: c.get("candidate_pk_score", 0), reverse=True)[:top_n]
    names = [c["name"] for c in cols_meta]
    
    if len(names) < 2: 
        return None, 0.0
    
    # Sample data for testing
    sdf = sample_df(
        df.select(*[F.col(n) for n in names]), 
        200_000, 
        0.2 if not FAST_MODE else 0.05
    )
    
    if sdf is None: 
        return None, 0.0
    
    best, best_score = None, 0.0
    
    for k in range(2, min(max_k + 1, len(names) + 1)):
        for combo in itertools.combinations(names, k):
            try:
                # Count distinct combinations using NULL-safe hash
                ad = sdf.select(
                    F.approx_count_distinct(
                        F.sha2(
                            F.concat_ws("||", *[F.coalesce(F.col(x).cast("string"), F.lit("NULL")) for x in combo]), 
                            256
                        )
                    )
                ).first()[0]
                
                if ad is None or ad == 0:
                    continue
                
                # Score based on distinctness and individual column scores
                distinct_ratio = ad / max(1, row_count)
                avg_col_score = sum(
                    next(cm for cm in cols_meta if cm["name"] == x)["candidate_pk_score"] 
                    for x in combo
                ) / k
                
                score = 0.75 * distinct_ratio + 0.25 * avg_col_score
                
                if score > best_score:
                    best, best_score = combo, score
            except Exception as e:
                warnings.append(f"Composite PK test failed for {combo}: {e}")
                continue
    
    return best, round(float(best_score), 3)

# Build PK registry
