        "event_time",
        "event_date",
        "entity_type",
        "entity_id",
        "entity_run_id",
        "created_by",
    )
    .dropDuplicates(["target_table_full_name", "target_column_name", "event_id"])
)

column_event_source_counts = (
    column_history_df
    .filter(
        F.col("target_table_full_name").isNotNull() &
        F.col("target_column_name").isNotNull() &
        F.col("source_table_full_name").isNotNull() &
        F.col("source_column_name").isNotNull()
    )
    .groupBy("target_table_full_name", "target_column_name", "event_id")
    .agg(F.count("*").alias("source_edge_count"))
)

column_versions_asc_w = (
    W.partitionBy("target_table_full_name", "target_column_name")
     .orderBy(F.col("event_time").asc(), F.col("event_id").asc())
)
column_versions_desc_w = (
    W.partitionBy("target_table_full_name", "target_column_name")
     .orderBy(F.col("event_time").desc(), F.col("event_id").desc())
)

column_versions_df = (
    column_target_events
    .join(column_event_source_counts, ["target_table_full_name", "target_column_name", "event_id"], "left")
    .fillna({"source_edge_count": 0})
    .withColumn("valid_from_ts", F.col("event_time"))
    .withColumn("valid_to_ts", F.lead("event_time").over(column_versions_asc_w))
    .withColumn("version_rank_desc", F.row_number().over(column_versions_desc_w))
    .withColumn("is_current", F.col("version_rank_desc") == 1)
    .drop("version_rank_desc")
    .join(table_current_write_times_df, ["target_table_full_name"], "left")
    .withColumn(
        "possible_staleness_due_to_later_table_write",
        F.when(
            F.col("table_current_write_ts").isNotNull() &
            (F.col("table_current_write_ts") > F.col("event_time")),
            F.lit(True)
        ).otherwise(F.lit(False))
    )
)

overwrite_delta(
    column_versions_df,
    COLUMN_VERSIONS_TARGET,
    cluster_cols=["target_table_schema", "target_table_name", "target_column_name", "is_current"],
)

column_current_versions_df = (
    column_versions_df
    .filter(F.col("is_current"))
    .select(
        F.col("target_table_full_name").alias("version_target_table_full_name"),
        F.col("target_column_name").alias("version_target_column_name"),
        F.col("event_id").alias("version_event_id"),
        F.col("event_time").alias("version_event_time"),
        F.col("valid_from_ts").alias("version_valid_from_ts"),
        F.col("valid_to_ts").alias("version_valid_to_ts"),
        F.col("is_current").alias("version_is_current"),
        F.col("source_edge_count").alias("version_source_edge_count"),
        F.col("possible_staleness_due_to_later_table_write"),
        F.col("created_by").alias("version_created_by"),
        F.col("entity_type").alias("version_entity_type"),
        F.col("entity_id").alias("version_entity_id"),
        F.col("entity_run_id").alias("version_entity_run_id"),
    )
)

column_current_edges_df = (
    column_history_df.alias("h")
    .join(
        column_current_versions_df.alias("v"),
        (F.col("h.target_table_full_name") == F.col("v.version_target_table_full_name")) &
        (F.col("h.target_column_name") == F.col("v.version_target_column_name")) &
        (F.col("h.event_id") == F.col("v.version_event_id")),
        "inner"
    )
    .filter(
        F.col("h.source_table_full_name").isNotNull() &
        F.col("h.source_column_name").isNotNull()
    )
    .select(
        F.col("h.source_table_full_name"),
        F.col("h.source_table_catalog"),
        F.col("h.source_table_schema"),
        F.col("h.source_table_name"),
        F.col("h.source_type"),
        F.col("h.source_column_name"),

        F.col("h.target_table_full_name"),
