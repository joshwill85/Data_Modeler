SELECT
  COUNT(DISTINCT source_table_full_name) AS cumulative_direct_parents,
  COLLECT_SET(source_table_full_name) AS cumulative_parent_list
FROM information_schema.table_lineage
WHERE target_table_full_name = '<ROOT_TABLE>'
  AND source_table_full_name IS NOT NULL
  AND target_table_full_name IS NOT NULL
  AND event_time <= TIMESTAMP('<ROOT_EVENT_TIME>');
