def _safe_write_text(path, txt):
    try:
        with open(path, "w", encoding="utf-8") as f: f.write(txt)
        return True
    except Exception as e:
        warnings.append(f"Write failed: {path}: {e}")
        return False

def _safe_write_csv(path, rows, header):
    try:
        with open(path, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(header)
            for r in rows: w.writerow(r)
        return True
    except Exception as e:
        warnings.append(f"CSV write failed: {path}: {e}")
        return False

