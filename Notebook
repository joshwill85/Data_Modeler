    def sanitize(self) -> Tuple[List[str], List[str]]:
        warnings: List[str] = []
        errors: List[str] = []

        if self.max_composite_k < 1 or self.max_composite_k > 4:
            warnings.append(
                f"MAX_COMPOSITE_K={self.max_composite_k} adjusted to range [1..4]."
            )
            self.max_composite_k = max(1, min(4, self.max_composite_k))

        if self.row_sample_fraction < 0.0 or self.row_sample_fraction > 1.0:
            warnings.append(
                f"ROW_SAMPLE_FRACTION={self.row_sample_fraction} adjusted to [0..1]."
            )
            self.row_sample_fraction = max(0.0, min(1.0, self.row_sample_fraction))

        if self.min_rel_score < 0.0 or self.min_rel_score > 1.0:
            warnings.append(
                f"MIN_REL_SCORE={self.min_rel_score} adjusted to [0..1]."
            )
            self.min_rel_score = max(0.0, min(1.0, self.min_rel_score))

        if self.datetime_support_min < 0.0 or self.datetime_support_min > 1.0:
            warnings.append(
                f"DATETIME_SUPPORT_MIN={self.datetime_support_min} adjusted to [0..1]."
            )
            self.datetime_support_min = max(0.0, min(1.0, self.datetime_support_min))

        if self.fast_mode:
            if self.enable_value_overlap:
                warnings.append(
                    "ENABLE_VALUE_OVERLAP disabled because FAST_MODE=true."
                )
                self.enable_value_overlap = False
            if self.enable_composite_fk:
                warnings.append(
                    "ENABLE_COMPOSITE_FK_INFERENCE disabled because FAST_MODE=true."
                )
                self.enable_composite_fk = False
            if self.enable_advanced_key_tests:
                warnings.append(
                    "ENABLE_ADVANCED_KEY_TESTS disabled because FAST_MODE=true."
                )
                self.enable_advanced_key_tests = False

        if self.pk_sample_rows < 1000:
            warnings.append(
                f"PK_SAMPLE_ROWS={self.pk_sample_rows} increased to 1000 for stability."
            )
            self.pk_sample_rows = 1000

        if self.html_max_columns < -1:
            warnings.append("HTML_MAX_COLUMNS raised to -1 (unlimited) minimum.")
            self.html_max_columns = -1

        for attr_name in ("pk_accept_threshold", "pk_high_confidence", "relationship_high_confidence"):
            value = getattr(self, attr_name)
            if value < 0.0 or value > 1.0:
                warnings.append(f"{attr_name.upper()}={value} adjusted to [0..1].")
                setattr(self, attr_name, max(0.0, min(1.0, value)))

        if self.pk_high_confidence < self.pk_accept_threshold:
            warnings.append(
                "PK_HIGH_CONFIDENCE raised to match PK_ACCEPT_THRESHOLD."
            )
            self.pk_high_confidence = self.pk_accept_threshold

        if self.relationship_high_confidence < self.min_rel_score:
            warnings.append(
                "RELATIONSHIP_HIGH_CONFIDENCE raised to match MIN_REL_SCORE."
            )
            self.relationship_high_confidence = self.min_rel_score

        if self.use_legacy_database:
            warnings.append(
                "Legacy database mode active; Unity Catalog catalog/schema values are ignored."
            )
        else:
            if not self.catalog or not self.schema:
                errors.append(
                    "Unity Catalog mode requires both catalog and schema to be specified."
                )

        if self.write_files and not (
            (self.use_uc_volume_output and self.uc_volume_path)
            or (self.output_base and len(self.output_base.strip()) > 0)
        ):
            warnings.append(
                "WRITE_FILES=true but no UC_VOLUME_PATH or OUTPUT_BASE provided; writes will be skipped."
            )
            self.write_files = False

        if self.value_overlap_max_distinct < 1000:
            warnings.append(
                f"VALUE_OVERLAP_MAX_DISTINCT={self.value_overlap_max_distinct} too low; raised to 1000."
            )
            self.value_overlap_max_distinct = 1000

        return warnings, errors

    def resolve_output_dir(self, run_id: str) -> Optional[str]:
        if not self.write_files:
            return None
        base = None
        if self.use_uc_volume_output and self.uc_volume_path:
            base = self.uc_volume_path
        elif self.output_base:
            base = self.output_base
        if base:
            return f"{base.rstrip('/')}/{run_id}"
        return None


