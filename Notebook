def run_test_with_diagnostics(test_name, category, precision, prerequisites, main_sql, notes, diagnostics=None):
    missing = [t for t in prerequisites if not ACCESS.get(t, False)]
    if missing:
        result = {
            "status": "SKIPPED",
            "rows": None,
            "error_type": "MISSING_PREREQUISITE",
            "error": f"Missing or inaccessible prerequisite tables: {missing}"
        }
        print(f"\n===== {test_name} =====")
        print(result["error"])
        add_test_result(test_name, category, precision, prerequisites, result, notes)
        return result

    result = run_sql(test_name, main_sql, top_n=TOP_N)
    add_test_result(test_name, category, precision, prerequisites, result, notes)

    if (result["status"] in ("NO_ROWS", "ERROR")) and diagnostics:
        for diag_name, diag_sql in diagnostics:
            run_sql(f"{test_name} :: diagnostic :: {diag_name}", diag_sql, top_n=TOP_N)

    return result

