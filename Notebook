        F.concat_ws("|", F.col("h.source_table_full_name"), F.col("h.source_column_name")).alias("source_node_key"),
        F.concat_ws("|", F.col("h.target_table_full_name"), F.col("h.target_column_name")).alias("target_node_key"),

        F.col("v.version_event_id"),
        F.col("v.version_event_time"),
        F.col("v.version_valid_from_ts"),
        F.col("v.version_valid_to_ts"),
        F.col("v.version_is_current"),
        F.col("v.version_source_edge_count"),
        F.col("v.possible_staleness_due_to_later_table_write"),
        F.col("v.version_created_by"),
        F.col("v.version_entity_type"),
        F.col("v.version_entity_id"),
        F.col("v.version_entity_run_id"),
    )
    .dropDuplicates(["source_node_key", "target_node_key", "version_event_id"])
