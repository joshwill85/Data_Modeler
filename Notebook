def _safe_set_session_timezone():
    tz = (SESSION_TIMEZONE_CFG or "UTC").strip()
    try:
        current = None
        try:
            current = spark.conf.get("spark.sql.session.timeZone")
        except Exception:
            pass
        if not current or str(current).strip().lower() in {"", "unknown", "null", "na"}:
            spark.conf.set("spark.sql.session.timeZone", tz)
            return tz
        return current
    except Exception as e:
        warnings.append(f"Could not set spark.sql.session.timeZone; using 'UTC' in metadata only: {e}")
        return "UTC"

