                        ratio = abs(fk_ad - pk_ad) / pk_ad
                        if ratio < 0.05:  # Within 5%
                            card = "one-to-one"
                except Exception:
                    pass
                
                relationships.append({
                    "fk_table": fk_table,
                    "fk_column": fk_name,
                    "pk_table": pk_table,
                    "pk_column": best_name,
                    "score": round(best_score, 3),
                    "evidence": best_ev,
                    "cardinality": card,
                    "declared": False,
                    "join_example_sql": f"SELECT * FROM {fq_table(fk_table)} f JOIN {fq_table(pk_table)} p ON f.`{fk_name}` = p.`{best_name}`",
                    "join_example_pyspark": f"fk.join(pk, F.col('f.`{fk_name}`') == F.col('p.`{best_name}`'), 'left')"
                })

# Optional composite FK inference
if ENABLE_COMPOSITE_FK_INFERENCE:
    for pk_table, pk_cols in pk_registry.items():
        if len(pk_cols) < 2: 
            continue
        
        for fk_table, fk_meta in entities.items():
            if fk_table == pk_table: 
                continue
            
            # Check if FK table has all PK columns (by name similarity)
            fk_names = [c["name"] for c in fk_meta["columns"]]
            
            # Naive name-based subset check
            if all(
                any(
                    fn.lower() == pc.lower() or fn.lower().endswith("_" + pc.lower()) 
                    for fn in fk_names
                ) 
                for pc in pk_cols
            ):
                # Optional overlap check
                passes_overlap = True
                
                if ENABLE_VALUE_OVERLAP:
                    try:
                        df_fk = safe_table(fk_table)
                        df_pk = safe_table(pk_table)
                        
                        if df_fk is not None and df_pk is not None:
                            fk_sdf = sample_df(
                                df_fk.select(*[F.col(c).cast("string") for c in pk_cols]), 
                                VALUE_OVERLAP_SAMPLE_ROWS, 
                                min(1.0, ROW_SAMPLE_FRACTION)
                            )
                            pk_sdf = sample_df(
                                df_pk.select(*[F.col(c).cast("string") for c in pk_cols]), 
                                VALUE_OVERLAP_SAMPLE_ROWS, 
                                min(1.0, ROW_SAMPLE_FRACTION)
                            )
                            
                            if fk_sdf is not None and pk_sdf is not None:
                                # Hash combinations
                                fk_hash = {
                                    r[0] for r in fk_sdf.select(
                                        F.sha2(
                                            F.concat_ws("||", *[F.coalesce(F.col(c), F.lit("NULL")) for c in pk_cols]), 
                                            256
                                        )
                                    ).distinct().limit(200000).collect()
                                }
                                pk_hash = {
                                    r[0] for r in pk_sdf.select(
                                        F.sha2(
                                            F.concat_ws("||", *[F.coalesce(F.col(c), F.lit("NULL")) for c in pk_cols]), 
                                            256
                                        )
                                    ).distinct().limit(200000).collect()
                                }
                                
                                if fk_hash:
                                    overlap = len(fk_hash & pk_hash) / max(1, len(fk_hash))
                                    passes_overlap = overlap >= 0.5
                    except Exception as e:
                        warnings.append(f"Composite FK overlap failed {fk_table}->{pk_table}: {e}")
                
                if passes_overlap:
                    # Generate join conditions
                    conditions = [f"f.`{c}` = p.`{c}`" for c in pk_cols]
                    join_sql = f"SELECT * FROM {fq_table(fk_table)} f JOIN {fq_table(pk_table)} p ON " + " AND ".join(conditions)
                    join_pyspark = "fk.join(pk, " + " & ".join([f"(F.col('f.`{c}`') == F.col('p.`{c}`'))" for c in pk_cols]) + ", 'left')"
                    
                    relationships.append({
                        "fk_table": fk_table,
                        "fk_column": " + ".join(pk_cols),
                        "pk_table": pk_table,
                        "pk_column": " + ".join(pk_cols),
                        "score": 0.85 if ENABLE_VALUE_OVERLAP else 0.70,
                        "evidence": {
                            "composite_match_on_names": True, 
                            "overlap_checked": ENABLE_VALUE_OVERLAP
                        },
                        "cardinality": "many-to-one",
                        "declared": False,
                        "join_example_sql": join_sql,
                        "join_example_pyspark": join_pyspark
                    })

