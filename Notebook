class ReverseERD:
    def __init__(self, spark: SparkSession, catalog: str, schema: str, out_root_dbfs: str) -> None:
        self.spark = spark
        self.catalog = catalog
        self.schema = schema
        self.out_root_dbfs = out_root_dbfs.rstrip("/")
        self.run_id = run_id()
        self.start_ts = time.time()

        # runtime caches
        self.tables: List[str] = []
        self.entities: Dict[str, Dict[str, Any]] = {}
        self.declared: Dict[str, Any] = {"pk": {}, "fk": [], "checks": []}
        self.relationships: List[Dict[str, Any]] = []
        self.view_edges: List[Dict[str, Any]] = []
        self.warnings: List[str] = []
        self.errors: List[str] = []

        # environment snapshot
        self.spark_env = {
            "spark_version": self.spark.version,
            "session_timezone": safe_conf_get(self.spark, "spark.sql.session.timeZone"),
            "ansi": safe_conf_get_bool(self.spark, "spark.sql.ansi.enabled"),
        }

        # prepare paths
        self.out_dir_dbfs = f"{self.out_root_dbfs}/{self.run_id}"
        self.out_dir_local = dbfs_to_local(self.out_dir_dbfs)
        os.makedirs(self.out_dir_local, exist_ok=True)

    # ---------- Discovery ----------
    def discover_tables(self) -> None:
        try:
            df = self.spark.sql(
                f"SHOW TABLES IN {fq_identifier(self.catalog)}.{fq_identifier(self.schema)}"
            )
            names = [r.tableName for r in df.select("tableName").limit(MAX_TABLES+1).collect()]
            if len(names) > MAX_TABLES:
                names = names[:MAX_TABLES]
                self.warnings.append(f"Table count exceeded MAX_TABLES={MAX_TABLES}; truncated.")
            self.tables = [f"{self.catalog}.{self.schema}.{n}" for n in names]
            if not self.tables:
                self.errors.append("No tables found in namespace.")
        except Exception as exc:
            self.errors.append(f"SHOW TABLES failed: {exc}")
            self.tables = []

    def fetch_information_schema(self) -> None:
        if not self.tables: return
        cat, sch = self.catalog, self.schema
        # Tables overview
        try:
            is_tables = self.spark.sql(
                f"""
                SELECT table_name, table_type, data_source_format
                FROM {fq_identifier(cat)}.information_schema.tables
                WHERE table_schema = '{sch}'
                """
            )
            table_map = {f"{cat}.{sch}.{r.table_name}": (r.table_type, r.data_source_format)
                         for r in is_tables.collect()}
        except Exception as exc:
            self.warnings.append(f"information_schema.tables not accessible: {exc}")
            table_map = {}

        # Declared constraints (PK/FK/CHECK) if present
        try:
            is_tc = self.spark.sql(
                f"""
                SELECT constraint_name, table_name, constraint_type
                FROM {fq_identifier(cat)}.information_schema.table_constraints
                WHERE table_schema = '{sch}'
                """
            )
            is_kcu = self.spark.sql(
                f"""
                SELECT constraint_name, table_name, column_name, ordinal_position
                FROM {fq_identifier(cat)}.information_schema.key_column_usage
                WHERE table_schema = '{sch}'
                """
            )
            is_rc = self.spark.sql(
                f"""
                SELECT constraint_name, unique_constraint_name
                FROM {fq_identifier(cat)}.information_schema.referential_constraints
                WHERE constraint_schema = '{sch}'
                """
            )
            pk_names = [r.constraint_name for r in is_tc.filter("constraint_type='PRIMARY KEY'").select("constraint_name").distinct().collect()]
            for pk in pk_names:
                cols = [r.column_name for r in is_kcu.filter(F.col("constraint_name")==pk).orderBy("ordinal_position").collect()]
                tbl_row = is_kcu.filter(F.col("constraint_name")==pk).select("table_name").first()
                if tbl_row and cols:
                    t = f"{cat}.{sch}.{tbl_row.table_name}"
                    self.declared["pk"][t] = cols

            fk_rows = is_tc.filter("constraint_type='FOREIGN KEY'").select("constraint_name","table_name").collect()
            for r in fk_rows:
                fk_name, fk_tbl = r.constraint_name, f"{cat}.{sch}.{r.table_name}"
                fk_cols = [x.column_name for x in is_kcu.filter(F.col("constraint_name")==fk_name).orderBy("ordinal_position").collect()]
                ref = is_rc.filter(F.col("constraint_name")==fk_name).select("unique_constraint_name").first()
                if ref:
                    pk_name = ref.unique_constraint_name
                    pk_tbl_row = is_kcu.filter(F.col("constraint_name")==pk_name).select("table_name").first()
                    pk_cols = [x.column_name for x in is_kcu.filter(F.col("constraint_name")==pk_name).orderBy("ordinal_position").collect()]
                    if pk_tbl_row and fk_cols and pk_cols:
                        pk_tbl = f"{cat}.{sch}.{pk_tbl_row.table_name}"
                        self.declared["fk"].append({
                            "fk_table": fk_tbl, "fk_cols": fk_cols,
                            "pk_table": pk_tbl, "pk_cols": pk_cols,
                            "name": fk_name
                        })
        except Exception as exc:
            self.warnings.append(f"information_schema constraint discovery limited: {exc}")

        # View → base table edges (outside PK/FK; like lineage)
        try:
            view_usage = self.spark.sql(
                f"""
                SELECT view_name, table_name
                FROM {fq_identifier(cat)}.information_schema.view_table_usage
                WHERE view_schema = '{sch}'
                """
            )
            for r in view_usage.collect():
                self.view_edges.append({
                    "view": f"{cat}.{sch}.{r.view_name}",
                    "table": f"{cat}.{sch}.{r.table_name}"
                })
        except Exception as exc:
            self.warnings.append(f"information_schema.view_table_usage not accessible: {exc}")

        # Initialize entity shells
        for t in self.tables:
            tt, fmt = table_map.get(t, (None, None))
            self.entities[t] = {
                "table": t,
                "row_count": None,
                "table_type": tt,
                "data_source_format": fmt,
                "columns": [],
                "is_view": (tt == "VIEW")
            }

    # ---------- Metadata / Stats ----------
    def describe_table(self, table: str) -> Optional[DataFrame]:
        try:
            return self.spark.table(table)
        except Exception as exc:
            self.warnings.append(f"Cannot read table {table}: {exc}")
            return None

    def get_num_rows(self, table: str) -> Optional[int]:
        try:
            r = self.spark.sql(f"DESCRIBE DETAIL {fq_table_name(table.split('.'))}").select("numRows").first()
            if r and r[0] is not None: return int(r[0])
        except Exception:
            pass
        # Last resort (can be heavy for huge tables; skipped by default)
        return None

    def compute_table_stats(self) -> None:
        for t, meta in self.entities.items():
            df = self.describe_table(t)
            meta["row_count"] = self.get_num_rows(t)
            if df is None:
                continue
            cols: List[Dict[str, Any]] = []
            for f in df.schema.fields:
                fam = dtype_family(f.dataType)
                cols.append({
                    "name": f.name,
                    "type": f.dataType.simpleString(),
                    "family": fam,
                    "nullable": f.nullable,
                })

            # null ratio (bounded sample)
            nr: Dict[str, Optional[float]] = {}
            try:
                sdf = df.sample(False, ROW_SAMPLE_FRACTION, seed=42) if ROW_SAMPLE_FRACTION < 1.0 else df
                sdf = sdf.limit(NULL_SAMPLE_ROWS)
                exprs = [F.avg(F.when(F.col(c["name"]).isNull(), 1).otherwise(0)).alias(c["name"]) for c in cols]
                row = sdf.select(*exprs).first()
                if row: nr = {k: (float(v) if v is not None else None) for k, v in row.asDict().items()}
            except Exception as exc:
                self.warnings.append(f"Null ratio failed for {t}: {exc}")

            # approx distinct via sampled rows (bounded)
            ad: Dict[str, Optional[int]] = {}
            try:
                sdf = df.sample(False, ROW_SAMPLE_FRACTION, seed=7) if ROW_SAMPLE_FRACTION < 1.0 else df
                sdf = sdf.limit(DISTINCT_SAMPLE_ROWS)
                elig = [c["name"] for c in cols if c["family"] in {"integral","decimal","floating","stringy","dates","boolean"}]
                for batch_start in range(0, len(elig), 40):
                    batch = elig[batch_start:batch_start+40]
                    exprs = [F.approx_count_distinct(F.col(c)).alias(c) for c in batch]
                    row = sdf.select(*exprs).first()
                    if row: ad.update({k: (int(v) if v is not None else None) for k, v in row.asDict().items()})
            except Exception as exc:
                self.warnings.append(f"Approx distinct failed for {t}: {exc}")

            # enrich column metas
            for c in cols:
                c["null_ratio"] = nr.get(c["name"])
                c["approx_distinct"] = ad.get(c["name"])
                c["is_id_name"] = match_any(c["name"], ID_NAME_HINTS)
                c["is_fk_name"] = match_any(c["name"], FK_NAME_HINTS)
            meta["columns"] = cols

    # ---------- Key candidates ----------
    def pk_candidates(self, table: str, meta: Dict[str, Any]) -> List[str]:
        # Declared PK wins
        if table in self.declared["pk"] and self.declared["pk"][table]:
            return list(self.declared["pk"][table])

        cols = meta.get("columns", [])
        row_count = meta.get("row_count")
        if not cols or not row_count or row_count <= 0:
            return []

        # Score single-column PKs (distinctness + nulls + name hint)
        scored: List[Tuple[str,float]] = []
        for c in cols:
            ad = c.get("approx_distinct")
            if ad is None: continue
            ratio = min(1.0, ad / max(1, row_count))
            score = 0.65 * ratio + 0.25 * null_complement(c.get("null_ratio")) + 0.10 * (1.0 if c.get("is_id_name") else 0.0)
            scored.append((c["name"], round(score,3)))

        scored.sort(key=lambda x: x[1], reverse=True)
        if scored and scored[0][1] >= PK_ACCEPT_RATIO:
            return [scored[0][0]]

        # Simple composite (top 2) if close, bounded via sample + hash distinct
        top_names = [n for (n,s) in scored[:5]]
        if len(top_names) >= 2:
            df = self.describe_table(table)
            if df is not None:
                try:
                    sdf = df.select(*[F.col(n) for n in top_names]).sample(False, 0.2, seed=11).limit(200_000)
                    best_combo, best_ratio = None, 0.0
                    for combo in itertools.combinations(top_names, 2):
                        ad2 = sdf.select(
                            F.approx_count_distinct(
                                F.sha2(F.concat_ws("||", *[F.coalesce(F.col(c).cast("string"), F.lit("NULL")) for c in combo]), 256)
                            ).alias("ad")
                        ).first().ad
                        if ad2:
                            ratio2 = min(1.0, ad2 / max(1, row_count))
                            if ratio2 > best_ratio:
                                best_ratio, best_combo = ratio2, combo
                    if best_combo and best_ratio >= PK_ACCEPT_RATIO:
                        return list(best_combo)
                except Exception as exc:
                    self.warnings.append(f"Composite PK eval failed for {table}: {exc}")

        # No strong candidate
        return [scored[0][0]] if scored else []

    def fk_candidates(self, meta: Dict[str, Any]) -> List[Dict[str, Any]]:
        out = []
        for c in meta.get("columns", []):
            fam_ok = c.get("family") in {"integral","decimal","floating","stringy","dates"}
            if not fam_ok: continue
            base = 0.30
            base += 0.40 if (c.get("is_fk_name") or c.get("is_id_name")) else 0.0
            base += 0.30 * null_complement(c.get("null_ratio"))
            out.append({"name": c["name"], "score": round(base,3)})
        out.sort(key=lambda d: d["score"], reverse=True)
        return out

    # ---------- Value sampling (bounded) ----------
    def collect_distinct_sample(self, table: str, col: str, max_rows: int, fraction: float) -> List[str]:
        try:
            df = self.describe_table(table)
            if df is None: return []
            sdf = df.select(F.col(col)).where(F.col(col).isNotNull()).sample(False, fraction, seed=23).limit(max_rows)
            vals = [str(r[0]) for r in sdf.distinct().limit(MAX_DISTINCT_COLLECT).collect() if r[0] is not None]
            return vals
        except Exception as exc:
            self.warnings.append(f"Value sample failed {table}.{col}: {exc}")
            return []

    # ---------- Relationship inference ----------
    def infer_relationships(self) -> None:
        # 1) Declared FKs
        for fk in self.declared["fk"]:
            fk_cols = fk["fk_cols"]; pk_cols = fk["pk_cols"]
            self.relationships.append({
                "fk_table": fk["fk_table"],
                "fk_column": " + ".join(fk_cols) if len(fk_cols)>1 else fk_cols[0],
                "pk_table": fk["pk_table"],
                "pk_column": " + ".join(pk_cols) if len(pk_cols)>1 else pk_cols[0],
                "score": 1.0,
                "declared": True,
                "cardinality": "many-to-one" if len(fk_cols)==1 else "many-to-one",
                "confidence": "high",
                "evidence": {"declared_constraint": fk["name"]},
                "join_example_sql": self._join_sql(fk["fk_table"], fk["pk_table"], fk_cols, pk_cols)
            })

        # 2) Inferred FKs (single-column first)
        pk_registry: Dict[str,List[str]] = {t: self.pk_candidates(t, m) for t,m in self.entities.items()}
        for fk_table, fk_meta in self.entities.items():
            fk_cols = self.fk_candidates(fk_meta)
            for fk_col in fk_cols:
                fk_name = fk_col["name"]
                for pk_table, pk_cols in pk_registry.items():
                    if not pk_cols: continue
                    # Skip if declared edge exists
                    if any(r.get("declared") and r["fk_table"]==fk_table and r["pk_table"]==pk_table for r in self.relationships):
                        continue

                    # Evaluate only single-column PKs in this phase
                    if len(pk_cols) != 1:
                        continue
                    pk_name = pk_cols[0]

                    # Type compatibility
                    f_meta = next((c for c in fk_meta["columns"] if c["name"]==fk_name), None)
                    p_meta = next((c for c in self.entities[pk_table]["columns"] if c["name"]==pk_name), None)
                    if not f_meta or not p_meta: continue
                    if not families_compatible(f_meta["family"], p_meta["family"]): continue

                    # Feature scores
                    sc_name = name_match_score(fk_name, pk_name)
                    sc_null = null_complement(f_meta.get("null_ratio"))
                    pk_ad = p_meta.get("approx_distinct")
                    pk_rows = self.entities[pk_table].get("row_count")
                    sc_dr = min(1.0, (pk_ad / max(1, pk_rows))) if (pk_ad is not None and pk_rows) else 0.5

                    # Value overlap (bounded)
                    fk_vals = set(self.collect_distinct_sample(fk_table, fk_name, DISTINCT_SAMPLE_ROWS, 0.25))
                    pk_vals = set(self.collect_distinct_sample(pk_table, pk_name, DISTINCT_SAMPLE_ROWS, 0.25))
                    sc_overlap = (len(fk_vals & pk_vals) / max(1, len(fk_vals))) if fk_vals else 0.0

                    # Aggregate score
                    score = (0.22*sc_name) + (0.18*sc_dr) + (0.18*sc_null) + (0.40*sc_overlap) + (0.02*1.0)
                    rel_score = round(float(score), 3)
                    if rel_score >= REL_MIN_SCORE:
                        # Cardinality hint via approx distinct
                        cardinality = "many-to-one"
                        fk_ad = f_meta.get("approx_distinct")
                        if fk_ad and pk_ad and pk_ad>0 and abs(fk_ad - pk_ad)/pk_ad < 0.05:
                            cardinality = "one-to-one"

                        self.relationships.append({
                            "fk_table": fk_table,
                            "fk_column": fk_name,
                            "pk_table": pk_table,
                            "pk_column": pk_name,
                            "score": rel_score,
                            "declared": False,
                            "cardinality": cardinality,
                            "confidence": "high" if rel_score >= REL_HIGH_CONF else "medium",
                            "evidence": {
                                "name_match": round(sc_name,3),
                                "pk_distinct_ratio": round(sc_dr,3),
                                "fk_null_complement": round(sc_null,3),
                                "value_overlap": round(sc_overlap,3),
                                "fk_ad": fk_ad, "pk_ad": pk_ad
                            },
                            "join_example_sql": self._join_sql(fk_table, pk_table, [fk_name], [pk_name])
                        })

        # 3) Composite inference (name-aligned pairs only; bounded)
        for pk_table, pk_cols in pk_registry.items():
            if len(pk_cols) < 2: continue
            for fk_table, fk_meta in self.entities.items():
                if fk_table == pk_table: continue
                fk_names = [c["name"] for c in fk_meta["columns"]]
                if all(any(fn.lower()==pc.lower() or fn.lower().endswith(f"_{pc.lower()}") for fn in fk_names) for pc in pk_cols):
                    # overlap check
                    try:
                        fk_df = self.describe_table(fk_table)
                        pk_df = self.describe_table(pk_table)
                        if fk_df is None or pk_df is None: continue
                        fk_sample = fk_df.select(*[F.col(c).cast("string") for c in pk_cols]).sample(False, 0.2, seed=101).limit(100_000)
                        pk_sample = pk_df.select(*[F.col(c).cast("string") for c in pk_cols]).sample(False, 0.2, seed=102).limit(100_000)
                        fk_hash = {r[0] for r in fk_sample.select(F.sha2(F.concat_ws("||", *[F.coalesce(F.col(c), F.lit("NULL")) for c in pk_cols]),256)).distinct().limit(MAX_DISTINCT_COLLECT).collect()}
                        pk_hash = {r[0] for r in pk_sample.select(F.sha2(F.concat_ws("||", *[F.coalesce(F.col(c), F.lit("NULL")) for c in pk_cols]),256)).distinct().limit(MAX_DISTINCT_COLLECT).collect()}
                        overlap = (len(fk_hash & pk_hash) / max(1, len(fk_hash))) if fk_hash else 0.0
                    except Exception as exc:
                        self.warnings.append(f"Composite overlap failed {fk_table}->{pk_table}: {exc}")
                        overlap = 0.0

                    if overlap >= 0.5:
                        rel_score = round(0.7 + 0.3*min(1.0, overlap), 3)
                        self.relationships.append({
                            "fk_table": fk_table,
                            "fk_column": " + ".join(pk_cols),
                            "pk_table": pk_table,
                            "pk_column": " + ".join(pk_cols),
                            "score": rel_score,
                            "declared": False,
                            "cardinality": "many-to-one",
                            "confidence": "high" if rel_score >= REL_HIGH_CONF else "medium",
                            "evidence": {"composite_overlap": round(overlap,3)},
                            "join_example_sql": self._join_sql(fk_table, pk_table, pk_cols, pk_cols)
                        })

        # 4) If absolutely nothing inferred/declared, keep top few suggestions (low confidence) to avoid empty output
        if not self.relationships:
            candidates: List[Tuple[float, Dict[str, Any]]] = []
            # simple top-N by name & type compat only
            for fk_table, fk_meta in self.entities.items():
                for fk in self.fk_candidates(fk_meta)[:5]:
                    f_meta = next((c for c in fk_meta["columns"] if c["name"]==fk["name"]), None)
                    if not f_meta: continue
                    for pk_table, pk_meta in self.entities.items():
                        if fk_table == pk_table: continue
                        for pc in self.pk_candidates(pk_table, pk_meta)[:1]:
                            p_meta = next((c for c in pk_meta["columns"] if c["name"]==pc), None)
                            if not p_meta: continue
                            if not families_compatible(f_meta["family"], p_meta["family"]): continue
                            sc_name = name_match_score(f_meta["name"], p_meta["name"])
                            sc = 0.6*sc_name + 0.2*null_complement(f_meta.get("null_ratio")) + 0.2*0.5
                            candidates.append((sc, {
                                "fk_table": fk_table, "fk_column": f_meta["name"],
                                "pk_table": pk_table, "pk_column": p_meta["name"],
                                "score": round(sc,3), "declared": False,
                                "cardinality": "many-to-one",
                                "confidence": "low",
                                "evidence": {"fallback": True, "name_match": round(sc_name,3)},
                                "join_example_sql": self._join_sql(fk_table, pk_table, [f_meta["name"]],[p_meta["name"]])
                            }))
            candidates.sort(key=lambda x: x[0], reverse=True)
            for sc, rel in candidates[:10]:
                self.relationships.append(rel)

        # Add view edges (lineage-like) as separate set (they are not FK; label "view-usage")
        for e in self.view_edges:
            self.relationships.append({
                "fk_table": e["view"],
                "fk_column": "*",
                "pk_table": e["table"],
                "pk_column": "*",
                "score": 0.99,
                "declared": False,
                "cardinality": "derived-from",
                "confidence": "high",
                "evidence": {"source": "information_schema.view_table_usage"},
                "join_example_sql": f"-- View {e['view']} uses {e['table']}"
            })

    def _join_sql(self, fk_table: str, pk_table: str, fk_cols: List[str], pk_cols: List[str]) -> str:
        fqt = fq_table_name(fk_table.split("."))
        pqt = fq_table_name(pk_table.split("."))
        cond = " AND ".join([f"f.`{f}` = p.`{p}`" for f,p in itertools.zip_longest(fk_cols, pk_cols, fillvalue=pk_cols[-1])])
        return f"SELECT * FROM {fqt} f JOIN {pqt} p ON {cond}"

    # ---------- Rendering ----------
    def render_markdown(self, model: Dict[str, Any]) -> str:
        md: List[str] = []
        md.append(f"# Reverse ERD & Data Model (v{VERSION})")
        md.append("")
        ns = model["namespace"]
        label = f"{ns['catalog']}.{ns['schema']}"
        md.append(f"- **Run ID:** `{model['run_id']}`")
        md.append(f"- **Namespace:** `{label}`")
