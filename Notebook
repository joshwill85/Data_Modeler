def build_graphml(model: Dict[str, Any]) -> str:
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<graphml xmlns="http://graphml.graphdrawing.org/xmlns">',
        '  <key id="label" for="edge" attr.name="label" attr.type="string"/>',
        '  <graph edgedefault="directed">',
    ]
    for entity in sorted(model["entities"], key=lambda e: e["name"]):
        lines.append(f'    <node id="{xml_escape(entity["name"])}"/>')
    for relation in model["relationships"]:
        confidence = relation.get("confidence", "unknown")
        label = f"{relation['fk_column']}→{relation['pk_column']} [{confidence}] ({relation['score']:.2f})"
        lines.append(
            f'    <edge source="{xml_escape(relation["fk_table"])}" target="{xml_escape(relation["pk_table"])}">'
        )
        lines.append(f'      <data key="label">{xml_escape(label)}</data>')
        lines.append("    </edge>")
    lines.append("  </graph>")
    lines.append("</graphml>")
    return "\n".join(lines)


