# ============================================================
# 6. COMBINED SUMMARY VIEWS
# ============================================================
spark.sql("""
CREATE OR REPLACE TEMP VIEW lineage_hop_summary_all AS
SELECT
  'UPSTREAM' AS direction,
  hop_count,
  distinct_objects_at_hop,
  path_rows_at_hop,
  latest_seen_time_any_object_at_hop,
  objects_at_hop
FROM upstream_hop_summary

UNION ALL

SELECT
  'DOWNSTREAM' AS direction,
  hop_count,
  distinct_objects_at_hop,
  CAST(NULL AS BIGINT) AS path_rows_at_hop,
  latest_seen_time_any_object_at_hop,
  objects_at_hop
FROM downstream_hop_summary
""")

spark.sql("""
CREATE OR REPLACE TEMP VIEW lineage_edges_by_hop_all AS
SELECT
  'UPSTREAM' AS direction,
  hop_count,
  from_table,
  from_type,
  to_table,
  to_type,
  latest_seen_time,
  events_seen_7d
FROM upstream_edges_by_hop

UNION ALL

SELECT
  'DOWNSTREAM' AS direction,
  hop_count,
  from_table,
  from_type,
  to_table,
  to_type,
  latest_seen_time,
  events_seen_7d
FROM downstream_edges_by_hop
""")

