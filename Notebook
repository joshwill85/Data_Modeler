from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType,
    StructField,
    ArrayType,
    StringType,
    TimestampType,
    LongType,
    BooleanType,
)
from datetime import timedelta

# ============================================================
# 0. CONFIG + NAMES
# ============================================================
root_table_full_name = "eciscor_prod.npdataset.npd_current_pending"

# Stage tables / views (persistent, not session-only)
edge_stage_table = "cdo.npd_current_pending_lineage_edges_7d"
object_stage_table = "cdo.npd_current_pending_lineage_objects_7d"
working_state_table = "cdo.npd_current_pending_upstream_working_state_7d"
paths_snapshots_table = "cdo.npd_current_pending_upstream_paths_snapshots_7d"
run_log_table = "cdo.npd_current_pending_upstream_run_log_7d"

current_paths_view = "cdo.npd_current_pending_upstream_paths_current_7d_v"
root_upstream_raw_view = "cdo.npd_current_pending_root_upstream_7d_raw_v"
root_upstream_traversal_view = "cdo.npd_current_pending_root_upstream_7d_traversal_v"
objects_by_hop_view = "cdo.npd_current_pending_upstream_objects_by_hop_7d_v"
hop_summary_view = "cdo.npd_current_pending_upstream_hop_summary_7d_v"
edges_by_hop_view = "cdo.npd_current_pending_upstream_edges_by_hop_7d_v"
path_summary_view = "cdo.npd_current_pending_upstream_path_summary_7d_v"

# Safety guards
max_upstream_hops = 15
max_upstream_rows_per_state = 250000
max_upstream_total_rows_seen = 3000000

# Stable 7-day window for the entire run
window_end = spark.sql("SELECT current_timestamp() AS ts").first()["ts"]
window_start = window_end - timedelta(days=7)
window_start_str = window_start.strftime("%Y-%m-%d %H:%M:%S")
window_end_str = window_end.strftime("%Y-%m-%d %H:%M:%S")

# Run id
run_id = spark.sql("SELECT uuid() AS run_id").first()["run_id"]

# Databricks recommends auto shuffle partitions for high-shuffle workloads
spark.conf.set("spark.sql.shuffle.partitions", "auto")

print(f"Root table: {root_table_full_name}")
print(f"Run id: {run_id}")
print(f"Window start: {window_start_str}")
print(f"Window end:   {window_end_str}")
print(f"Edge stage table: {edge_stage_table}")
print(f"Object stage table: {object_stage_table}")
print(f"Working state table: {working_state_table}")
print(f"Snapshots table: {paths_snapshots_table}")
print(f"Run log table: {run_log_table}")
print(f"Current view: {current_paths_view}")

# COMMAND ----------

# ============================================================
# 1. STAGE 1: MATERIALIZE THE 7-DAY EDGE TABLE ONCE
#
# NOTE:
# - You only have information_schema.table_lineage.
# - If you later get system.access.table_lineage, prefer filtering
#   on event_date first because event_date is the partition column.
# ============================================================
edges_7d_df = spark.sql(f"""
SELECT
  source_table_full_name,
  source_type,
  target_table_full_name,
  target_type,
  MAX(event_time) AS latest_seen_time,
  COUNT(DISTINCT event_id) AS events_seen_7d,
  COLLECT_SET(COALESCE(created_by, 'UNKNOWN')) AS creators,
  COLLECT_SET(COALESCE(entity_type, 'UNKNOWN')) AS entity_types
FROM information_schema.table_lineage
WHERE source_table_full_name IS NOT NULL
  AND target_table_full_name IS NOT NULL
  AND event_time >= TIMESTAMP('{window_start_str}')
  AND event_time <= TIMESTAMP('{window_end_str}')
GROUP BY
  source_table_full_name,
  source_type,
  target_table_full_name,
  target_type
""")

(
    edges_7d_df.write
    .format("delta")
    .mode("overwrite")
    .option("overwriteSchema", "true")
    .saveAsTable(edge_stage_table)
)

spark.sql(f"ANALYZE TABLE {edge_stage_table} COMPUTE STATISTICS")

edges_7d = spark.read.table(edge_stage_table).cache()
edge_count = edges_7d.count()

print(f"Materialized 7-day edge rows: {edge_count:,}")

# COMMAND ----------

# ============================================================
# 2. STAGE 1B: MATERIALIZE A SIMPLE OBJECT TYPE LOOKUP TABLE
#
# This lets us keep the working-state rows narrow and fill types later.
# ============================================================
object_rows_df = (
    edges_7d
    .select(
        F.col("source_table_full_name").alias("table_full_name"),
        F.col("source_type").alias("table_type"),
        F.col("latest_seen_time").alias("seen_time"),
    )
    .unionByName(
        edges_7d.select(
            F.col("target_table_full_name").alias("table_full_name"),
            F.col("target_type").alias("table_type"),
            F.col("latest_seen_time").alias("seen_time"),
        )
    )
)

object_stage_df = (
    object_rows_df
    .groupBy("table_full_name")
    .agg(
        F.max_by("table_type", "seen_time").alias("table_type"),
        F.max("seen_time").alias("latest_seen_time")
    )
)

(
    object_stage_df.write
    .format("delta")
    .mode("overwrite")
    .option("overwriteSchema", "true")
    .saveAsTable(object_stage_table)
)

spark.sql(f"ANALYZE TABLE {object_stage_table} COMPUTE STATISTICS")
objects_7d = spark.read.table(object_stage_table).cache()

print(f"Materialized 7-day object rows: {objects_7d.count():,}")

# COMMAND ----------

# ============================================================
# 3. PERSISTENT ROOT-UPSTREAM VIEWS (for validation)
# ============================================================
spark.sql(f"""
CREATE OR REPLACE VIEW {root_upstream_raw_view} AS
SELECT
  source_table_full_name,
  source_type,
  latest_seen_time,
  events_seen_7d,
  creators,
  entity_types
FROM {edge_stage_table}
WHERE target_table_full_name = '{root_table_full_name}'
ORDER BY latest_seen_time DESC, source_table_full_name
""")

spark.sql(f"""
CREATE OR REPLACE VIEW {root_upstream_traversal_view} AS
SELECT
  source_table_full_name,
  source_type,
  latest_seen_time,
  events_seen_7d,
  creators,
  entity_types
FROM {edge_stage_table}
WHERE target_table_full_name = '{root_table_full_name}'
  AND source_table_full_name <> target_table_full_name
ORDER BY latest_seen_time DESC, source_table_full_name
""")

print("Created persistent validation views for root upstream.")

# COMMAND ----------

# ============================================================
# 4. INITIALIZE OUTPUT TABLES IF NEEDED
# ============================================================
working_schema = StructType([
    StructField("path_tables", ArrayType(StringType()), True),
    StructField("edge_latest_seen_times", ArrayType(TimestampType()), True),
    StructField("edge_events_seen_7d_arr", ArrayType(LongType()), True),
    StructField("is_terminal", BooleanType(), True),
    StructField("hop_count", LongType(), True),
    StructField("path_id", StringType(), True),
    StructField("leaf_table", StringType(), True),
])

snapshot_schema = StructType([
    StructField("run_id", StringType(), True),
    StructField("root_table_full_name", StringType(), True),
    StructField("window_start", TimestampType(), True),
    StructField("window_end", TimestampType(), True),
    StructField("snapshot_hop", LongType(), True),
    StructField("hop_count", LongType(), True),
    StructField("path_id", StringType(), True),
    StructField("path_tables", ArrayType(StringType()), True),
    StructField("edge_latest_seen_times", ArrayType(TimestampType()), True),
    StructField("edge_events_seen_7d_arr", ArrayType(LongType()), True),
    StructField("leaf_table", StringType(), True),
    StructField("is_terminal", BooleanType(), True),
    StructField("written_at", TimestampType(), True),
])

run_log_schema = StructType([
    StructField("run_id", StringType(), True),
    StructField("root_table_full_name", StringType(), True),
    StructField("window_start", TimestampType(), True),
    StructField("window_end", TimestampType(), True),
    StructField("max_hop_in_state", LongType(), True),
    StructField("state_rows", LongType(), True),
    StructField("distinct_leaf_objects", LongType(), True),
    StructField("terminal_paths", LongType(), True),
    StructField("active_paths", LongType(), True),
    StructField("stop_reason", StringType(), True),
    StructField("written_at", TimestampType(), True),
])

if not spark.catalog.tableExists(working_state_table):
    spark.createDataFrame([], working_schema).write.format("delta").mode("overwrite").saveAsTable(working_state_table)

if not spark.catalog.tableExists(paths_snapshots_table):
    spark.createDataFrame([], snapshot_schema).write.format("delta").mode("overwrite").saveAsTable(paths_snapshots_table)

if not spark.catalog.tableExists(run_log_table):
    spark.createDataFrame([], run_log_schema).write.format("delta").mode("overwrite").saveAsTable(run_log_table)

