    errors.append("No tables found matching the specified criteria.")
    if VERBOSE_LOGS:
        print("ERROR: No tables discovered. Check your catalog/schema/database configuration.")

table_overview = {}
if not USE_LEGACY_DATABASE and tables:
    try:
        ist = spark.sql(f"""
            SELECT table_name, table_type, data_source_format
            FROM {fq_identifier(CATALOG)}.information_schema.tables
            WHERE table_schema = '{SCHEMA}'
        """)
        for r in ist.collect():
            table_overview[f"{CATALOG}.{SCHEMA}.{r.table_name}"] = {"table_type": r.table_type, "data_source_format": r.data_source_format}
    except Exception as e:
        warnings.append(f"information_schema.tables not accessible: {e}")

declared_constraints = {"pk": {}, "fk": [], "check": []}
if not USE_LEGACY_DATABASE and tables:
    try:
        is_tc  = spark.sql(f"SELECT * FROM {fq_identifier(CATALOG)}.information_schema.table_constraints WHERE table_schema = '{SCHEMA}'")
        is_kcu = spark.sql(f"SELECT * FROM {fq_identifier(CATALOG)}.information_schema.key_column_usage WHERE table_schema = '{SCHEMA}'")
        pk_names = [r.constraint_name for r in is_tc.filter(F.col("constraint_type")=="PRIMARY KEY").select("constraint_name").distinct().collect()]
        for pk in pk_names:
            cols = [r.column_name for r in is_kcu.filter(F.col("constraint_name")==pk).orderBy("ordinal_position").select("column_name").collect()]
            tbl  = is_kcu.filter(F.col("constraint_name")==pk).select("table_name").first()
            if tbl and cols:
                full = f"{CATALOG}.{SCHEMA}.{tbl.table_name}"
                declared_constraints["pk"][full] = cols
        is_rc  = spark.sql(f"SELECT * FROM {fq_identifier(CATALOG)}.information_schema.referential_constraints WHERE constraint_schema = '{SCHEMA}'")
        fk_rows = is_tc.filter(F.col("constraint_type")=="FOREIGN KEY").select("constraint_name","table_name").collect()
        for r in fk_rows:
            fk_name = r.constraint_name
            fk_tbl  = f"{CATALOG}.{SCHEMA}.{r.table_name}"
            fk_cols = [x.column_name for x in is_kcu.filter(F.col("constraint_name")==fk_name).orderBy("ordinal_position").select("column_name").collect()]
            ref = is_rc.filter(F.col("constraint_name")==fk_name).select("unique_constraint_name").first()
            if ref:
                pk_name = ref.unique_constraint_name
                pk_tbl_row = is_kcu.filter(F.col("constraint_name")==pk_name).select("table_name").first()
                if pk_tbl_row:
                    pk_tbl = f"{CATALOG}.{SCHEMA}.{pk_tbl_row.table_name}"
                    pk_cols = [x.column_name for x in is_kcu.filter(F.col("constraint_name")==pk_name).orderBy("ordinal_position").select("column_name").collect()]
                    if fk_cols and pk_cols:
                        declared_constraints["fk"].append({"fk_table": fk_tbl, "fk_cols": fk_cols, "pk_table": pk_tbl, "pk_cols": pk_cols, "name": fk_name})
        try:
            is_cc = spark.sql(f"SELECT * FROM {fq_identifier(CATALOG)}.information_schema.check_constraints WHERE constraint_schema = '{SCHEMA}'")
            for r in is_cc.collect():
                declared_constraints["check"].append({"constraint_name": r.constraint_name, "check_clause": r.check_clause})
        except Exception:
            pass
    except Exception as e:
        warnings.append(f"information_schema constraint discovery limited/unavailable: {e}")

