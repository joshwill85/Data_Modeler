def fq_identifier(token: str) -> str:
    token = token.strip().strip("`")
    return f"`{token}`"


def fq_table_name(parts: Iterable[str]) -> str:
    tokens = [fq_identifier(p) for p in parts if p]
    return ".".join(tokens)


def dtype_family(dt: T.DataType) -> str:
    s = dt.simpleString().lower()
    if s.startswith("array"):
        return "array"
    if s.startswith("map"):
        return "map"
    if s.startswith("struct"):
        return "struct"
    if "decimal" in s or "numeric" in s:
        return "decimal"
    if s in {"byte", "short", "int", "integer", "long", "bigint"}:
        return "integral"
    if s in {"double", "float"}:
        return "floating"
    if "string" in s or "char" in s or "varchar" in s:
        return "stringy"
    if "boolean" in s or "bool" in s:
        return "boolean"
    if "timestamp" in s or s == "date":
        return "dates"
    return s


def families_compatible(f1: str, f2: str) -> bool:
    if f1 == f2:
        return True
    if {f1, f2} <= {"integral", "decimal", "floating"}:
        return True
    if {f1, f2} <= {"stringy"}:
        return True
    if {f1, f2} <= {"dates"}:
        return True
    return False


def walk_schema(prefix: str, dt: T.DataType, depth: int = 0, max_depth: int = 10) -> List[Dict[str, Any]]:
    if depth > max_depth:
        return []
    out: List[Dict[str, Any]] = []
    if isinstance(dt, T.StructType):
        for f in dt.fields:
            path = f"{prefix}.{f.name}" if prefix else f.name
            out.append(
                {
                    "path": path,
                    "type": f.dataType.simpleString(),
                    "family": dtype_family(f.dataType),
                    "nullable": f.nullable,
                }
            )
            out += walk_schema(path, f.dataType, depth + 1, max_depth)
    elif isinstance(dt, T.ArrayType):
        elem = dt.elementType
        path = prefix + "[]" if prefix else "[]"
        out.append(
            {
                "path": path,
                "type": f"array<{elem.simpleString()}>",
                "family": "array",
                "nullable": True,
            }
        )
        out += walk_schema(prefix + "[]", elem, depth + 1, max_depth)
    elif isinstance(dt, T.MapType):
        out.append(
            {
                "path": prefix + "{}",
                "type": f"map<{dt.keyType.simpleString()},{dt.valueType.simpleString()}>",
                "family": "map",
                "nullable": True,
            }
        )
        out += walk_schema(prefix + "{}", dt.valueType, depth + 1, max_depth)
    return out


def array_guidance(dtype: T.DataType) -> Optional[Dict[str, Any]]:
    if not isinstance(dtype, T.ArrayType):
        return None
    elem = dtype.elementType
    if isinstance(elem, T.StructType):
        fields = ", ".join(
            [f"{f.name}:{f.dataType.simpleString()}" for f in elem.fields[:10]]
        )
        if len(elem.fields) > 10:
            fields += "..."
        return {
            "element_type": f"STRUCT<{fields}>",
            "parse_hint": "explode()/posexplode(), then select elem.*",
            "sql": "SELECT t.*, e.* FROM {{TABLE}} t LATERAL VIEW explode(t.{{ARRAY_COL}}) x AS e",
            "pyspark": "df.select('*', F.explode(F.col('{{ARRAY_COL}}')).alias('e')).select('*','e.*')",
        }
    return {
        "element_type": elem.simpleString(),
        "parse_hint": "explode()/posexplode() to normalize to rows",
        "sql": "SELECT t.*, e AS elem FROM {{TABLE}} t LATERAL VIEW explode(t.{{ARRAY_COL}}) x AS e",
        "pyspark": "df.select('*', F.explode(F.col('{{ARRAY_COL}}')).alias('elem'))",
    }


def map_guidance(dtype: T.DataType) -> Optional[Dict[str, Any]]:
    if not isinstance(dtype, T.MapType):
        return None
    return {
        "key_type": dtype.keyType.simpleString(),
        "value_type": dtype.valueType.simpleString(),
        "parse_hint": "explode(map) to (key,value) rows",
        "sql": "SELECT t.*, k, v FROM {{TABLE}} t LATERAL VIEW explode(t.{{MAP_COL}}) x AS k, v",
        "pyspark": "df.select('*', F.explode(F.col('{{MAP_COL}}')).alias('k','v'))",
    }


