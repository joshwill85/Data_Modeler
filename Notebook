def is_candidate_pk(col_meta, row_count):
    if row_count in (None, 0): return (False, 0.0)
    s = 0.0
    ad = col_meta.get("approx_distinct")
    if ad is not None and row_count > 0: s += 0.6 * min(1.0, ad / row_count)
    nr = col_meta.get("null_ratio")
    if nr is not None: s += 0.2 * (1.0 - nr)
    if col_meta.get("is_id_name"): s += 0.2
    return (s >= 0.65), round(s, 3)

def is_candidate_fk(col_meta):
    s = 0.0
    nr = col_meta.get("null_ratio")
    if nr is not None: s += 0.3 * (1.0 - nr)
    if col_meta.get("is_fk_name") or col_meta.get("is_id_name"): s += 0.4
    if col_meta.get("family","") in {"integral","decimal","floating","stringy","dates"}: s += 0.3
    return (s >= 0.55), round(s, 3)

for t, meta in entities.items():
    rc = meta.get("row_count")
    for c in meta["columns"]:
        pkf, pks = is_candidate_pk(c, rc)
        fkf, fks = is_candidate_fk(c)
        c["candidate_pk"] = pkf
        c["candidate_pk_score"] = pks
        c["candidate_fk"] = fkf
        c["candidate_fk_score"] = fks

for tbl, cols in declared_constraints["pk"].items():
    if tbl in entities:
        for c in entities[tbl]["columns"]:
            if c["name"] in cols:
                c["candidate_pk"] = True
                c["candidate_pk_score"] = 1.0

def best_composite_pk(df, cols_meta, row_count, top_n=6, max_k=3):
    if df is None or not cols_meta or row_count in (None, 0): return None, 0.0
    cols_meta = sorted(cols_meta, key=lambda c: c.get("candidate_pk_score", 0), reverse=True)[:top_n]
    names = [c["name"] for c in cols_meta]
    if len(names) < 2: return None, 0.0
    sdf = sample_df(df.select(*[F.col(n) for n in names]), 200_000, 0.2 if not FAST_MODE else 0.05)
    if sdf is None: return None, 0.0
    best, best_score = None, 0.0
    for k in range(2, min(max_k + 1, len(names) + 1)):
        for combo in itertools.combinations(names, k):
            try:
                ad = sdf.select(
                    F.approx_count_distinct(
                        F.sha2(F.concat_ws("||", *[F.coalesce(F.col(x).cast("string"), F.lit("NULL")) for x in combo]), 256)
                    )
                ).first()[0]
                if ad is None or ad == 0: continue
                distinct_ratio = ad / max(1, row_count)
                avg_col_score = sum(next(cm for cm in cols_meta if cm["name"] == x)["candidate_pk_score"] for x in combo) / k
                score = 0.75 * distinct_ratio + 0.25 * avg_col_score
                if score > best_score:
                    best, best_score = combo, score
            except Exception as e:
                warnings.append(f"Composite PK test failed for {combo}: {e}")
                continue
    return best, round(float(best_score), 3)

pk_registry = {}
for t, meta in entities.items():
    if t in declared_constraints["pk"] and declared_constraints["pk"][t]:
        pk_registry[t] = declared_constraints["pk"][t]
        continue
    cands = [c for c in meta["columns"] if c.get("candidate_pk")]
    if not cands:
        pk_registry[t] = []
        continue
    df = safe_table(t)
    combo, score = (None, 0.0)
    if not FAST_MODE and len(cands) >= 2:
        combo, score = best_composite_pk(df, cands, meta.get("row_count"), TOP_PK_CANDIDATES, MAX_COMPOSITE_K)
    if combo and score >= 0.80:
        pk_registry[t] = list(combo)
    elif cands:
        best_single = sorted([(c["name"], c["candidate_pk_score"]) for c in cands], key=lambda x: x[1], reverse=True)[0][0]
        pk_registry[t] = [best_single]
    else:
        pk_registry[t] = []

