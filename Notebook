# =========================
# RENDER (Markdown + Mermaid)
# =========================
def md_escape(s): 
    if s is None: return ""
    return str(s).replace("|", "\\|").replace("\n", " ").replace("\r", "")

def xml_escape(s):
    if s is None: return ""
    return html.escape(str(s))

def mermaid_safe(s):
    if s is None: return ""
    return str(s).replace("`", "").replace('"', "'").replace("\n", " ").replace(".", "_")

def render_mermaid(model) -> str:
    if len(model["entities"]) > MAX_MERMAID_TABLES:
        return "_Mermaid diagram omitted (too many tables for readable rendering)._"
    lines = ["```mermaid", "erDiagram"]
    for e in model["entities"]:
        entity_name = mermaid_safe(e["name"])
        lines.append(f"  {entity_name} {{")
        max_cols = MERMAID_MAX_COLUMNS
        cols = e["columns"] if max_cols is None or max_cols < 0 else e["columns"][:max_cols]
        for c in cols:
            lines.append(f"    {mermaid_safe(c['type'])} {mermaid_safe(c['name'])}")
        if max_cols is not None and max_cols >= 0 and len(e["columns"]) > max_cols:
            lines.append("    ... more_columns")
        lines.append("  }")
    for r in model["relationships"]:
        pk_entity = mermaid_safe(r["pk_table"]); fk_entity = mermaid_safe(r["fk_table"])
        pk_col = mermaid_safe(r["pk_column"]);   fk_col = mermaid_safe(r["fk_column"])
        label = f"{pk_col}_{fk_col}"
        lines.append(f"  {pk_entity} ||--o{{ {fk_entity} : \"{label}\"")
    lines.append("```")
    return "\n".join(lines)

def render_markdown(model) -> str:
    ns = model["namespace"]; nsname = ns["database"] or f"{ns['catalog']}.{ns['schema']}"
    lines = []
    lines.append(f"# ERD / Data Model Report — {nsname}")
    lines.append(f"_Author: {AUTHOR}_  ")
    lines.append(f"_Version: {VERSION}_  ")
    lines.append(f"_Run ID: {RUN_ID}_  ")
    lines.append(f"_Spark: {model['spark_env']['spark_version']}; Timezone: {model['spark_env']['session_timezone']}_\n")
    lines.append("## Summary")
    lines.append(f"- **Tables discovered**: {len(model['entities'])}")
    lines.append(f"- **Relationships identified**: {len(model['relationships'])}")
    lines.append(f"- **Declared constraints**: {len([r for r in model['relationships'] if r.get('declared')])}")
    lines.append(f"- **Inferred relationships**: {len([r for r in model['relationships'] if not r.get('declared')])}")
    lines.append("")
    lines.append("## Entities\n")
    for e in model["entities"]:
        lines.append(f"### {md_escape(e['name'])}")
        tt = e.get("table_type") or ("VIEW" if e.get("is_view") else "TABLE")
        dsf = e.get("data_source_format") or "unknown"
        lines.append(f"- **Type**: {tt}  ")
        lines.append(f"- **Data source**: {dsf}  ")
        lines.append(f"- **Approx rows**: {e.get('row_count') or 'unknown'}  ")
        if e.get("partial"):
            lines.append(f"- ⚠️ **Note**: Partial metadata (access limits or load failures)  ")
        lines.append("\n#### Columns")
        lines.append("| Name | Type | Nullable | ~Distinct | Null% | PK? | FK? | Date/Time Format | Complex |")
        lines.append("|------|------|----------|-----------|-------|-----|-----|------------------|---------|")
        for c in e["columns"]:
            dt_fmt = c.get("inferred_datetime_format"); support_pct = int((c.get('inferred_datetime_support') or 0)*100)
            dt_str = f"{dt_fmt} ({support_pct}%)" if dt_fmt else ""
            complex_str = ""
            if c.get("struct_fields"):
                complex_str = f"STRUCT ({len(c['struct_fields'])} nested)"
            elif c.get("array_guidance"):
                complex_str = f"ARRAY→{c['array_guidance']['element_type']}"
            elif c.get("map_guidance"):
                complex_str = f"MAP<{c['map_guidance']['key_type']},{c['map_guidance']['value_type']}>"
            null_pct = f"{c.get('null_ratio')*100:.1f}%" if c.get('null_ratio') is not None else ""
            pk_str = f"✓ ({c.get('candidate_pk_score')})" if c.get("candidate_pk") else ""
            fk_str = f"✓ ({c.get('candidate_fk_score')})" if c.get("candidate_fk") else ""
            t_str = c["type"]
            if MD_TRUNCATE_TYPE_CHARS is not None and MD_TRUNCATE_TYPE_CHARS >= 0 and len(t_str) > MD_TRUNCATE_TYPE_CHARS:
                t_str = t_str[:MD_TRUNCATE_TYPE_CHARS] + "…"
            lines.append("| {n} | {t} | {nu} | {ad} | {nr} | {pk} | {fk} | {df} | {cx} |".format(
                n=md_escape(c["name"]), t=md_escape(t_str), nu="Y" if c["nullable"] else "N",
                ad=md_escape(c.get("approx_distinct","")), nr=md_escape(null_pct),
                pk=md_escape(pk_str), fk=md_escape(fk_str), df=md_escape(dt_str), cx=md_escape(complex_str)
            ))
        if e.get("examples"):
            lines.append("\n**Example rows** (up to 3):")
            for i, r in enumerate(e["examples"][:3], 1):
                lines.append(f"{i}. `{md_escape(str(r)[:200])}`")
        lines.append("\n")
    lines.append("## Relationships")
    if model["relationships"]:
        lines.append("\n### Relationship Catalog")
        lines.append("| FK Table | FK Column(s) | PK Table | PK Column(s) | Score | Declared? | Cardinality | Evidence |")
        lines.append("|----------|--------------|----------|--------------|-------|-----------|-------------|----------|")
        for r in sorted(model["relationships"], key=lambda x: (-x["score"], x["fk_table"], x["pk_table"])):
            ev = r.get("evidence", {})
            evs = f"Declared: {ev.get('declared_constraint','constraint')}" if r.get("declared") else f"name:{ev.get('name_match','?')}, type:{ev.get('type_compat','?')}, overlap:{ev.get('value_overlap','?')}"
            lines.append(f"| {md_escape(r['fk_table'])} | {md_escape(r['fk_column'])} | {md_escape(r['pk_table'])} | {md_escape(r['pk_column'])} | {r['score']:.3f} | {r.get('declared',False)} | {r.get('cardinality','?')} | {md_escape(evs)} |")
        lines.append("\n### Join Examples")
        lines.append("Sample SQL and PySpark code for top relationships:\n")
        for r in model["relationships"][:min(15, len(model["relationships"]))]:
            lines.append(f"**{md_escape(r['fk_table'])}** → **{md_escape(r['pk_table'])}**")
            lines.append(f"- Columns: `{md_escape(r['fk_column'])}` = `{md_escape(r['pk_column'])}`")
            lines.append(f"- SQL: `{md_escape(r['join_example_sql'])}`")
            lines.append(f"- PySpark: `{md_escape(r['join_example_pyspark'])}`")
            lines.append("")
    else:
        lines.append("_No relationships found above the threshold._")
    lines.append("\n## How to Parse Complex Types")
    lines.append("- **ARRAY**: Use `explode()` or `posexplode()`, then `SELECT elem` or `elem.*` for STRUCT elements")
    lines.append("- **MAP**: Use `explode(map_col)` to get (key, value) rows; `map_keys()` / `map_values()` for projections")
    lines.append("- **STRUCT**: Use `col.*` to flatten one level; recurse for nested structures")
    lines.append("")
    lines.append("## Date/Time Parsing Guidance")
    lines.append("- **STRING with pattern** → `to_date()` / `to_timestamp()` with the detected pattern")
    lines.append("- **epoch_seconds** → `to_timestamp(col)`")
    lines.append("- **epoch_millis** → `to_timestamp(col / 1000.0)`")
    lines.append("- **Native DATE/TIMESTAMP** → Already typed; use `date_format()` for display")
    lines.append("")
    if EMIT_MERMAID:
        lines.append("## Entity Relationship Diagram")
        lines.append(render_mermaid(model))
        lines.append("")
    if warnings:
        lines.append("## ⚠️ Warnings")
        for w in warnings[:50]:
            lines.append(f"- {md_escape(w)}")
        if len(warnings) > 50:
            lines.append(f"- ... and {len(warnings) - 50} more warnings")
        lines.append("")
    if errors:
        lines.append("## ❌ Errors")
        for e in errors:
            lines.append(f"- {md_escape(e)}")
        lines.append("")
    return "\n".join(lines)

