def detect_string_datetime_format(samples: List[str]) -> Tuple[Optional[str], float, Dict[str,int]]:
    if not samples: return None, 0.0, {}
    counts, n = {}, 0
    for s in samples:
        if s is None: continue
        try:
            v = str(s).strip()
            if not v: continue
            n += 1
            matched = False
            for rx, label in DATE_TIME_PATTERNS:
                try:
                    if re.match(rx, v):
                        counts[label] = counts.get(label, 0) + 1
                        matched = True
                        break
                except re.error:
                    continue
            if not matched:
                counts["unknown"] = counts.get("unknown", 0) + 1
        except Exception:
            continue
    if n == 0 or not counts: return None, 0.0, {}
    top_label, top_cnt = max(counts.items(), key=lambda kv: kv[1])
    return top_label, top_cnt/n, counts

def walk_schema(prefix: str, dt: T.DataType, depth=0, max_depth=10) -> List[Dict[str, Any]]:
    if depth > max_depth: return []
    out = []
    if isinstance(dt, T.StructType):
        for f in dt.fields:
            path = f"{prefix}.{f.name}" if prefix else f.name
            out.append({"path": path, "type": f.dataType.simpleString(), "family": dtype_family(f.dataType), "nullable": f.nullable})
            out += walk_schema(path, f.dataType, depth+1, max_depth)
    elif isinstance(dt, T.ArrayType):
        elem = dt.elementType
        path = prefix + "[]" if prefix else "[]"
        out.append({"path": path, "type": f"array<{elem.simpleString()}>", "family": "array", "nullable": True})
        out += walk_schema(prefix + "[]", elem, depth+1, max_depth)
    elif isinstance(dt, T.MapType):
        out.append({"path": prefix + "{}", "type": f"map<{dt.keyType.simpleString()},{dt.valueType.simpleString()}>", "family": "map", "nullable": True})
        out += walk_schema(prefix + "{}", dt.valueType, depth+1, max_depth)
    return out

def array_guidance(dtype: T.DataType):
    if not isinstance(dtype, T.ArrayType): return None
    elem = dtype.elementType
    if isinstance(elem, T.StructType):
        fields = ", ".join([f"{f.name}:{f.dataType.simpleString()}" for f in elem.fields[:10]])
        if len(elem.fields) > 10: fields += "..."
        return {"element_type": f"STRUCT<{fields}>", "parse_hint": "explode()/posexplode(), then select elem.*",
                "sql": "SELECT t.*, e.* FROM {{TABLE}} t LATERAL VIEW explode(t.{{ARRAY_COL}}) x AS e",
                "pyspark": "df.select('*', F.explode(F.col('{{ARRAY_COL}}')).alias('e')).select('*','e.*')"}
    else:
        return {"element_type": elem.simpleString(), "parse_hint": "explode()/posexplode() to normalize to rows",
                "sql": "SELECT t.*, e AS elem FROM {{TABLE}} t LATERAL VIEW explode(t.{{ARRAY_COL}}) x AS e",
                "pyspark": "df.select('*', F.explode(F.col('{{ARRAY_COL}}')).alias('elem'))"}

def map_guidance(dtype: T.DataType):
    if not isinstance(dtype, T.MapType): return None
    return {"key_type": dtype.keyType.simpleString(), "value_type": dtype.valueType.simpleString(),
            "parse_hint": "explode(map) to (key,value) rows",
            "sql": "SELECT t.*, k, v FROM {{TABLE}} t LATERAL VIEW explode(t.{{MAP_COL}}) x AS k, v",
            "pyspark": "df.select('*', F.explode(F.col('{{MAP_COL}}')).alias('k','v'))"}

def name_match_score(fk_name, pk_name):
    fk, pk = fk_name.lower(), pk_name.lower()
    if fk == pk: return 1.0
    if fk.endswith("_id") and pk in {"id","pk","pk_id"}: return 0.9
    if fk.endswith(pk) or pk.endswith(fk): return 0.7
    fk_tokens = set(re.split(r"[_\W]+", fk)); pk_tokens = set(re.split(r"[_\W]+", pk))
    union_size = len(fk_tokens | pk_tokens)
    if union_size == 0: return 0.3
    j = len(fk_tokens & pk_tokens) / union_size
    return max(0.3, j)

def type_compat_score(fk_fam, pk_fam): return 1.0 if families_compatible(fk_fam, pk_fam) else 0.0

def cardinality_score(fk_ad, pk_ad):
    if fk_ad is None or pk_ad is None or pk_ad == 0: return 0.5
    ratio = fk_ad / max(1, pk_ad)
    if ratio >= 1.0: return 1.0 if ratio <= 50 else 0.8
    return 0.4

def distinct_ratio_score(pk_ad, pk_rowcount):
    if pk_ad is None or pk_rowcount in (None, 0): return 0.5
    return min(1.0, pk_ad / max(1, pk_rowcount))

def null_ratio_score(fk_null): return 0.5 if fk_null is None else (1.0 - fk_null)

