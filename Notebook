def _get_env(name, default=None):
    """Get parameter from widgets or placeholders (always attempt get; then fallbacks)."""
    # Try reading widget even if creation failed elsewhere
    try:
        v = dbutils.widgets.get(name)
        if v is not None and str(v).strip() != "":
            return v
    except Exception:
        pass
    # Fallbacks
    v = PLACEHOLDERS.get(name, "")
    if isinstance(v, str) and v.startswith("{{") and v.endswith("}}"):
        return default
    return v or default

def _to_bool(x, default=False):
    if x is None: return default
    return str(x).strip().lower() in {"1","true","t","yes","y","on"}

def _to_int(x, default=0):
    try: return int(float(str(x)))
    except: return default

def _to_float(x, default=0.0):
    try: return float(str(x))
    except: return default

