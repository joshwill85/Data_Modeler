# Databricks / PySpark
# Reverse ERD & Data Model Generator (Unity Catalog on AWS)
# Author: Joshua Williamson
# Version: 3.0.0
# ------------------------------------------------------------------------------
# Design goals (industry-standard reverse-ERD approach):
# - No widgets, no interactive prints/logging — file/volume outputs only.
# - Works in Unity Catalog (AWS). Uses information_schema where possible.
# - Combines declared constraints + robust inference (name/type hints, stats, value overlap).
# - Bounded, scalable sampling; no RDDs, no driver-JVM access, no job logs.
# - Clean visual deliverables (HTML ERD + Markdown + GraphML) and CSV/JSON extracts.
# - Writes to UC Volumes (preferred) or DBFS paths using /dbfs FUSE (safe on clusters).
# ------------------------------------------------------------------------------

from __future__ import annotations

import os
import re
import json
import html
import time
import uuid
import itertools
import datetime as dt
from typing import Any, Dict, Iterable, List, Optional, Tuple

from pyspark.sql import DataFrame, SparkSession, functions as F, types as T
from pyspark.sql.utils import AnalysisException

# =========================
# ===== CONFIG BLOCK  =====
# =========================
# Set your UC namespace and output root. Prefer a UC Volume.
# Examples:
#   UC_VOLUME_ROOT = "dbfs:/Volumes/your_catalog/your_schema/your_volume/erd"
#   or fallback:
#   UC_VOLUME_ROOT = "dbfs:/FileStore/erd"
CATALOG = "main"          # e.g., "eciscor_prod"
SCHEMA = "default"        # e.g., "cdo"
UC_VOLUME_ROOT = "dbfs:/FileStore/erd"   # <-- change to a UC Volume path when available
SESSION_TIMEZONE = "UTC"

# Heuristics & bounds (no user widgets; tuned for large-ish catalogs)
ROW_SAMPLE_FRACTION = 0.05
NULL_SAMPLE_ROWS = 50_000
DISTINCT_SAMPLE_ROWS = 50_000
MAX_DISTINCT_COLLECT = 50_000        # cap for distinct values collected to driver
PK_ACCEPT_RATIO = 0.80               # distinct_ratio ~= ad/row_count
REL_MIN_SCORE = 0.58                 # accept relationships above this score
REL_HIGH_CONF = 0.75                 # high-confidence threshold
MAX_TABLES = 50_000                  # hard safety bound
MAX_COLUMNS_PER_ENTITY_HTML = 30     # -1 for unlimited

# Name patterns (industry heuristics)
ID_NAME_HINTS = [r".*\b(id|_id)\b", r".*\b(key|_key)\b", r".*\b(uuid|guid)\b"]
FK_NAME_HINTS = [
    r".*\b.*_id\b",
    r".*\b(user|customer|account|client|order|product|parent|owner).*(id|_id)\b",
]

# =========================
# ====== UTILITIES   ======
# =========================

VERSION = "3.0.0"
AUTHOR = "Joshua Williamson"

def now_utc() -> str:
    return dt.datetime.utcnow().isoformat() + "Z"

def run_id() -> str:
    return dt.datetime.utcnow().strftime("run_%Y%m%d_%H%M%S_") + str(uuid.uuid4())[:8]

def dbfs_to_local(dbfs_path: str) -> str:
    # Convert "dbfs:/..." to "/dbfs/..." and "/Volumes/..." to "/dbfs/Volumes/..."
    if dbfs_path.startswith("dbfs:/"):
        return "/dbfs/" + dbfs_path[len("dbfs:/"):].lstrip("/")
    if dbfs_path.startswith("/Volumes/"):
        return "/dbfs" + dbfs_path
    if dbfs_path.startswith("file:/"):
        return dbfs_path[len("file:/"):]
    return dbfs_path  # already local?

def fq_identifier(token: str) -> str:
    token = token.strip().strip("`")
    return f"`{token}`"

def fq_table_name(parts: Iterable[str]) -> str:
    tokens = [fq_identifier(p) for p in parts if p]
    return ".".join(tokens)

def dtype_family(dt: T.DataType) -> str:
    s = dt.simpleString().lower()
    if s.startswith("array"): return "array"
    if s.startswith("map"): return "map"
    if s.startswith("struct"): return "struct"
    if "decimal" in s or "numeric" in s: return "decimal"
    if s in {"byte","short","int","integer","long","bigint"}: return "integral"
    if s in {"double","float"}: return "floating"
    if "string" in s or "char" in s or "varchar" in s: return "stringy"
    if "boolean" in s or "bool" in s: return "boolean"
    if "timestamp" in s or s == "date": return "dates"
    return s

def families_compatible(f1: str, f2: str) -> bool:
    if f1 == f2: return True
    if {f1, f2} <= {"integral", "decimal", "floating"}: return True
    if {f1, f2} <= {"stringy"}: return True
    if {f1, f2} <= {"dates"}: return True
    return False

def match_any(name: str, patterns: List[str]) -> bool:
    lowered = name.lower()
    for p in patterns:
        try:
            if re.match(p, lowered): return True
        except re.error:
            pass
    return False

def name_match_score(a: str, b: str) -> float:
    a, b = a.lower(), b.lower()
    if a == b: return 1.0
    if a.endswith("_id") and b in {"id","pk","pk_id"}: return 0.9
    if a.endswith(b) or b.endswith(a): return 0.75
    at = set(re.split(r"[_\W]+", a))
    bt = set(re.split(r"[_\W]+", b))
    if not (at or bt): return 0.3
    j = len(at & bt) / max(1, len(at | bt))
    return max(0.3, j)

def null_complement(null_ratio: Optional[float]) -> float:
    if null_ratio is None: return 0.5
    return 1.0 - float(null_ratio)

def safe_conf_get(spark: SparkSession, key: str) -> Optional[str]:
    try:
        return spark.conf.get(key)
    except Exception:
        return None

def safe_conf_get_bool(spark: SparkSession, key: str) -> Optional[bool]:
    v = safe_conf_get(spark, key)
    if v is None: return None
    s = str(v).strip().lower()
    if s in {"true","1","t","y","yes","on"}: return True
    if s in {"false","0","f","n","no","off"}: return False
    return None

