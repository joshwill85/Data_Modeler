"""Table profiling logic."""
from __future__ import annotations

from typing import TYPE_CHECKING, Any, List, Optional, Sequence

try:  # pragma: no cover - allow import without PySpark
    from pyspark.sql import functions as F
    from pyspark.sql.utils import AnalysisException
except ModuleNotFoundError:  # pragma: no cover - fallback when PySpark missing
    F = None  # type: ignore[assignment]

    class AnalysisException(Exception):
        """Placeholder used when PySpark is unavailable."""

if TYPE_CHECKING:  # pragma: no cover - typing only
    from pyspark.sql import DataFrame, SparkSession
    from pyspark.sql.types import StructField, StructType
else:
    DataFrame = SparkSession = StructField = StructType = Any  # type: ignore

from .config import ModelerConfig
from .discovery import DiscoveredTable
from .structures import ColumnProfile, TableProfile


def profile_tables(
    spark: "SparkSession", config: ModelerConfig, tables: Sequence[DiscoveredTable]
) -> List[TableProfile]:
    profiles: List[TableProfile] = []
    for table in tables:
        try:
            profile = _profile_single_table(spark, config, table)
            profiles.append(profile)
        except AnalysisException:
            if config.verbose:
                print(f"Skipping table {table.full_name} due to missing permissions.")
    return profiles


def _profile_single_table(
    spark: "SparkSession", config: ModelerConfig, table: DiscoveredTable
) -> TableProfile:
    df = spark.table(table.full_name)
    row_count = _safe_row_count(spark, table.full_name, config)

    sample_fraction, sampled_df = _sample_table(df, row_count, config)
    sampled_df.cache()
    sample_row_count = sampled_df.count()

    column_profiles = _profile_columns(sampled_df, df.schema, sample_row_count, config)

    sample_view = _sample_view_name(table)
    sampled_df.createOrReplaceTempView(sample_view)
    sampled_df.unpersist()

    return TableProfile(
        catalog=table.catalog,
        schema=table.schema,
        name=table.name,
        object_type=table.object_type,
        comment=table.comment,
        row_count=row_count,
        sample_row_count=sample_row_count,
        sample_fraction_applied=sample_fraction,
        columns=column_profiles,
        sample_view_name=sample_view,
    )


def _safe_row_count(
    spark: "SparkSession", table_name: str, config: ModelerConfig
) -> Optional[int]:
    if not config.enable_describe_detail:
        return None
    try:
        detail = spark.sql(f"DESCRIBE DETAIL {table_name}")
        return int(detail.select("numRows").collect()[0][0])
    except Exception:
        return None


def _sample_table(
    df: "DataFrame", row_count: Optional[int], config: ModelerConfig
) -> tuple[float, "DataFrame"]:
    fraction = config.sample_row_fraction
    if row_count:
        target = min(row_count, config.sample_row_cap)
        fraction = min(1.0, max(fraction, target / row_count if row_count else fraction))
    sampled = df.sample(fraction=fraction, withReplacement=False, seed=42)
    if row_count and row_count <= config.sample_row_cap:
        sampled = df.limit(config.sample_row_cap)
        fraction = 1.0 if row_count <= config.sample_row_cap else fraction
    return fraction, sampled


def _profile_columns(
    sampled_df: "DataFrame",
    schema: "StructType",
    sample_row_count: int,
    config: ModelerConfig,
) -> List[ColumnProfile]:
    columns: List[ColumnProfile] = []

    if sample_row_count == 0:
        for field in schema:
            columns.append(
                ColumnProfile(
                    name=field.name,
                    data_type=field.dataType.simpleString(),
                    nullable=field.nullable,
                    comment=_field_comment(field),
                    sample_rows=0,
                    null_count=0,
                    distinct_count=None,
                    inferred_max_length=None,
                    uniqueness_ratio=0.0,
                    null_ratio=0.0,
                )
            )
        return columns

    if F is None:
        raise RuntimeError("PySpark is required to profile tables. Install pyspark to continue.")

    fields = list(schema)
    null_exprs = [
        F.sum(F.col(field.name).isNull().cast("long")).alias(field.name)
        for field in fields
    ]
    null_counts_row = sampled_df.agg(*null_exprs).collect()[0]

    if config.approx_distinct:
        distinct_exprs = [
            F.approx_count_distinct(F.col(field.name)).alias(field.name)
            for field in fields
        ]
    else:
        distinct_exprs = [
            F.countDistinct(F.col(field.name)).alias(field.name) for field in fields
        ]
    distinct_row = sampled_df.agg(*distinct_exprs).collect()[0]
    distinct_counts = distinct_row.asDict()

    previews = _collect_sample_values(sampled_df, fields, config)

    for field in fields:
        name = field.name
        data_type = field.dataType.simpleString()
        null_count = int(null_counts_row[name])
        distinct_value = distinct_counts.get(name)
        distinct_count = int(distinct_value) if distinct_value is not None else None
        uniqueness_ratio = (
            (distinct_count / sample_row_count)
            if distinct_count is not None and sample_row_count
            else 0.0
        )
        null_ratio = null_count / sample_row_count if sample_row_count else 0.0
        inferred_max_length = _infer_max_length(sampled_df, name, data_type)

        columns.append(
            ColumnProfile(
                name=name,
                data_type=data_type,
                nullable=field.nullable,
                comment=_field_comment(field),
                sample_rows=sample_row_count,
                null_count=null_count,
                distinct_count=distinct_count,
                inferred_max_length=inferred_max_length,
                uniqueness_ratio=float(min(1.0, uniqueness_ratio)),
                null_ratio=float(min(1.0, null_ratio)),
                sample_values_preview=previews.get(name, []),
            )
        )
    return columns


def _collect_sample_values(
    sampled_df: "DataFrame",
    fields: List["StructField"],
    config: ModelerConfig,
) -> dict[str, List[str]]:
    previews: dict[str, List[str]] = {}
    for field in fields:
        column_name = field.name
        iterator = (
            sampled_df.select(column_name)
            .dropna()
            .distinct()
            .limit(min(20, config.value_sample_cap))
            .toLocalIterator()
        )
        previews[column_name] = [str(row[0]) for row in iterator]
    return previews


def _field_comment(field: StructField) -> Optional[str]:
    metadata = getattr(field, "metadata", None)
    if metadata and "comment" in metadata:
        return metadata["comment"]
    return None


def _infer_max_length(df: "DataFrame", column: str, data_type: str) -> Optional[int]:
    if data_type.startswith("string"):
        try:
            return df.select(F.max(F.length(F.col(column))).alias("max_len")).collect()[0][
                "max_len"
            ]
        except Exception:
            return None
    return None


def _sample_view_name(table: DiscoveredTable) -> str:
    return f"sample__{table.schema or 'default'}__{table.name}"
