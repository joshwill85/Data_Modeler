## 6. Discovery (`src/datamodeler/discovery.py`)

```python
"""Table discovery helpers."""
from __future__ import annotations

import re
from dataclasses import dataclass
from typing import Iterable, List, Optional, TYPE_CHECKING

if TYPE_CHECKING:  # pragma: no cover - typing only
    from pyspark.sql import SparkSession

from .config import ModelerConfig


@dataclass(frozen=True)
class DiscoveredTable:
    """Raw metadata discovered from the catalog."""

    catalog: Optional[str]
    schema: Optional[str]
    name: str
    object_type: str
    comment: Optional[str]

    @property
    def full_name(self) -> str:
        parts = [p for p in [self.catalog, self.schema, self.name] if p]
        return ".".join(parts) if parts else self.name


def discover_tables(spark: "SparkSession", config: ModelerConfig) -> List[DiscoveredTable]:
    """Discover tables/views based on configuration."""

    include_re = re.compile(config.include_tables_re) if config.include_tables_re else None
    exclude_re = re.compile(config.exclude_tables_re) if config.exclude_tables_re else None

    tables: List[DiscoveredTable] = []
    if config.use_unity_catalog and config.catalog:
        filter_clause = config.table_filter_clause()
        base_query = f"SELECT table_catalog, table_schema, table_name, table_type, comment FROM {config.catalog}.information_schema.tables"
        if filter_clause:
            base_query += f" WHERE {filter_clause}"
        rows = spark.sql(base_query).collect()
        for row in rows:
            tables.append(
                DiscoveredTable(
                    catalog=row["table_catalog"],
                    schema=row["table_schema"],
                    name=row["table_name"],
                    object_type=row["table_type"],
                    comment=row.asDict().get("comment"),
                )
            )
    else:
        if config.database:
            table_iterable = spark.catalog.listTables(config.database)
        elif config.schema and config.catalog:
            table_iterable = spark.catalog.listTables(f"{config.catalog}.{config.schema}")
        else:
            table_iterable = spark.catalog.listTables()
        tables.extend(_convert_catalog_entries(table_iterable))

    filtered: List[DiscoveredTable] = []
    for table in tables:
        name = table.name
        if include_re and not include_re.search(name):
            continue
        if exclude_re and exclude_re.search(name):
            continue
        filtered.append(table)
    return filtered


def _convert_catalog_entries(entries: Iterable) -> List[DiscoveredTable]:
    converted: List[DiscoveredTable] = []
    for table in entries:
        converted.append(
            DiscoveredTable(
                catalog=getattr(table, "catalog", None),
                schema=getattr(table, "database", None) or getattr(table, "schema", None),
                name=table.name,
                object_type=table.tableType,
                comment=getattr(table, "description", None),
            )
        )
    return converted
