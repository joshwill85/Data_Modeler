```python
"""Primary and foreign key inference."""
from __future__ import annotations

import difflib
from dataclasses import dataclass
from typing import Dict, Iterable, List, Sequence, Tuple, TYPE_CHECKING

if TYPE_CHECKING:  # pragma: no cover - typing only
    from pyspark.sql import DataFrame, SparkSession

from .config import ModelerConfig
from .structures import ColumnProfile, Relationship, TableProfile


@dataclass(frozen=True)
class _CandidateTarget:
    score: float
    name_similarity: float
    target_table: TableProfile
    target_column: ColumnProfile


def score_primary_keys(tables: Sequence[TableProfile], config: ModelerConfig) -> None:
    for table in tables:
        for column in table.columns:
            column.primary_key_score = _score_primary_key(column)
        best = max(table.columns, key=lambda c: c.primary_key_score, default=None)
        if best and best.primary_key_score >= config.pk_confidence_threshold:
            best.is_primary_key = True


def _score_primary_key(column: ColumnProfile) -> float:
    uniqueness = column.uniqueness_ratio
    completeness = 1.0 - column.null_ratio
    datatype_bonus = 0.1 if _is_identifier_type(column.data_type) else 0.0
    preview_bonus = 0.05 if column.sample_values_preview else 0.0
    length_penalty = 0.0
    if column.inferred_max_length and column.inferred_max_length < 8:
        length_penalty = 0.05
    score = (
        0.55 * uniqueness
        + 0.25 * completeness
        + datatype_bonus
        + preview_bonus
        - length_penalty
    )
    return min(1.0, max(0.0, score))


def _is_identifier_type(data_type: str) -> bool:
    lowered = data_type.lower()
    return any(keyword in lowered for keyword in ["int", "long", "string", "uuid"])


def infer_relationships(
    spark: "SparkSession", tables: Sequence[TableProfile], config: ModelerConfig
) -> List[Relationship]:
    relationships: List[Relationship] = []
    pk_lookup = _build_pk_lookup(tables)
    source_cache: Dict[
        Tuple[str, str, int], Tuple["DataFrame", int]
    ] = {}  # (relation, column, limit)
    target_cache: Dict[Tuple[str, str, int], "DataFrame"] = {}
    persisted_frames: List["DataFrame"] = []
    try:
        for source in tables:
            for column in source.columns:
                if column.is_primary_key:
                    continue
                candidate_targets = _rank_candidates(
                    source,
                    column,
                    pk_lookup.values(),
                    config,
                )
                for candidate in candidate_targets:
                    relationship = _evaluate_relationship(
                        spark,
                        source,
                        column,
                        candidate,
                        config,
                        source_cache,
                        target_cache,
                        persisted_frames,
                    )
                    if (
                        relationship
                        and relationship.confidence >= config.fk_confidence_threshold
                    ):
                        column.foreign_key_candidates[
                            candidate.target_table.full_name
                        ] = relationship.confidence
                        relationships.append(relationship)
    finally:
        for frame in persisted_frames:
            try:
                frame.unpersist()
            except Exception:
                pass
    return relationships


def _build_pk_lookup(
    tables: Sequence[TableProfile],
) -> Dict[str, Tuple[TableProfile, ColumnProfile]]:
    lookup: Dict[str, Tuple[TableProfile, ColumnProfile]] = {}
    for table in tables:
        pk_column = next((c for c in table.columns if c.is_primary_key), None)
        if pk_column:
            lookup[table.full_name] = (table, pk_column)
    return lookup


def _rank_candidates(
    source_table: TableProfile,
    source_column: ColumnProfile,
    targets: Iterable[Tuple[TableProfile, ColumnProfile]],
    config: ModelerConfig,
) -> List[_CandidateTarget]:
    ranked: List[_CandidateTarget] = []
    for target_table, target_column in targets:
        if source_table.full_name == target_table.full_name and (
            source_column.name == target_column.name
        ):
            continue
        base_score, name_similarity = _metadata_fk_signal(
            source_column, target_column
        )
        if base_score < config.fk_metadata_min_score:
            continue
        ranked.append(
            _CandidateTarget(
                score=base_score,
                name_similarity=name_similarity,
                target_table=target_table,
                target_column=target_column,
            )
        )
    ranked.sort(key=lambda candidate: candidate.score, reverse=True)
    return ranked[: config.max_fk_candidates_per_column]


def _metadata_fk_signal(
    source_column: ColumnProfile, target_column: ColumnProfile
) -> Tuple[float, float]:
    """Return a metadata-based score and the name similarity."""

    name_similarity = difflib.SequenceMatcher(
        None, source_column.name.lower(), target_column.name.lower()
    ).ratio()

    type_match = _are_types_compatible(
        source_column.data_type, target_column.data_type
    )
    uniqueness_alignment = _ratio_alignment(
        source_column.uniqueness_ratio, target_column.uniqueness_ratio
    )
    completeness = 1.0 - source_column.null_ratio
    length_alignment = _length_alignment(
        source_column.inferred_max_length, target_column.inferred_max_length
    )
    preview_overlap = _preview_overlap(
        source_column.sample_values_preview, target_column.sample_values_preview
    )
    suffix_bonus = 0.1 if source_column.name.lower().endswith("_id") else 0.0

    base_score = (
        0.25 * name_similarity
        + 0.25 * type_match
        + 0.2 * uniqueness_alignment
        + 0.15 * completeness
        + 0.1 * length_alignment
        + 0.05 * preview_overlap
        + suffix_bonus
    )

    return min(1.0, base_score), name_similarity


def _are_types_compatible(source_type: str, target_type: str) -> float:
    source_type = source_type.lower()
    target_type = target_type.lower()
    if source_type == target_type:
        return 1.0
    numeric_types = {"int", "integer", "bigint", "long", "short", "tinyint"}
    if source_type in numeric_types and target_type in numeric_types:
        return 0.8
    if source_type.startswith("string") and target_type.startswith("string"):
        return 0.7
    if source_type.startswith("decimal") and target_type.startswith("decimal"):
        return 0.7
    return 0.0


def _ratio_alignment(source_ratio: float, target_ratio: float) -> float:
    if source_ratio == 0 or target_ratio == 0:
        return 0.3
    return max(0.0, 1.0 - abs(source_ratio - target_ratio))


def _length_alignment(
    source_length: Optional[int], target_length: Optional[int]
) -> float:
    if source_length is None or target_length is None:
        return 0.5
    if target_length == 0:
        return 0.0
    return max(0.0, 1.0 - abs(source_length - target_length) / target_length)


def _preview_overlap(
    source_preview: Sequence[str], target_preview: Sequence[str]
) -> float:
    if not source_preview or not target_preview:
        return 0.0
    source_set = set(source_preview)
    target_set = set(target_preview)
    overlap = source_set.intersection(target_set)
    if not overlap:
        return 0.0
    denom = min(len(source_set), len(target_set)) or 1
    return min(1.0, len(overlap) / denom)


def _evaluate_relationship(
    spark: "SparkSession",
    source_table: TableProfile,
    source_column: ColumnProfile,
    candidate: _CandidateTarget,
    config: ModelerConfig,
    source_cache: Dict[Tuple[str, str, int], Tuple["DataFrame", int]],
    target_cache: Dict[Tuple[str, str, int], "DataFrame"],
    persisted_frames: List["DataFrame"],
) -> Relationship | None:
    source_df, total_fk = _get_source_distinct_values(
        spark,
        source_table,
        source_column.name,
        config.value_sample_cap,
        source_cache,
        persisted_frames,
    )

    target_df = _get_target_distinct_values(
        spark,
        candidate.target_table,
        candidate.target_column.name,
        config.value_sample_cap,
        target_cache,
        persisted_frames,
    )

    if total_fk == 0:
        return None

    missing_count = _count_left_anti(source_df, target_df)
    coverage = 1.0 - (missing_count / total_fk)

    final_confidence = _final_fk_confidence(
        source_column,
        candidate,
        coverage,
        config,
    )

    if final_confidence < config.fk_confidence_threshold:
        return None

    justification = (
        f"metadata_score={candidate.score:.2f}; coverage={coverage:.2f}; "
        f"name_similarity={candidate.name_similarity:.2f}; "
        f"source_uniqueness={source_column.uniqueness_ratio:.2f}; "
        f"target_pk_score={candidate.target_column.primary_key_score:.2f}"
    )

    return Relationship(
        source_table=source_table.full_name,
        source_column=source_column.name,
        target_table=candidate.target_table.full_name,
        target_column=candidate.target_column.name,
        confidence=round(final_confidence, 4),
        coverage=round(coverage, 4),
        method="metadata+value_overlap",
        justification=justification,
    )


def _get_source_distinct_values(
    spark: "SparkSession",
    table: TableProfile,
    column_name: str,
    limit: int,
    cache: Dict[Tuple[str, str, int], Tuple["DataFrame", int]],
    persisted_frames: List["DataFrame"],
) -> Tuple["DataFrame", int]:
    key = _distinct_cache_key(table, column_name, limit)
    if key not in cache:
        df = _build_distinct_dataframe(spark, table, column_name, limit).cache()
        persisted_frames.append(df)
        count = df.count()
        cache[key] = (df, count)
    return cache[key]


def _get_target_distinct_values(
    spark: "SparkSession",
    table: TableProfile,
    column_name: str,
    limit: int,
    cache: Dict[Tuple[str, str, int], "DataFrame"],
    persisted_frames: List["DataFrame"],
) -> "DataFrame":
    key = _distinct_cache_key(table, column_name, limit)
    if key not in cache:
        df = _build_distinct_dataframe(spark, table, column_name, limit).cache()
        persisted_frames.append(df)
        cache[key] = df
    return cache[key]


def _distinct_cache_key(
    table: TableProfile, column_name: str, limit: int
) -> Tuple[str, str, int]:
    relation = _relation_identifier(table)
    return (relation, column_name, int(limit or 0))


def _build_distinct_dataframe(
    spark: "SparkSession", table: TableProfile, column_name: str, limit: int
) -> "DataFrame":
    relation = _relation_identifier(table)
    query = (
        f"SELECT DISTINCT `{column_name}` AS value FROM {relation} "
        f"WHERE `{column_name}` IS NOT NULL"
    )
    df = spark.sql(query)
    if limit:
        df = df.limit(limit)
    return df


def _relation_identifier(table: TableProfile) -> str:
    if table.sample_view_name:
        return f"`{table.sample_view_name}`"
    parts = [table.catalog, table.schema, table.name]
    quoted = [f"`{part}`" for part in parts if part]
    return ".".join(quoted)


def _count_left_anti(source_df: "DataFrame", target_df: "DataFrame") -> int:
    try:
        from pyspark.sql import functions as F
    except ModuleNotFoundError:  # pragma: no cover - Spark required in production
        raise RuntimeError("PySpark is required to evaluate relationships.")

    return source_df.join(F.broadcast(target_df), on="value", how="left_anti").count()


def _final_fk_confidence(
    source_column: ColumnProfile,
    candidate: _CandidateTarget,
    coverage: float,
    config: ModelerConfig,
) -> float:
    metadata_component = config.fk_metadata_weight * candidate.score
    value_component = config.fk_value_weight * coverage
    completeness_component = (
        config.fk_null_completeness_weight * (1.0 - source_column.null_ratio)
    )

    uniqueness_alignment = _ratio_alignment(
        source_column.uniqueness_ratio, candidate.target_column.uniqueness_ratio
    )
    uniqueness_component = 0.1 * uniqueness_alignment

    confidence = metadata_component + value_component + completeness_component
    confidence += uniqueness_component
    return max(0.0, min(1.0, confidence))
