from collections import defaultdict
from typing import Dict, List

from .config import ModelerConfig
from .structures import AuditResult, DataModel


def run_audits(model: DataModel, config: ModelerConfig) -> List[AuditResult]:
    """Execute the audit suite multiple times and aggregate the results."""

    attempts = max(1, config.audits_to_run)
    audit_runs: Dict[str, List[AuditResult]] = defaultdict(list)

    for attempt in range(1, attempts + 1):
        for audit in _run_single_pass(model, config, attempt):
            audit_runs[audit.name].append(audit)

    aggregated: List[AuditResult] = []
    for name, results in audit_runs.items():
        passed = all(result.passed for result in results)
        warnings: List[str] = []
        for result in results:
            warnings.extend(result.warnings)

        unique_details = {result.details for result in results}
        consensus = len({(result.passed, result.details) for result in results}) == 1
        detail_summary = " | ".join(sorted(unique_details))

        aggregated.append(
            AuditResult(
                name=name,
                passed=passed,
                details=f"attempts={len(results)}; {detail_summary}",
                warnings=sorted(set(warnings)),
                attempts=len(results),
                consensus=consensus,
            )
        )

    return sorted(aggregated, key=lambda audit: audit.name)


def _run_single_pass(model: DataModel, config: ModelerConfig, attempt: int) -> List[AuditResult]:
    return [
        _audit_entity_coverage(model, attempt),
        _audit_relationship_quality(model, config, attempt),
        _audit_primary_key_completeness(model, attempt),
    ]


def _audit_entity_coverage(model: DataModel, attempt: int) -> AuditResult:
    passed = len(model.tables) > 0
    details = f"attempt={attempt}; tables={len(model.tables)}"
    warnings = []
    if not passed:
        warnings.append("No tables were profiled.")
    return AuditResult(
        name="entity_coverage",
        passed=passed,
        details=details,
        warnings=warnings,
    )


def _audit_relationship_quality(model: DataModel, config: ModelerConfig, attempt: int) -> AuditResult:
    high_confidence = [rel for rel in model.relationships if rel.confidence >= 0.8]
    passed = len(high_confidence) > 0 or len(model.relationships) == 0
    details = (
        f"attempt={attempt}; relationships={len(model.relationships)}, "
        f"high_confidence={len(high_confidence)}"
    )
    warnings = []
    if not passed:
        warnings.append("No high-confidence relationships were identified.")
    return AuditResult(
        name="relationship_quality",
        passed=passed,
        details=details,
        warnings=warnings,
    )


def _audit_primary_key_completeness(model: DataModel, attempt: int) -> AuditResult:
    with_pk = sum(1 for table in model.tables if any(col.is_primary_key for col in table.columns))
    total = len(model.tables)
    passed = with_pk == total or total == 0
    details = f"attempt={attempt}; tables_with_pk={with_pk}/{total}"
    warnings = []
    if not passed:
        warnings.append("Some tables are missing primary key candidates.")
    return AuditResult(
        name="primary_key_completeness",
        passed=passed,
        details=details,
        warnings=warnings,
    )
