"""Configuration objects for the Databricks data modeler."""
from __future__ import annotations

from dataclasses import dataclass
from typing import Optional


@dataclass(frozen=True)
class ModelerConfig:
    """Runtime configuration for the data modeler."""

    catalog: Optional[str] = None
    schema: Optional[str] = None
    database: Optional[str] = None
    include_tables_re: str = ".*"
    exclude_tables_re: str = ""
    use_unity_catalog: bool = True
    sample_row_fraction: float = 0.1
    sample_row_cap: int = 250_000
    value_sample_cap: int = 10_000
    approx_distinct: bool = True
    pk_confidence_threshold: float = 0.75
    fk_confidence_threshold: float = 0.6
    fk_metadata_min_score: float = 0.35
    fk_metadata_weight: float = 0.4
    fk_value_weight: float = 0.45
    fk_null_completeness_weight: float = 0.15
    max_fk_candidates_per_column: int = 8
    min_rows_for_sampling: int = 5
    run_id: Optional[str] = None
    output_dir: str = "./data_model_output"
    write_outputs: bool = True
    enable_describe_detail: bool = True
    audits_to_run: int = 3
    verbose: bool = True

    def table_filter_clause(self) -> str:
        """Return a WHERE clause fragment for table discovery."""

        predicates = []
        if self.schema:
            predicates.append(f"table_schema = '{self.schema}'")
        if self.catalog:
            predicates.append(f"table_catalog = '{self.catalog}'")
        if self.include_tables_re and self.include_tables_re != ".*":
            include_pattern = self.include_tables_re.replace("'", "\\'")
            predicates.append(f"table_name RLIKE '{include_pattern}'")
        if self.exclude_tables_re:
            exclude_pattern = self.exclude_tables_re.replace("'", "\\'")
            predicates.append(f"NOT (table_name RLIKE '{exclude_pattern}')")
        return " AND ".join(predicates)


@dataclass(frozen=True)
class RuntimeContext:
    """Holds runtime dependencies required by the modeler."""

    spark: "SparkSession"

    @property
    def is_databricks(self) -> bool:
        try:
            from pyspark.dbutils import DBUtils  # type: ignore

            _ = DBUtils(self.spark)
            return True
        except Exception:
            return False
