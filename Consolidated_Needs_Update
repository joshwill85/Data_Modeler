```python
from __future__ import annotations

import uuid
from dataclasses import replace
from typing import TYPE_CHECKING

if TYPE_CHECKING:  # pragma: no cover - typing only
    from pyspark.sql import SparkSession

from .audit import run_audits
from .config import ModelerConfig
from .discovery import discover_tables
from .output import (
    ensure_output_dir,
    write_audit_report,
    write_edges_csv,
    write_master_csv,
    write_node_csvs,
)
from .profiling import profile_tables
from .relationships import infer_relationships, score_primary_keys
from .structures import DataModel


def build_data_model(spark: "SparkSession", config: ModelerConfig) -> DataModel:
    normalized_config = _normalize_config(config)

    if normalized_config.verbose:
        print("Discovering tables...")
    discovered = discover_tables(spark, normalized_config)

    if normalized_config.verbose:
        print(f"Profiling {len(discovered)} tables...")
    tables = profile_tables(spark, normalized_config, discovered)

    if normalized_config.verbose:
        print("Scoring primary keys...")
    score_primary_keys(tables, normalized_config)

    if normalized_config.verbose:
        print("Inferring relationships...")
    relationships = infer_relationships(spark, tables, normalized_config)

    model = DataModel(tables=tables, relationships=relationships, audits=[])

    if normalized_config.verbose:
        print("Running audits...")
    model.audits = run_audits(model, normalized_config)

    if normalized_config.write_outputs:
        _write_outputs(model, normalized_config)

    return model


def _normalize_config(config: ModelerConfig) -> ModelerConfig:
    run_id = config.run_id or uuid.uuid4().hex[:12]
    return replace(config, run_id=run_id)


def _write_outputs(model: DataModel, config: ModelerConfig) -> None:
    output_dir = ensure_output_dir(config.output_dir)
    write_master_csv(model.tables, output_dir)
    write_node_csvs(model.tables, output_dir)
    write_edges_csv(model.relationships, output_dir)
    write_audit_report(model, output_dir)
```

