    rows: List[dict] = []
    for table in tables:
        for column in table.columns:
            rows.append(
                {
                    "catalog": table.catalog or "",
                    "schema": table.schema or "",
                    "table": table.name,
                    "column": column.name,
                    "data_type": column.data_type,
                    "nullable": column.nullable,
                    "primary_key": column.is_primary_key,
                    "primary_key_score": round(column.primary_key_score, 4),
                    "uniqueness_ratio": round(column.uniqueness_ratio, 4),
                    "null_ratio": round(column.null_ratio, 4),
                    "sample_values_preview": ", ".join(column.sample_values_preview[:5]),
                }
            )
    _write_csv(path / "data_dictionary.csv", rows)


def write_node_csvs(tables: Iterable[TableProfile], path: Path) -> None:
    for table in tables:
        file_path = path / f"nodes_{table.catalog or table.schema or 'default'}_{table.name}.csv"
        with file_path.open("w", newline="", encoding="utf-8") as handle:
            writer = csv.writer(handle)
            writer.writerow([table.full_name])
            for column in table.columns:
                writer.writerow([column.name])


def write_edges_csv(relationships: Iterable[Relationship], path: Path) -> None:
    rows = [
        {
            "source_table": rel.source_table,
            "source_column": rel.source_column,
            "target_table": rel.target_table,
            "target_column": rel.target_column,
            "confidence": rel.confidence,
            "coverage": rel.coverage,
            "method": rel.method,
            "justification": rel.justification,
        }
        for rel in relationships
    ]
    _write_csv(path / "relationships.csv", rows)


def write_audit_report(model: DataModel, path: Path) -> None:
    rows = [
        {
            "audit": audit.name,
            "passed": audit.passed,
            "details": audit.details,
            "warnings": " | ".join(audit.warnings),
            "attempts": audit.attempts,
            "consensus": audit.consensus,
        }
        for audit in model.audits
    ]
    _write_csv(path / "audit_report.csv", rows)


def _write_csv(file_path: Path, rows: List[dict]) -> None:
    if not rows:
        file_path.write_text("", encoding="utf-8")
        return
    with file_path.open("w", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)
